# Units whose build begins with yacc or lex, and the tape's own flags.
#
# Generated by tools/v10-world.py; check with --check.  Read by the
# guest as `while read name tool file obj flags', so the flags are the
# tail -- see the function comment.
#
# -d is not our preference: sixteen makefiles write `yacc -d' outright
# and four more write $YFLAGS over `YFLAGS = -d'.  It is also what makes
# y.tab.h exist, which nine units include.
#
awk yacc awk.g.y y.tab.o -d
awk lex awk.lx.l lex.yy.o 
ccom yacc common/sty.y y.tab.o -d
config lex config.l lex.yy.o 
config yacc config.y y.tab.o -d
cpp yacc cpy.y y.tab.o -d
dag yacc parsedag.y y.tab.o -d
dict lex oedread.l lex.yy.o 
diction lex rewrite.l lex.yy.o 
docgen lex otrans.l lex.yy.o 
efl lex lex.l lex.yy.o 
egrep yacc gram.y y.tab.o -d
eqn yacc eqn.y y.tab.o -d
expr yacc expr.y y.tab.o -d
flex yacc parse.y y.tab.o -d
flex lex scan.l lex.yy.o 
gcc yacc cexp.y y.tab.o -d
grap yacc grap.y y.tab.o -d
grap lex grapl.l lex.yy.o 
hoc yacc hoc.y y.tab.o -d
ideal lex idlex.l lex.yy.o 
ideal yacc idyac.y y.tab.o -d
ipa lex ipa_trans.lex lex.yy.o 
kasb lex kas0.l lex.yy.o 
kasb yacc kas0.y y.tab.o -d
lex yacc parser.y y.tab.o -d
m4 yacc m4y.y y.tab.o -d
make yacc gram.y y.tab.o -d
neqn yacc e.y y.tab.o -d
netnews yacc src/getdate.y y.tab.o -d
numdate yacc getdate.y y.tab.o -d
pic lex picl.l lex.yy.o 
pic yacc picy.y y.tab.o -d
picasso lex picassol.l lex.yy.o 
picasso yacc picassoy.y y.tab.o -d
pico yacc x.y y.tab.o -d
pp lex scan.l lex.yy.o 
pret yacc pret.y y.tab.o -d
pret lex pretlex.l lex.yy.o 
punct lex npunct.l lex.yy.o 
ratfor yacc r.g y.tab.o -d
struct yacc beauty.y y.tab.o -d
struct lex lextab.l lex.yy.o 
style lex end.l lex.yy.o 
twig yacc twig.y y.tab.o -d
units yacc units.y y.tab.o -d
usgmake yacc gram.y y.tab.o -d
visi lex lex.l lex.yy.o 
visi yacc parse.y y.tab.o -d
wwb lex gram.l lex.yy.o 
xref lex xrefa.l lex.yy.o 
#
# SKIPPED 2500       yacc gram.y -- passes the output through ed -- needs its own recipe
# SKIPPED 2500       lex lex.l -- redirects its output -- needs its own recipe
# SKIPPED ccom       yacc common/cgram.y -- passes the output through sed -- needs its own recipe
# SKIPPED docgen     lex trans.l -- a second lex source; otrans.l already writes lex.yy.o
# SKIPPED gcc        yacc parse.y -- a second yacc source; cexp.y already writes y.tab.o
# SKIPPED style      lex nwords.l -- a second lex source; end.l already writes lex.yy.o
# SKIPPED style      lex part.l -- a second lex source; end.l already writes lex.yy.o
# SKIPPED wwb        lex org.l -- a second lex source; gram.l already writes lex.yy.o
# SKIPPED wwb        lex punct.l -- a second lex source; gram.l already writes lex.yy.o
