HOME=/; export HOME
date
case ${1-xx} in
autoboot)
	echo Autoboot:
	/etc/fsck -p
	case $? in
	0)
		date
		;;
	4)
		/etc/reboot -n
		;;
	8)
		echo "Automatic reboot failed... help!"
		exit 1
		;;
	12)
		echo "Reboot interrupted"
		exit 1
		;;
	*)
		echo "Unknown error in reboot"
		exit 1
		;;
	esac
esac
/etc/ldpcs /etc/pcs750.bin	# load new microcode in 750s
>/etc/mtab
/etc/mount -a
/etc/savecore /tmp/dump
/etc/swapon -a
trap "" 1 2 3
/etc/update
/etc/cron &
cd /tmp
/usr/lib/ex3.7preserve -a
rm -f *
# cd /usr/tmp
# rm -f *
date >> /usr/adm/lastboot
# /etc/accton /tmp/acct > /tmp/acct
# /etc/kdiload			# load KMC microcode for Datakit
# /etc/dkhup			# announce Datakit reboot to controller
# sleep 10
# /etc/mgrproc
# /usr/net/share.go; /usr/net/setup.go	# mount remote file systems and announce us
# /usr/net/face.go	# face server
/etc/procmount

# --- the network (ipnx) ----------------------------------------------
#
# The kernel carries the Interlan NI1010 driver (`device il0' in
# usr/sys/ipnx/conf) and the app attaches a SLiRP-NAT card to it, so this
# machine is on the Internet from boot rather than after an experiment.
#
# ipconfig and tcpconfig are PROCESSES, not settings: they die with the
# machine and have to run on every boot.  And tcpconfig is not optional
# housekeeping -- without it pushing the TCP line discipline onto /dev/ip6,
# open("/dev/tcpNN") succeeds, the tcpuser write succeeds, and the connect
# then blocks FOREVER with no diagnostic, because there is nothing
# underneath the device.
#
# V8's inet is CLASSFUL.  The interface's network is 10.0.0.0, not SLiRP's
# 10.0.2.0; that one number cost the N track a debugging session.  The
# guest is 10.0.2.15 and reaches the host at 10.0.2.2, which SLiRP rewrites
# to the host's loopback -- so nothing needs forwarding and the same setup
# works inside the iOS sandbox.
#
# Guarded on the device node so a kernel or a machine without the card
# boots exactly as before instead of hanging on a missing interface.
if test -c /dev/il0
then
	if test ! -s /usr/inet/lib/hosts
	then
		echo '10.0.2.15	ipnx-v8 v8' > /usr/inet/lib/hosts
		echo '10.0.2.2	gateway' >> /usr/inet/lib/hosts
	fi
	if test ! -s /usr/inet/lib/networks
	then
		echo '10.0.0.0	slirp-net' > /usr/inet/lib/networks
	fi
	/usr/inet/etc/ipconfig /dev/il0 ipnx-v8 slirp-net /dev/il1 &
	sleep 3
	/usr/inet/etc/tcpconfig /dev/ip6 &
	sleep 3
	/usr/inet/etc/route add '*' gateway
	echo 'network: il0 10.0.2.15, gateway 10.0.2.2'

	# The host's folders, over netfs.  The app serves them in-process on
	# fixed ports (FileShare.Role) and the guest reaches the host at
	# 10.0.2.2, which SLiRP rewrites to the host's own loopback -- so
	# nothing is forwarded and this works unchanged in the iOS sandbox.
	#
	# Backgrounded and silenced because a share the user has not chosen
	# is simply not listening, and a boot must not wait on one.  The
	# third argument is nmount's unique mount id, not a device minor.
	/etc/nmount 10.0.2.2 9200 64 /n/macos >/dev/null 2>&1 &
	/etc/nmount 10.0.2.2 9201 65 /n/home  >/dev/null 2>&1 &
fi

exit 0
