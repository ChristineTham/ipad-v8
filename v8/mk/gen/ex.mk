exrecover.o: $(SRC)/usr/src/cmd/ex/exrecover.c $(INCDIR)/ctype.h $(INCDIR)/errno.h $(INCDIR)/local/uparm.h $(INCDIR)/setjmp.h $(INCDIR)/sgtty.h $(INCDIR)/signal.h $(INCDIR)/stdio.h $(INCDIR)/sys/dir.h $(INCDIR)/sys/ioctl.h $(INCDIR)/sys/param.h $(INCDIR)/sys/stat.h $(INCDIR)/sys/termio.h $(INCDIR)/sys/types.h $(INCDIR)/termio.h $(SRC)/usr/src/cmd/ex/ex.h $(SRC)/usr/src/cmd/ex/ex_temp.h $(SRC)/usr/src/cmd/ex/ex_tty.h $(SRC)/usr/src/cmd/ex/ex_tune.h $(SRC)/usr/src/cmd/ex/ex_vars.h $(TOOLS)
	$(COMPILE) $(SRC)/usr/src/cmd/ex/exrecover.c

printf.o: $(SRC)/usr/src/cmd/ex/printf.c $(INCDIR)/varargs.h $(TOOLS)
	$(COMPILE) $(SRC)/usr/src/cmd/ex/printf.c

install: ex
	-mkdir $(DESTDIR)/usr/bin
	cp ex $(DESTDIR)/usr/bin/ex

clean:
	-rm -f $(OBJS) ex 
