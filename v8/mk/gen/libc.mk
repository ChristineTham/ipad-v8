	-mkdir $(TOOLDIR)/lib
	cp libc.a $(TOOLDIR)/lib/libc.a
	$(RANLIB) $(TOOLDIR)/lib/libc.a
	cp crt0.o $(TOOLDIR)/lib/crt0.o
	cp mcrt0.o $(TOOLDIR)/lib/mcrt0.o

clean:
	-rm -f $(OBJS) libc.a crt0.o mcrt0.o
