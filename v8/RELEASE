# ipnx base system release -- the single source of truth for the version.
#
# tools/ipnx-release.py generates usr/include/ipnx.h and the version lines of
# usr/sys/conf/newvers.sh from this file, and `--check` fails if either has
# drifted.  FreeBSD maintains its equivalents (newvers.sh and sys/param.h) by
# hand and they do occasionally disagree; generating is cheaper than remembering.
#
# Policy -- what each number means, and what counts as a release at all:
# docs/releases.md
#
# EDITION is Bell Labs' and is not ours to increment.  The release number
# beside it is OURS: it counts what this project has made of that edition, and
# the two are deliberately separate -- "Eighth Edition Release 1.0" says
# whose system it is and whose build it is, in that order.
#
# IT STARTS AT 1.0, as of 2026-08-16.  It was 0.3.0-CURRENT, and both halves
# of that were wrong once the disk began being built from source.  A leading
# 0 says "not stable yet" about a system finished in 1985 that has not moved
# since, and -CURRENT is a branch marker borrowed from projects with a moving
# trunk; on a legacy base it means nothing at all.  1.0 is the first image
# built end to end from v8/ rather than patched out of the tape, which is the
# thing worth numbering.
#
# MINOR adds functionality or breaks compatibility; PATCH is fixes only, and
# is OMITTED FROM THE BANNER WHEN ZERO -- so this reads "Release 1.0", and a
# fix release would read "Release 1.0.1".  BRANCH is CURRENT between releases
# and RELEASE at a tag, and the suffix likewise shows only when it is not
# RELEASE, so a tagged system never says "Release 1.0-RELEASE".

EDITION=8
MAJOR=1
MINOR=0
PATCH=0
BRANCH=RELEASE
DATE=2026-08-16
