---
import Layout from './Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Big page heading. Omit on pages that render their own hero (the landing page). */
  heading?: string;
  /** Supporting line under the heading. */
  intro?: string;
  /** Small label above the heading, in the running-head voice. */
  eyebrow?: string;
  ogImage?: string;
  appSchema?: boolean;
}

const { title, description, heading, intro, eyebrow, ogImage, appSchema } = Astro.props;
---

<Layout title={title} description={description} ogImage={ogImage} appSchema={appSchema}>
  <Nav />

  {
    heading && (
      <header class="mx-auto max-w-[1080px] px-6 pt-12 pb-8">
        {eyebrow && (
          <p class="font-mono text-[11px] tracking-[0.14em] text-muted uppercase">{eyebrow}</p>
        )}
        <h1 class="mt-2 font-serif text-[clamp(30px,5vw,44px)] font-bold tracking-[-0.02em]">
          {heading}
        </h1>
        {intro && <p class="mt-3 max-w-[68ch] text-[19px] text-muted">{intro}</p>}
        <div class="mt-6 border-b border-rule" />
      </header>
    )
  }

  <main class="mx-auto max-w-[1080px] px-6">
    <slot />
  </main>

  <Footer />
</Layout>
