<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store distribution requires the sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The emulators talk to each other over loopback sockets: SIMH binds the
	     console, remote-console and DZ listeners (server) and the 5620 dials
	     the DZ line (client). Nothing leaves the machine. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Disk image import/export the user explicitly picks. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- The shared folders (/n/macos, /n/home) must survive a relaunch, and
	     user-selected.read-write above does NOT do that: it grants access to
	     what the picker returned, for this launch only. Persisting it means a
	     security-scoped bookmark, and CREATING one requires this entitlement.

	     Without it FileShare.adopt() throws on the very first pick --
	     "Could not remember that folder: The file <name> cannot be opened" --
	     and because that throw happens before start(), the share never begins
	     serving either. So the symptom is not "forgets on relaunch", which is
	     what the name suggests: it is a share that never works once, and a
	     bookmark that is never stored at all. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
