#!/usr/bin/env expect
#
# Where does terminal jim get `display` from, if not from its own .data?
#
# find-bitmaps.exp established that /usr/jerq/lib/muxterm carries a fully
# initialised 800x1024 screen Bitmap and /usr/jerq/mbin/jim.m carries no
# (800,1024) rectangle at all -- yet jerq/src/jim/term/main.c plainly uses
# `display` and `Drect`. Their COFF headers differ too: 6 sections against 3.
#
# The hypothesis worth testing is that jim resolves `display` to the copy in
# the 5620's own firmware rather than linking libj's. If so it needs no patch:
# the app already retargets the ROM Bitmap with dmd_resize_screen(), so jim
# would follow a resized screen for free, and muxterm is the outlier precisely
# because it replaces the ROM terminal wholesale.
#
# 3nm answers this directly, which beats guessing from byte patterns.
#
# Read-only. Run: tools/run-v8exp.sh jerq-syms 480

set timeout 300
log_file -a jerq-syms.log
proc sendline {x} { send "$x\r" }

proc must {pat {t 0}} {
    global timeout
    set use [expr {$t > 0 ? $t : $timeout}]
    expect -timeout $use "$pat" {
    } timeout {
        send_user "\n*** FAILED: never saw '$pat' after ${use}s ***\n"; exit 3
    } eof {
        send_user "\n*** FAILED: simulator exited waiting for '$pat' ***\n"; exit 4
    }
}
proc sh   {cmd {t 0}} { must "# "   $t; sendline $cmd }
proc simh {cmd {t 0}} { must "sim>" $t; sendline $cmd }

spawn vax780
simh "set noasynch"
simh "set tto 7b"
simh "set rp0 rp06"
simh "at rp0 rp06v8.wide"
simh "load -o bootV8 0"
simh "run 2"

must "login:" 240
sendline "root"
sh "echo SYMS-START" 120

sh "echo ---SIZE---"
sh "/usr/jerq/bin/3size /usr/jerq/lib/muxterm" 120
sh "/usr/jerq/bin/3size /usr/jerq/mbin/jim.m" 120

sh "echo ---MUXTERM-DISPLAY---"
sh "/usr/jerq/bin/3nm /usr/jerq/lib/muxterm 2>&1 | grep -i display" 180
sh "echo ---JIM-DISPLAY---"
sh "/usr/jerq/bin/3nm /usr/jerq/mbin/jim.m 2>&1 | grep -i display" 180

# How many symbols does each retain at all? A stripped jim.m would explain the
# silence above without any of the interesting conclusions.
sh "echo ---SYMCOUNT---"
sh "/usr/jerq/bin/3nm /usr/jerq/lib/muxterm 2>&1 | wc -l" 180
sh "/usr/jerq/bin/3nm /usr/jerq/mbin/jim.m 2>&1 | wc -l" 180

# The ROM's own Bitmap, for comparison: 5620 firmware keeps `display` in ROM
# .data, and libj's copy is what a self-contained program substitutes for it.
sh "echo ---JIM-EXTERNS---"
sh "/usr/jerq/bin/3nm -u /usr/jerq/mbin/jim.m 2>&1 | sed 40q" 180

sh "echo SYMS-DONE"
sh "cd /; sync; sync; sync"
sh "/etc/halt" 60
expect eof
