#!/usr/bin/env expect
# Stage 2: build the Tenth Edition C library from V10 source, ON V10.
#
#	expect tools/v10-stage2.exp <stage1-image> <src-image>
#
# Normally run through tools/v10-stage2.sh.
#
# WHAT STAGE 2 IS FOR.  Every binary stage 1 produced was linked against the
# TAPE's libc.a -- Bell Labs' 1995 archive -- because it is the only one that
# exists when stage 1 runs.  Stage 2 builds the library from source with the
# stage-1 compiler, so that stage 3 can rebuild the toolchain against it and
# be the first set of binaries in which every component came from V10 source
# compiled on V10.  The order is V8's, from docs/build-from-source.md, and
# libc-before-the-second-toolchain is not arbitrary: rebuilding the compiler
# first produces binaries that still carry the old library and have to be
# built a third time once libc exists.
#
# WHAT IS BEING MEASURED, AND WHAT IS MERELY ASSERTED.  The tape ships the
# archive its own mkfile produced -- 261 members, and mkdep.py has already
# checked that the mkfile's object list and the archive's member list are the
# same set.  So this run can compare its output against Bell Labs' own, member
# by member, which is a far stronger check than "it compiled".
#
# But byte-identity is NOT the pass criterion, and saying so up front keeps
# the result honest.  The mkfile hands TEN members to `lcc', the ANSI compiler
# in cmd/lcc -- malloc, memmove, qsort, fgets, fputs, rdwr, scanf, sprintf,
# vfprintf, vfscanf -- and we build all 261 with pcc2 because there is no lcc
# to run: the prebuilt driver (cmd/lcc/etc/lcc, compiled from bowell.c) names
# /usr/lib/gcc-cpp and /usr/lib/rcc, and while the tree has rcc it has no
# gcc-cpp anywhere, only cmd/gcc/gcc.c.  Those ten may fail outright, or
# compile to different bytes.  Either is a RESULT.  What is asserted is that
# the archive is complete, that its member list and order match the tape's,
# and that a program links against it and runs.
#
# THE ASSEMBLER IS THE TAPE'S, DELIBERATELY.  $(AS) is /bin/ar's neighbour
# /bin/as -- Bell Labs' 1995 binary -- and not stage 1's own, even though
# stage 1 built one.  V10's cc has no `-t a' letter, so cc runs a compiled-in
# /bin/as for all 261 objects whatever $(AS) says; pointing $(AS) at stage 1's
# would give exactly ONE member (errlst.o, the only rule that names $(AS)) a
# different assembler from the other 260.  A library assembled by two
# assemblers is a worse artefact than one assembled by the tape's, and the
# real fix is the `-t a/l/c' question that belongs to stage 3.
#
# $(LD) IS STAGE 1's, and that one matters: the golden's /lib/ld was compiled
# by the EIGHTH Edition's cc, and the strip pass (`ld -x -r' over every
# object) is the one place libc's build runs a linker.

log_user 1
source [file dirname [info script]]/v10drive.exp
# AFTER the source, not before: v10drive.exp sets `timeout' itself, so a
# harness that raises it first has its value quietly overwritten.
set timeout 14400
# 261 objects, each compiled and then re-emitted by ld, so this run is much
# longer than stage 1's.  The watchdog still bounds it -- it just has to be
# told the shape of the work rather than cutting it off mid-build.
set V10_RUN_SECS 21600

if {[llength $argv] < 2} {
    puts "usage: v10-stage2.exp <stage1-image> <src-image>"
    exit 2
}
set img [lindex $argv 0]
set src [lindex $argv 1]

set N   /n/v10            ;# the source disk, mounted
set S   /n/v10/src
set K   /n/v10/mk
set T1  /usr/s1           ;# stage 1: the compiler this stage is built by
set T   /usr/s2           ;# where stage 2 installs
set OBJ /usr/obj
# THE HEADER DIRECTORY THIS RUN ACTUALLY USES.  libc.mk defaults INCDIR to
# /usr/v10/include; the macro line below overrides it to /usr/include, because
# that is where the r70 cpio put the headers on a golden.  Both spellings were
# live in this file at once and the cp that used the wrong one failed silently
# -- so the value is named ONCE, here, and $A quotes it rather than repeating
# the literal.
set INC /usr/include

# The one macro that cannot go in $A/$B/$C, because its VALUE has spaces in
# it and those variables are expanded by the shell with word splitting.
# Quoted here and typed on each make line instead.
set CCM "'CC=cc -B$T1/lib/ -t02p'"

set results {}
proc note {name ok} { global results; lappend results [list $name $ok] }
proc report {} {
    global results
    puts "\n===== V10 STAGE 2 RESULTS ====="
    set failed 0
    foreach r $results {
        puts [format "  %-44s %s" [lindex $r 0] [expr {[lindex $r 1] ? "ok" : "NO"}]]
        if {![lindex $r 1]} { incr failed }
    }
    puts "===== [expr {[llength $results] - $failed}]/[llength $results] =====\n"
    return $failed
}

# ---------------------------------------------------------------------------
v10_boot $img [list "set rq1 ra81" "attach rq1 $src"]
v10_login root

puts "\n===== V10 STAGE 2 (libc, on V10) ====="
v10_sh "PATH=/bin:/etc:/usr/bin; export PATH" 120
v10_sh "OK=-ok" 120

# ------------------------------------------------------------- the source ---
#
# /n and /n/v10 already exist on a stage-1 machine; mkdir says so and that is
# not an error.  v10_sh rather than v10_try for exactly that reason.
v10_sh "mkdir /n; mkdir $N" 120
note "source disk mounts" \
    [v10_try "/etc/mount /dev/ra1c $N && echo MT\$OK" "MT-ok" 600]
note "libc source visible" \
    [v10_try "test -s $S/libc/csu/crt0.s && echo LC\$OK" "LC-ok" 300]
note "libc.mk visible" \
    [v10_try "test -s $K/libc.mk && echo MK\$OK" "MK-ok" 300]
note "libc.ord visible" \
    [v10_try "test -s $K/libc.ord && echo OR\$OK" "OR-ok" 300]
# The oracle.  Everything below compares against it, so its absence has to be
# a named failure rather than a comparison that silently passes on nothing.
note "the tape's libc.a visible" \
    [v10_try "test -s $S/libc/libc.a && echo TA\$OK" "TA-ok" 300]
# A filename beginning with a colon is the kind of thing a copy skips.
note ":errfix visible" \
    [v10_try "test -s $S/libc/gen/:errfix && echo EF\$OK" "EF-ok" 300]

# --------------------------------------------- /usr/jerq/include, for jterm ---
#
# libc's `gen/jterm.c' includes "/usr/jerq/include/jioctl.h" -- an ABSOLUTE
# path, so no -I can help and the file has to BE there.  It comes from the
# v10blit tarball rather than v10src, which is why jterm.o failed for two runs
# and got written down as an lcc member; it is pure K&R and lcc could not find
# a missing header either.
#
# INSTALLED, not copied into an object directory, because an absolute include
# names a system location and this is a system location.  Stage 8 will place it
# from the same source when it lays out the disk; doing it here keeps stage 2
# self-contained and costs 22 small files.
#
# `mkdir' makes ONE level on V10 (CLAUDE.md; it cost a whole run once), so both
# levels are named.  v10_sh, not v10_try: on a re-run they exist already and
# mkdir saying so is not a failure.
v10_sh "mkdir /usr/jerq; mkdir /usr/jerq/include" 120
v10_sh "cp $N/jerq/*.h /usr/jerq/include" 600
note "jioctl.h installed where jterm.c names it" \
    [v10_try "test -s /usr/jerq/include/jioctl.h && echo JQ\$OK" "JQ-ok" 300]

# ------------------------------------ shares.h and sys/lnode.h, reconstructed ---
#
# Six libc members include <shares.h>, which includes <sys/lnode.h>, and
# NEITHER FILE IS ON THE TAPE -- though their objects are in the tape's libc.a,
# so both existed.  Both are reconstructed in our overlay from `lnode(5)', which
# prints the header verbatim, with every offset and size confirmed against Bell
# Labs' own 1989 objects (v10/src/PATCHES.md carries the disassembly).
#
# INSTALLED INTO $INCDIR, which is where shares(5) says they belong --
# "/usr/include/shares.h" and "/usr/include/sys/lnode.h" under FILES.  So this
# needs no makefile change at all: $(INCS) already names that directory, and
# the six sources are pristine and unaltered.
#
# $INC, NOT A LITERAL, and that is the bug this line already had once.  It was
# written as /usr/v10/include -- libc.mk's own default for INCDIR -- while THIS
# HARNESS OVERRIDES INCDIR TO /usr/include on the macro line below.  So the cp
# answered
#
#	cp: /usr/v10/include/shares.h: No such file or directory
#
# the headers never arrived, and all six share members failed exactly as they
# had before, with two `NO' lines the only sign that anything had been
# attempted.  One value, named once, used everywhere it is needed.
v10_sh "cp $N/ours/include/shares.h $INC/shares.h" 300
v10_sh "cp $N/ours/include/sys/lnode.h $INC/sys/lnode.h" 300
note "shares.h installed" \
    [v10_try "test -s $INC/shares.h && echo SH\$OK" "SH-ok" 300]
note "sys/lnode.h installed" \
    [v10_try "test -s $INC/sys/lnode.h && echo LN\$OK" "LN-ok" 300]
# PROVEN BY USE, not by existence -- a header that is present and wrong compiles
# nothing.  putshares.c is the member whose object gave us MAXUID and
# sizeof(Share), so if the reconstruction is right this is the one that must
# build.  Compiled here, in isolation, BEFORE the 261 -- so a bad header is one
# named line instead of six MISSes among many.
# ------------------------- stdlib.h, float.h, stdarg.h: WHICH VARIANT BELONGS ---
#
# r70's /usr/include HAS NO stdlib.h, float.h OR stdarg.h at top level, and six
# libc members ask for them:
#
#	malloc.c: 8:     Can't find include file stdlib.h
#	fconv.h: 29/33:  stdlib.h / float.h      (_dtoa, _fconv, strtod)
#	vfprintf.c: 6/8: stdarg.h / stdlib.h
#	vfscanf.c: 6/8:  the same two
#
# The tape has all three -- FOUR TIMES OVER, under include/lcc, include/CC,
# include/olcc and include/oCC, and never at top level.  So this is not a
# conversion, it is a SYSTEM-LAYOUT question of the same kind as installing the
# reconstructed shares.h, and the tape answers it: pick the variant pcc2 can
# parse.  Measured host-side, not guessed:
#
#	lcc/float.h    37 lines, ZERO prototypes -- pure #defines
#	lcc/stdarg.h   K&R-compatible; already what our converted members use
#	CC/stdlib.h    SIX LINES: a guard and `#include <libc.h>'
#	include/libc.h 36 lines, ZERO prototypes -- `extern char *sbrk();'
#	               and 30 more in exactly that 1970s form
#
# against lcc/stdlib.h (22 prototypes) and olcc/stdlib.h (16), which pcc2
# cannot read.  cfront's shim onto the K&R libc.h is the one that fits, and it
# is the tape's own file rather than ours.
#
# NOT ON THE INCLUDE PATH, INSTALLED.  `-I$(INCDIR)/CC' would work for stdlib.h
# and would also put cfront's stdio.h, string.h and math.h ahead of the
# system's for all 261 members -- which is the trap the printf family's
# <lcc/stdarg.h> line exists to avoid.  Three files copied to where the sources
# already look shadows nothing.
foreach h {stdlib float stdarg} { v10_sh "test -f $INC/$h.h && echo have-$h" 120 }
v10_sh "cp $INC/CC/stdlib.h $INC/stdlib.h" 300
v10_sh "cp $INC/lcc/float.h $INC/float.h" 300
# CC's stdarg.h, NOT lcc's, AND THE REASON IS ONE CHARACTER.  lcc's macro is
#   #define va_arg(list, mode) _littleendian_va_arg(list, mode, 3U)
# and pcc2 lexes `3U' as the number 3 followed by the IDENTIFIER U -- the
# unsigned suffix is ANSI.  It shows up nowhere near the header:
#   "vfprintf.c":169:syntax error / expected operator or ) after expression
#   "vfprintf.c":169:saw NAME
#   pragma ref precision:3:saw NAME        <- ccom naming the macro expansion
# CC's form has no suffix and no compound-expression address-of,
#   #define va_arg(ap, mode) ((mode *)(ap += sizeof(mode)))[-1]
# and is BYTE-FOR-BYTE V8's own /usr/include/varargs.h macro -- so it is proven
# against pcc2 by V8's whole libc rather than hoped at.  The eight converted
# printf-family members are unaffected: they name <lcc/stdarg.h> explicitly.
v10_sh "cp $INC/CC/stdarg.h $INC/stdarg.h" 300
foreach h {stdlib float stdarg} {
    note "$h.h installed at $INC" \
        [v10_try "test -s $INC/$h.h && echo H\$OK" "H-ok" 300]
}

v10_sh "rm -rf /tmp/sh; mkdir /tmp/sh" 120
note "the reconstructed headers compile putshares.c" \
    [v10_try "cd /tmp/sh; if cc -B$T1/lib/ -t02p -I$INC -c $S/libc/gen/putshares.c; then echo PS\$OK; fi" \
             "PS-ok" 900]

# ---------------------------------------------- is this a stage-1 machine? ---
#
# Asserted BEFORE the first object, so a run started from the golden by
# mistake says so in one line instead of building 261 objects with the wrong
# compiler and looking like a success.
foreach p {lib/cpp lib/ccom lib/c2 bin/ld bin/cc} {
    note "stage 1 present: $p" [v10_try "test -s $T1/$p && echo S1\$OK" "S1-ok" 120]
}
# And the four commands stage 1 installed into the running system, each
# proven by USE.  ar and ed are what this stage cannot proceed without.
note "ar works" \
    [v10_try "cd /tmp; rm -f b.a; if ar cr b.a /etc/motd && ar t b.a; then echo AR\$OK; fi" "AR-ok" 300]
note "cmp works" [v10_try "cd /tmp; if cmp /etc/motd /etc/motd; then echo CM\$OK; fi" "CM-ok" 300]
v10_sh "cd /tmp; echo hello > e2.txt; echo '1s/hello/EDIT/' > e2.ed; echo w >> e2.ed; echo q >> e2.ed" 120
note "ed edits from a script" \
    [v10_try "cd /tmp; ed - e2.txt < e2.ed; cat e2.txt" "EDIT" 300]
# ranlib is the tape's prebuilt (prebuilt.txt: usr/bin/ranlib, 12288 bytes).
# Without it ld makes ONE pass over the archive and warns, and a libc whose
# backward references do not resolve fails much later in something unrelated.
note "ranlib works" \
    [v10_try "cd /tmp; if ranlib b.a && ar t b.a; then echo RL\$OK; fi" "RL-ok" 300]

# ------------------------------------------------------------------- lcc ---
#
# THE DECISIVE EXPERIMENT, BEFORE THE MACHINERY.  B1 was won by putting the
# question first: does V10's own toolchain run at all?  Same shape here --
# 24 members need an ANSI compiler, the tape's answer is lcc, and lcc is on
# the tape as three prebuilt 1995 binaries.  Prove one file compiles before
# teaching the makefile to depend on it.
#
# The paths are the driver's own, compiled in (cmd/lcc/etc/lcc from bowell.c):
# /usr/lib/gcc-cpp, /usr/lib/rcc, /bin/as, /bin/ld, /lib/crt0.o.  ph/cpp
# stands in for gcc-cpp because the tree has no gcc-cpp at all.
v10_sh "cp $N/lcc/lcc /usr/bin/lcc" 300
v10_sh "cp $N/lcc/rcc /usr/lib/rcc" 300
foreach p {usr/bin/lcc usr/lib/rcc} {
    note "lcc installed: /$p" [v10_try "test -s /$p && echo LI\$OK" "LI-ok" 120]
}
# The ANSI headers r70 installed, which LCCARGS names.
note "/usr/include/lcc/stdarg.h present" \
    [v10_try "test -s /usr/include/lcc/stdarg.h && echo LH\$OK" "LH-ok" 120]

# WHICH cpp CAN STAND IN FOR gcc-cpp?  The driver's cpp line is compiled in --
# `{"/usr/lib/gcc-cpp", "-undef", "-Dvax", "-DV9", "$1", "$2", "$3", 0}' from
# bowell.c -- and there is no gcc-cpp in the tree, so something must take that
# name.  KEEPING V10 AUTHENTIC means leaving the driver alone and choosing the
# stand-in, rather than rebuilding the driver from a config of ours to dodge a
# flag: bowell IS the real CSRC machine's configuration.
#
# Two candidates, and the difference is `-undef':
#
#   /lib/cpp        V10's own, off this tape.  cpp.c's flag switch ends
#                   `default: pperror("unknown flag %s"); continue;' -- it
#                   WARNS and carries on -- and it takes -D and -I in exactly
#                   the form the driver passes.
#   ph/cpp          lcc's own.  Rejects the flag outright:
#                   `illegal option -- u', then writes nothing.
#
# THE TEST IS AGAINST THE TAPE'S BYTES, NOT AGAINST AN EXIT STATUS.  ph/cpp's
# failure is silent in every other way: cpp writes an empty file, rcc compiles
# it, as assembles a valid EMPTY object, and lcc exits 0.  A probe asserting
# "lcc compiled it" and "an object appeared" passes on nothing -- both of mine
# did, and stage 2 reported 261 members built while 26 were empty.
#
# fputs.o is the right subject twice over: it is one of the members pcc2
# cannot parse at all, AND it is in the set whose bytes differ from the tape's.
# So a match here answers the compile question and Christine's which-compiler
# question in one go.
v10_sh "L='-N -I$S/libc/stdio -I/usr/include/lcc -I/usr/include/libc -I/usr/include -DV10'" 120
proc lcctry {which cppsrc} {
    global S OBJ N
    v10_sh "cp $cppsrc /usr/lib/gcc-cpp" 300
    v10_sh "rm -rf /tmp/lt; mkdir /tmp/lt" 120
    v10_sh "cd /tmp/lt; lcc \$L -c $S/libc/stdio/fputs.c > l.log 2>&1" 900
    # A real object, measured against the tape's own member -- and the strip
    # pass first, because every member of that archive went through `ld -x -r'.
    v10_sh "cd /tmp/lt; /usr/s1/bin/ld -x -r fputs.o > /dev/null 2>&1 && mv a.out fputs.o" 300
    set m [v10_try "cd /tmp/lt; if cmp fputs.o $OBJ/tape/fputs.o; then echo CPPM\$OK; fi" "CPPM-ok" 300]
    note "cpp = $which: lcc output MATCHES the tape's fputs.o" $m
    if {!$m} { v10_run "cd /tmp/lt; cat l.log; echo LOGEND" "LOGEND" 300 }
    return $m
}
# The tape's members have to be extracted before either candidate can be
# judged, so that step moves ahead of the build.
v10_sh "rm -rf $OBJ/tape; mkdir $OBJ; mkdir $OBJ/tape" 300
note "the tape's archive extracts" \
    [v10_try "cd $OBJ/tape; if ar x $S/libc/libc.a && test -s _exit.o; then echo EX\$OK; fi" "EX-ok" 1800]
set cppA [lcctry "V10's own /lib/cpp" "/lib/cpp"]
set cppB [lcctry "lcc's own ph/cpp" "$N/lcc/cpp"]
# Leave the winner installed for the build below.  If neither matched, prefer
# V10's own -- it at least preprocesses, where ph/cpp writes nothing.
if {$cppB && !$cppA} {
    v10_sh "cp $N/lcc/cpp /usr/lib/gcc-cpp" 300
} else {
    v10_sh "cp /lib/cpp /usr/lib/gcc-cpp" 300
}
note "some cpp reproduces a tape member with lcc" [expr {$cppA || $cppB}]

# ---------------------------------------------------------------- the macros ---
#
# Shell variables, because CANBSIZ is 256 and the tty discards a longer line
# silently.  See the header for why AS is the tape's and LD is stage 1's.
v10_sh "A='SRC=$S OURS=$N/ours INCDIR=$INC TOOLDIR=$T DESTDIR=$T'" 120
v10_sh "B='CCPATH=$T1/bin/cc CPP=$T1/lib/cpp CCOM=$T1/lib/ccom C2=$T1/lib/c2'" 120
v10_sh "C='AS=/bin/as LD=$T1/bin/ld AR=/bin/ar RANLIB=/usr/bin/ranlib'" 120
# NOT $OBJ/tape: the tape's members were extracted above for the cpp
# trial and the comparison below still needs them.
v10_sh "rm -rf $T $OBJ/libc; mkdir $T; mkdir $OBJ; mkdir $OBJ/libc" 300
# TWICE, AND BY GLOB THE SECOND TIME.  `rm -rf' above reported nothing and the
# directory was not empty -- whether because the recursive remove did not do
# what it says or because something recreated the contents, the run that
# followed measured objects it had not built.  A second pass by glob inside the
# directory costs one command and does not depend on -r working.
v10_sh "cd $OBJ/libc; rm -f *.o *.a *.lst miss d.lst b.log" 600

# ------------------------------------------------------------- 261 objects ---
#
# `make -k', and the -k is load-bearing.  261 members and one that will not
# compile takes the whole run down to nothing -- no archive, no comparison,
# no measurement -- after hours of work that all succeeded.  With -k the run
# builds everything it can and the NEXT step says exactly what is missing.
# ---------------------------------- IS THE OBJECT DIRECTORY ACTUALLY EMPTY? ---
#
# ASSERTED, so that a fast build can be BELIEVED.
#
# THE GUEST'S OWN CLOCK SAYS THIS BUILD TAKES TEN SECONDS, and that reading was
# taken for proof that make had skipped it -- "261 compiles on a simulated
# VAX-750 cannot happen in ten seconds, so the objects must already have been
# there".  **That inference was wrong and is withdrawn.**  Measured against the
# HOST clock, an entire stage-2 run -- boot, 260 compiles, archive, ranlib, 261
# `cmp's, four whole-library compiler trials, install, link, halt -- takes
# about SEVENTY SECONDS.  A real VAX-750 was half a MIPS; open-simh on an
# M-series Mac is two orders of magnitude quicker, so a tenth of a second per
# small C file is exactly right.  The guest's clock simply under-reports (its
# resolution is one second and its calibration is not what this stage measures).
#
# And 150 members came out BYTE-IDENTICAL to Bell Labs' 1989 archive, which is
# not a thing a skipped build can do.  That was the evidence available all
# along.
#
# So the assertion stays -- not because the build is suspected of being skipped,
# but because it is the ONE cheap check that separates "impossibly fast" from
# "measuring the last run", and without it a fast run cannot be trusted either
# way.  `rm -rf' running and printing nothing is not the same as the directory
# being empty.  It is checked HERE, between the clean and the build, where the
# answer can still stop the run before it produces a number.
#
# `ls | sed -n '$='` would count, but V10's ls prints nothing for an empty
# directory and `test -z` on a command substitution is the shorter question.
v10_sh "cd $OBJ/libc; L=`ls | sed -n '1,3p'`" 300
note "the object directory starts EMPTY" \
    [v10_try "cd $OBJ/libc; if test -z \"\$L\"; then echo EM\$OK; fi" "EM-ok" 300]
# And say what was there, if anything -- an assertion that fails without
# naming what it found sends the next person back to the same guess.
v10_run "cd $OBJ/libc; echo LEFTOVER; ls | sed -n '1,20p'; echo LEFTOVEREND" \
        "LEFTOVEREND" 600

v10_sh "date" 120
puts "\n--- LIBC-BUILD-START ---"
v10_sh "cd $OBJ/libc; make -k -f $K/libc.mk \$A \$B \$C $CCM objs > b.log 2>&1; echo done" 14400
puts "--- LIBC-BUILD-END ---"
v10_sh "date" 120

# WHICH ONES ARE MISSING.  No wc and no grep on this machine, so the list is
# walked with a for loop over the generated libc.ord -- the tape's own member
# order, as data.  An empty `miss' is the pass; a non-empty one is printed in
# full, here, while the machine still has it.
v10_sh "cd $OBJ/libc; for f in `cat $K/libc.ord`; do test -f \$f || echo MISS \$f; done > miss" 1800
set complete [v10_try "cd $OBJ/libc; test -s miss || echo ALL\$OK" "ALL-ok" 300]
note "all 261 members compiled" $complete
if {!$complete} {
    # v10_run, NOT v10_sh, AND THE LIST IS WHY.  v10_sh sends the command and
    # its `echo $M+' marker together, so the marker's own echo interleaves
    # character by character into whatever the command prints -- and this
    # command prints two hundred lines.  The first attempt came back with
    # names like `fchmodo.o', `closec.o' and `fioroead.o': real output with
    # single echoed characters spliced through it, which then defeated every
    # host-side count made from the log.  v10_run waits for the command's own
    # closing marker before sending anything else.
    v10_run "cd $OBJ/libc; cat miss; echo MISSEND" "MISSEND" 900
    # Say WHY, not just which.  b.log holds the compiler's own words and they
    # are the finding.
    #
    # sed, not tail: `tail' is the one thing stage 1 cannot build (cmd/tail.c
    # is the only file in the tree that includes the ANSI-prototyped
    # <libc/libc.h>), so a stage-2 run that asks for it gets `tail: not found'
    # exactly where the diagnosis should have been.  sed is prebuilt and can
    # do better than tail anyway -- print the lines that NAME the failure
    # instead of the last N lines whatever they happen to be.
    # DELETE THE COMMANDS, KEEP WHAT IS LEFT -- the opposite of matching on
    # `error', and the reason is that the old filter matched FILENAMES.
    # `/error/p' over b.log returned
    #
    #	cc ... -c /n/v10/src/libc/sys/cerror.s
    #	cc ... -c /n/v10/src/libc/gen/perror.c
    #	cc ... -c /n/v10/src/libc/gen/regerror.c
    #
    # three echoed compile lines for cerror, perror and regerror, and not one
    # diagnostic -- so a run whose build had genuinely failed printed a tidy
    # three-line "error" report naming three members that were fine.  make's
    # own summary line was in the same output and easy to miss.
    #
    # A compile line always begins with the compiler's name, and nothing else
    # in b.log does, so deleting those leaves exactly the diagnostics.
    v10_run "cd $OBJ/libc; sed -e '/^cc /d' -e '/^lcc /d' -e '/^as /d' b.log | sed -n '1,60p'; echo ERREND" "ERREND" 900
    # And make's own last word, which says whether it gave up.
    v10_run "cd $OBJ/libc; sed -n '/not remade/p;/Don.t know/p;/Must be a separator/p' b.log; echo E2END" "E2END" 900
    # UNFILTERED, AND BY HAND.  Every filter in this harness has hidden the
    # answer at least once -- `/error/p' matched cerror.s, `1,60p' cut the tail,
    # and deleting lines that begin with a compiler name deletes any diagnostic
    # printed on the same line as the command.  So the last resort is to run one
    # compile with nothing between its output and the tty.
    #
    # vfprintf.o is the case that needs it: it produces NO diagnostic, NO
    # `*** Error code', and no object, while make still says `objs not remade
    # because of errors' -- three things that cannot all be true.
    v10_run "cd /tmp; rm -f vfprintf.o; echo VFSTART; cc -B$T1/lib/ -t02p -O -DV10 -I$INC -I$S/libc/stdio -c $N/ours/libc/stdio/vfprintf.c; echo VFRC=\$?; ls -l vfprintf.o; echo VFEND" "VFEND" 1800
}

# ------------------------------------------------------------- the archive ---
if {$complete} {
    set arch [v10_try \
        "cd $OBJ/libc; if make -k -f $K/libc.mk \$A \$B \$C $CCM libc.a > a.log 2>&1; then echo AR\$OK; fi" \
        "AR-ok" 7200]
    note "libc.a built by the makefile" $arch
    if {!$arch} { v10_sh "cd $OBJ/libc; tail -30 a.log" 900 }
} else {
    # A PARTIAL LIBRARY, BUILT BY HAND AND SAID SO.  make cannot run the
    # archive rule when a prerequisite failed, so the comparison below would
    # have nothing to measure -- which would turn a partial result into no
    # result.  This is not stage 2 passing; it is stage 2 reporting.
    puts "\n*** INCOMPLETE: archiving what compiled, so the comparison"
    puts "*** below still has something to measure.  This is NOT a pass.\n"
    v10_sh "cd $OBJ/libc; for i in *.o ; do $T1/bin/ld -x -r \$i; mv a.out \$i; done" 7200
    v10_sh "cd $OBJ/libc; echo stripped > stripped" 120
# crt0.o AND mcrt0.o, WHICH NOTHING HAD EVER BUILT.
#
# `install' depends on `libc.a crt0.o mcrt0.o' and this harness only ever asked
# make for `objs' -- so install's prerequisites did not exist, install failed,
# and /usr/s2/lib was empty.  Four assertions said so (`install NO', `staged
# lib/libc.a NO', `staged lib/crt0.o NO', `staged lib/mcrt0.o NO') and none of
# them named the cause, which is why it stood for every run of this stage.
#
# STAGE 3 IS WHAT MADE IT MATTER.  Its very first assertion is `stage 2 present:
# lib/libc.a', and it came back NO on stage 3's first run -- so the fixpoint had
# nothing to link against and all 26 of its checks fell over one missing copy.
# A stage that cannot be consumed by the next one is not finished, however good
# its own numbers are.
v10_sh "cd $OBJ/libc; make -f $K/libc.mk \$A \$B \$C $CCM crt0.o mcrt0.o > c.log 2>&1; echo done" 1800
note "crt0.o and mcrt0.o built" \
    [v10_try "cd $OBJ/libc; test -s crt0.o && test -s mcrt0.o && echo CR\$OK" "CR-ok" 300]

    note "libc.a built BY HAND from what compiled" \
        [v10_try "cd $OBJ/libc; rm -f libc.a; if ar cr libc.a *.o && ranlib libc.a; then echo PA\$OK; fi" \
                 "PA-ok" 3600]
}
note "libc.a exists" [v10_try "cd $OBJ/libc; test -s libc.a && echo EX\$OK" "EX-ok" 300]

# -------------------------------------------- against the tape's own archive ---
#
# ONE: the member list and its ORDER.  `ar t' both, compare with cmp.  This
# is the check that catches a truncated OBJS macro -- make's yytext is
# INMAX = 5000 and our OBJS line is 2299, so there is headroom, but a silent
# truncation would produce a short archive that ranlib blesses and everything
# downstream accepts.
v10_sh "cd $OBJ/libc; ar t libc.a > ours.lst; ar t $S/libc/libc.a > tape.lst" 900
note "member list and order match the tape" \
    [v10_try "cd $OBJ/libc; if cmp ours.lst tape.lst; then echo LS\$OK; fi" "LS-ok" 600]

# TWO: the members themselves, byte for byte.  A measurement, not an
# assertion -- see the header.  The guest prints one DIFF line per member
# that differs and v10-stage2.sh counts them out of the log, because there is
# no wc here to count with and arithmetic in this shell is not worth the
# trouble it would cause.
# (the tape's archive was already extracted above, for the cpp trial)
puts "\n--- LIBC-CMP-START ---"
v10_sh "cd $OBJ/libc; for f in `cat $K/libc.ord`; do cmp -s \$f ../tape/\$f || echo DIFF \$f; done > d.lst" 3600
# v10_run, for the reason given above the MISS dump: a two-hundred-line `cat'
# under v10_sh comes back with the marker's echo spliced through it.
v10_run "cd $OBJ/libc; cat d.lst; echo DIFFEND" "DIFFEND" 1800

# THREE: WHICH COMPILER DID BELL LABS USE FOR EACH ONE?
#
# A member whose bytes differ from the tape's is not necessarily wrong -- it
# may simply have been compiled by the OTHER compiler.  V10 was never built
# from scratch, so its per-file compiler choice is undocumented, and the tape's
# own mkfile is demonstrably wrong about it (it routes ten to lcc; twenty-five
# need it).  But the archive itself is evidence: recompile a differing member
# with lcc, strip it the way the tape does, and compare again.  A match NAMES
# the compiler Bell Labs used.
#
# That is what turns "the toolchain requirement is mixed and undocumented"
# from a warning into a map -- and it is the only way to know whether the 90
# compiled-but-different members are our defect or simply cc's output where
# the tape holds lcc's.
#
# `ld -x -r' matters here as much as the compile: every member of the tape's
# archive went through it, so an unstripped object cannot match no matter
# which compiler produced it.
v10_sh "rm -rf $OBJ/lcc; mkdir $OBJ/lcc" 300
puts "\n--- WHICH-COMPILER-START ---"
v10_sh "L='-N -I$S/libc/stdio -I/usr/include/lcc -I/usr/include/libc -I/usr/include -DV10'" 120
v10_sh "cd $OBJ/libc; sed -n 's/^DIFF //p' d.lst > d.names" 300
v10_run "cd $OBJ/lcc; for o in `cat ../libc/d.names`; do s=`sed -n \"s/^\$o //p\" $K/libc.src`; lcc \$L -c $S/libc/\$s > /dev/null 2>&1; $T1/bin/ld -x -r \$o > /dev/null 2>&1 && mv a.out \$o; if cmp -s \$o ../tape/\$o; then echo LCCMATCH \$o; fi; done; echo WHICHEND" \
        "WHICHEND" 7200

# AND THE OTHER VARIABLE: WAS c2 RUN?
#
# `-O' is what makes V10's cc invoke c2, the peephole optimiser, and the
# mkfile's default rule says `cc -O -c'.  But the mkfile has already been shown
# wrong about which compiler a file needs, so it is worth no more trust about
# which FLAGS one got: V10 accreted, and a member compiled before somebody
# added -O to the rule would still be sitting in the archive.
#
# One flag, two possibilities, ~110 candidates -- exactly the shape the oracle
# above is for.  A match names the flags Bell Labs used as surely as it names
# the compiler.
# AND THE VARIABLE I HAD BEEN ASSUMING AWAY: WHICH ccom?
#
# Stage 1's ccom is built from cmd/ccom/vax/ SOURCE.  The tape's libc.a was
# built by the shipped BINARY, cmd/ccom/vax/comp -- which is what the golden
# installed as /lib/ccom.  In a tree that accreted over years those two need
# not correspond: the source can be newer or older than the binary beside it,
# and nothing on the tape says which.
#
# The tape's own members are the evidence.  They are CLEAN -- no source paths,
# no .stabs, no temp names, just global symbols, because `ld -x -r' removed
# everything local -- so a member like abort.o is 24 bytes of text, and a
# difference there is real code generation and not cosmetics.  If the golden's
# own compiler reproduces those bytes where stage 1's does not, then the source
# in cmd/ccom/vax/ is not the compiler that built this archive, and that is
# worth far more than a member count.
#
# `cc' with NO -B is the golden's compiler: /lib/ccom, the tape's comp.
v10_sh "rm -rf $OBJ/tapecc; mkdir $OBJ/tapecc" 300
v10_run "cd $OBJ/tapecc; for o in `cat ../libc/d.names`; do s=`sed -n \"s/^\$o //p\" $K/libc.src`; cc -O -I/usr/include -c $S/libc/\$s > /dev/null 2>&1; $T1/bin/ld -x -r \$o > /dev/null 2>&1 && mv a.out \$o; if cmp -s \$o ../tape/\$o; then echo TAPECCMATCH \$o; fi; done; echo TAPECCEND" \
        "TAPECCEND" 7200

v10_sh "rm -rf $OBJ/noO; mkdir $OBJ/noO" 300
v10_run "cd $OBJ/noO; for o in `cat ../libc/d.names`; do s=`sed -n \"s/^\$o //p\" $K/libc.src`; cc -B$T1/lib/ -t02p -I/usr/include -c $S/libc/\$s > /dev/null 2>&1; $T1/bin/ld -x -r \$o > /dev/null 2>&1 && mv a.out \$o; if cmp -s \$o ../tape/\$o; then echo NOOMATCH \$o; fi; done; echo NOOEND" \
        "NOOEND" 7200
# DID THE LOOP ACTUALLY COMPILE ANYTHING?  It sends lcc's diagnostics to
# /dev/null, so "no matches" and "lcc produced nothing" look identical from
# the outside -- and the first is a result about Bell Labs while the second is
# a bug in this harness.  Distinguish them, here, rather than reporting a zero
# that could mean either.
note "the lcc rebuild produced objects" \
    [v10_try "cd $OBJ/lcc; test -s abort.o && echo LB\$OK" "LB-ok" 300]
# And one member compiled OUT LOUD, so a failure names itself.
v10_sh "rm -rf /tmp/l1; mkdir /tmp/l1" 120
v10_run "cd /tmp/l1; lcc \$L -c $S/libc/gen/abort.c; echo ONEEND" "ONEEND" 600
puts "--- WHICH-COMPILER-END ---"

# ------------------------------------------- CAN ONE COMPILER BUILD ALL 261? ---
#
# The tape's mixture is an unfinished port, not a design to reproduce (see the
# 4.1-year spread of ar dates), so the archive worth building is the best one
# from a SINGLE compiler.  cc is already ruled out -- it cannot parse the ANSI
# printf family at all -- which leaves lcc, and C89 accepts old-style function
# definitions, so it ought to manage the K&R members too.
#
# Ought to is not measured.  Try all 261.
#
# AND CHECK THE SIZES, because `test -f' is not evidence: a cpp that writes
# nothing still yields a valid empty object and a zero exit status, which is
# how 26 empty members passed for real earlier in this same harness.  The sizes
# go to the host, which can do arithmetic.
v10_sh "rm -rf $OBJ/alllcc; mkdir $OBJ/alllcc" 300
puts "\n--- ALL-LCC-START ---"
v10_run "cd $OBJ/alllcc; for o in `cat $K/libc.ord`; do s=`sed -n \"s/^\$o //p\" $K/libc.src`; lcc \$L -c $S/libc/\$s > /dev/null 2>&1; test -f \$o || echo LCCFAIL \$o; done; echo ALLLCCEND" \
        "ALLLCCEND" 7200
v10_run "cd $OBJ/alllcc; ls -l; echo LSEND" "LSEND" 1800
puts "--- ALL-LCC-END ---"
puts "--- LIBC-CMP-END ---"

# ---------------------------------------------------------------- install ---
note "install" \
    [v10_try "cd $OBJ/libc; if make -f $K/libc.mk \$A \$B \$C $CCM install > i.log 2>&1; then echo IN\$OK; fi" \
             "IN-ok" 1800]
# SAY WHY, NOT JUST THAT.  `install NO' plus three `staged ... NO' stood for
# every run of this stage and named nothing; crt0.o turned out to be only half
# of it.  i.log is where make's own words are, and nothing was reading it.
v10_run "cd $OBJ/libc; sed -e '/^cc /d' -e '/^as /d' i.log | sed -n '1,40p'; echo IEND" "IEND" 900
foreach p {lib/libc.a lib/crt0.o lib/mcrt0.o} {
    note "staged $p" [v10_try "test -s $T/$p && echo ST\$OK" "ST-ok" 120]
}

# ------------------------------------------------------------ the smoke test ---
#
# THE ONE THAT MATTERS: a program built by the stage-1 compiler and linked
# against the stage-2 library, running.  Everything above could pass on an
# archive that is well formed and useless.
#
# $T/lib/libc.a IS NAMED ON THE LINK LINE, not reached with -l.  V10's cc has
# no `-t c' letter, so its implicit -lc resolves out of /lib/libc.a -- the
# TAPE's -- and a stage that had just built its own would silently keep
# linking against Bell Labs'.  ld takes the first definition it finds, so
# ours wins and the implicit -lc adds nothing.
#
# crt0.o is still /lib/crt0.o for the same missing letter, and that is worth
# stating rather than glossing: it is V10's own (assembled by V10's as when
# the golden was built), so nothing here is the Eighth Edition's -- but it is
# not stage 2's either, and closing that gap is stage 3's job.
v10_sh "cd /tmp; rm -f s2.c s2" 120
v10_sh "cd /tmp; echo '#include <stdio.h>' > s2.c" 120
v10_sh "cd /tmp; echo 'char b\[64\];' >> s2.c" 120
v10_sh "cd /tmp; echo 'main(){ strcpy(b,\"STAGE2\"); printf(\"%s %d\\n\", b, strlen(b)); return 0; }' >> s2.c" 120
# The link is also where a stale __.SYMDEF would show itself: cp gives the
# archive a new mtime while the table of contents keeps the old one, and
# cmd/ld.c answers that with "table of contents for archive is out of date;
# rerun ranlib(1)" and ONE sequential pass.  libc.mk's install target runs
# ranlib after the copy for this reason; assert that it worked.
set stale [v10_try "cd /tmp; cc -B$T1/lib/ -t02p -o s2 s2.c $T/lib/libc.a" "out of date" 1800]
note "no stale table of contents" [expr {!$stale}]
note "links against the stage-2 libc" \
    [v10_try "cd /tmp; if cc -B$T1/lib/ -t02p -o s2 s2.c $T/lib/libc.a; then echo LK\$OK; fi" "LK-ok" 1800]
note "and the program runs" [v10_try "cd /tmp; ./s2" "STAGE2 6" 600]

# ---------------------------------------------------------------- what landed ---
v10_sh "ls -l $T/lib" 600
v10_sh "df" 120

set failed [report]
v10_halt
exit [expr {$failed ? 1 : 0}]
