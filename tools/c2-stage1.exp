#!/usr/bin/env expect
#
# C2 + C3: mount the repo's v8/ tree in the guest and build stage 1 from it.
#
# End to end this proves four things at once:
#   - the repo's source is reachable by the machine (netfs share at /n/src)
#   - the two directory pairs that cannot coexist on macOS at all are visible
#     under their true names (usr/src/cmd/{Mail,mail}, jerq/src/lib/{C,c})
#   - a clock that make(1) can believe
#   - the bootstrap toolchain builds from it, compiled straight off the share,
#     in the order the source dictates, without writing a byte outside /b
#
# Nothing here installs into /. If this script fails halfway the machine it ran
# on is exactly as usable as it was before -- that is the whole design.

set timeout 600
log_file -a c2-stage1.log
proc sendline {x} { send "$x\r" }

proc must {pat {t 0}} {
    global timeout
    set use [expr {$t > 0 ? $t : $timeout}]
    expect -timeout $use "$pat" {
    } timeout {
        send_user "\n*** FAILED: never saw '$pat' after ${use}s ***\n"; exit 3
    } eof {
        send_user "\n*** FAILED: simulator exited waiting for '$pat' ***\n"; exit 4
    }
}
# DO NOT SYNCHRONISE ON THE PROMPT.  It cannot be made to work here.
#
# V8 echoes typed characters as they arrive, interleaved with whatever is still
# printing, so the prompt string turns up *in the middle of the echo of the
# command you are sending*:
#
#     hipnx%%%  /n/src/mk/stage.sh /n/src /usr/bld/src
#
# Any matcher watching for the prompt then matches one that belongs to a command
# already dealt with, sends the next command early, and every timeout after that
# is charged to the wrong thing.  That is what killed staging twice -- once at
# 600s of a 2400s budget, looking exactly like a netfs stall.
#
# So each command carries its own end marker and we wait for that, which is the
# same output-anchored technique the SIMH remote console needs (see
# docs/a1-notes.md).  The sequence number makes a stale match impossible, and
# the timeout now bounds the command it is written on, with no bookkeeping.
#
# The marker must contain no character the tty treats as editing.  "@@" was a
# poor first choice: @ is the line-kill character on a V7-derived tty, so every
# marker erased the line it was in and the shell only ever saw fragments,
# ending at a continuation prompt.  '+' is inert.
#
# It also must not appear in the *echo* of the command, or we match our own
# typing.  Building it from a shell variable does that: the tty sees "+ok7;"
# and "echo $M+", neither of which contains "+ok7+", while the shell prints
# exactly "+ok7+".
set SEQ 0
proc sh {cmd {t 0}} {
    global SEQ
    incr SEQ
    # Three lines, not one.  Appending "; echo $M+" to the command breaks any
    # command ending in "&" -- `cmd & ; echo` is a syntax error, so backgrounding
    # ipconfig silently took the network down with it.  Separate lines let the
    # shell treat each as its own command; the tty buffers them in order.
    sendline "M=+ok$SEQ"
    sendline "$cmd"
    sendline "echo \$M+"
    must "+ok$SEQ+" $t
}
proc bootsh {cmd {t 0}} { must "# " $t; sendline $cmd }
proc simh {cmd {t 0}} { must "sim>" $t; sendline $cmd }

# cat waits for input, so this cannot use sh -- the marker would never arrive
# until after the data has been fed and the ^D delivered.
proc catfile {src dst} {
    global SEQ
    incr SEQ
    sendline "M=+ok$SEQ"
    sendline "cat > $dst"
    set f [open $src r]
    while {[gets $f line] >= 0} { sendline $line }
    close $f
    send "\x04"
    sendline "echo \$M+"
    must "+ok$SEQ+" 300
}

set port [lindex $argv 0]
if {$port == ""} { set port 9300 }

spawn vax780
simh "set noasynch"
simh "set cpu idle=4.1BSD"
simh "set tto 7b"
simh "set rp0 rp07"
simh "at rp0 rp07v8.net"
# rp1 is the build filesystem -- objects and products only, never source.
simh "set rp1 rp06"
simh "at rp1 rp06build"
simh "set il enable"
simh "attach il nat:"
simh "load -o bootV8 0"
simh "run 2"
must "login:" 300
sendline "root"
bootsh "PS1='ipnx%%% '" 120
sh "echo C2-boot-ok" 120

# Clear any wreckage from an earlier attempt BEFORE mounting anything.  This
# cannot be left to stage.sh, because stage.sh lives on the share and a full
# root partition is precisely what stops the share being readable: `ls /n/src`
# succeeds, every open(2) fails, and it looks like a netfs bug rather than a
# disk that ran out of room in a previous run.
send_user "\n=== clear previous attempts ===\n"
sh "df /"
sh "rm -rf /bld"
sh "rm -rf /usr/bld"
sh "/etc/umount /dev/rp1a"
sh "df /"

# ------------------------------------------------------------- networking
# Same sequence the N track settled on: il0 up, TCP discipline pushed onto
# /dev/ip6, default route to the SLiRP gateway which aliases to host loopback.
send_user "\n=== network ===\n"
sh "/etc/mknod /dev/il0 c 44 0"
sh "/etc/mknod /dev/il1 c 44 1"
sh "/etc/mknod /dev/ip0  c 42 0"
sh "/etc/mknod /dev/ip6  c 42 6"
sh "for i in 0 1 2 3 4 5 6 7; do /etc/mknod /dev/tcp0\$i c 43 \$i; done"
sh "chmod 666 /dev/tcp0? /dev/ip0 /dev/ip6 /dev/il0 /dev/il1"
sh "mkdir /usr/inet/lib"
sh "echo '10.0.2.15\tv8' > /usr/inet/lib/hosts"
sh "echo '10.0.2.2\tgateway' >> /usr/inet/lib/hosts"
sh "echo '10.0.0.0\tslirp-net' > /usr/inet/lib/networks"
sh "cd /usr/src/cmd/inet/etc; ./ipconfig /dev/il0 v8 slirp-net /dev/il1 &"
sh "sleep 3"
sh "cd /usr/src/cmd/inet/etc; ./tcpconfig /dev/ip6 &"
sh "sleep 3"
sh "cd /usr/src/cmd/inet/etc; ./route add '*' gateway; echo route-rc=$?"

# ------------------------------------------------------------ mount v8/
send_user "\n=== mount the repo tree at /n/src ===\n"
sh "mkdir /n"
sh "mkdir /n/src"
catfile "../../tools/v8/nmount.c" "/tmp/nmount.c"
sh "cd /tmp; cc -o nmount nmount.c -lin" 300
sh "/tmp/nmount 10.0.2.2 $port 65 /n/src" 120
sh "echo C2-MOUNTED"
sh "ls /n/src"
sh "sed 5q /n/src/CASEMAP"

# ------------------------------------------------- the case-collision pairs
# usr/src/cmd/{Mail,mail} and jerq/src/lib/{C,c} differ only in case, so macOS
# can hold exactly one of each and the repo stores the loser percent-escaped.
# netfsd's CaseMap serves the true name, which is not cosmetic: a struct direct
# has 14 bytes for a name and "%43%49%52%43%4C%45" is 18, so the escaped
# spelling physically cannot appear in a V8 directory.
#
# Both names existing is not the test -- a case-insensitive server would show
# two names for one file and pass it.  The test is that they are DIFFERENT
# files, so cmp must report a difference.
#
# Keep every line well under CANBSIZ (256, sys/h/param.h): the tty discards an
# over-long canonical line, which would present as an unexplained hang rather
# than as an error.  Hence the shell variables.
send_user "\n=== case-collision pairs ===\n"
sh "A=/n/src/usr/src/cmd/Mail/Makefile; B=/n/src/usr/src/cmd/mail/Makefile"
sh "ls -l \$A \$B"
sh "if test -f \$A -a -f \$B; then cmp -s \$A \$B || echo C3-CASE-Mail-ok; fi" 120
sh "ls /n/src/jerq/src/lib"
sh "if test -d /n/src/jerq/src/lib/C -a -d /n/src/jerq/src/lib/c; then echo C3-CASE-C-ok; fi"
# and nothing escaped may leak into a listing
sh "ls /n/src/usr/src/cmd /n/src/jerq/src/lib /n/src/usr/bin > /tmp/ls.out" 120
sh "if grep '%' /tmp/ls.out > /dev/null; then echo C3-CASE-DIRTY; else echo C3-CASE-clean; fi"

# --------------------------------------------------------------- the clock
# make(1) compares mtimes, and the source mtimes arrive from the host over
# netfs as real 2026 epochs.  A guest sitting in 1976 therefore thinks every
# object it just produced is older than its source, so `make` followed by
# `make install` rebuilds the whole component twice.
#
# V8 boots into 1976 for a specific reason: the kernel takes the *year* from
# the root filesystem's superblock and only the position within the year from
# the TODR (sys/sys/machdep.c, clkinit).  A superblock time below 5*SECYR
# trips "preposterous time in file system", whose fallback is the hardcoded
# 6*SECYR + 186*SECDAY -- mid-1976 exactly.
#
# And /bin/date cannot fix it: Berkeley's 1980 date.c does a bare
# "year += 1900" on two digits, so 26 means 1926.  We own that source now and
# it has the usual 69/70 window applied, so compile our copy off the share and
# use it -- which also proves the share can feed the compiler before we bet a
# five-figure-second build on it.
#
# -u throughout, with UTC digits: stime(2) takes GMT, and going through local
# time would apply whatever zone the V8 kernel was configured with against
# whatever zone this Mac is in.  Absolute epochs are what make compares, so
# the zone only ever needed to be right for display.
send_user "\n=== clock ===\n"
sh "date"
sh "cd /tmp; cc -o newdate /n/src/usr/src/cmd/date.c" 300
sh "/tmp/newdate -u [exec date -u +%y%m%d%H%M.%S]"
sh "date"
# sync writes the superblock, which is what carries the year to the next boot
sh "sync"
sh "if date | grep '[exec date -u +%Y]' > /dev/null; then echo C3-CLOCK-ok; else echo C3-CLOCK-BAD; fi"

# ------------------------------------- a filesystem for the build products
# Real Unix mounted /usr/src as its own disk for exactly this reason.  Here the
# source needs no disk at all -- it stays on the share -- but the objects do,
# and V8 fixes a filesystem's inode count at mkfs time.  /usr was reported by
# fsck as holding 8799 files; dropping a build tree into it exhausted the inodes
# and V7 mkdir started answering "cannot access .".  So the build gets rp1, its
# own filesystem, sized for the job.
send_user "
=== build filesystem on rp1 ===
"
sh "/etc/mknod /dev/rp1a b 2 8"
sh "/etc/mknod /dev/rrp1a c 4 8"
sh "/etc/mkfs /dev/rrp1a 40000" 600
sh "mkdir /b"
sh "/etc/mount /dev/rp1a /b"
sh "df /b"

# ---------------------------------------------------------- build stage 1
send_user "\n=== stage 1: bootstrap toolchain ===\n"
sh "date"
sh "sh /n/src/mk/build1.sh /n/src /b 2>&1" 5400
sh "date"

# Did we build a compiler that works?  Cheapest possible proof: use it.
send_user "\n=== does the new toolchain compile anything? ===\n"
sh "cd /tmp"
sh "echo 'main(){printf(\"newcc-ok\\n\");}' > t.c"
sh "cat t.c"
sh "/b/tools/bin/cc -B/b/tools/ -t02p -o t t.c" 300
sh "./t"

# And the real question: can the new compiler rebuild something the old one
# built, identically?  Stripped, because cc bakes its PID into the symbol table.
send_user "\n=== new compiler vs old, same source ===\n"
sh "/b/tools/bin/cc -B/b/tools/ -t02p -O -o ls.new /n/src/usr/src/cmd/ls.c" 600
sh "cc -O -o ls.old /n/src/usr/src/cmd/ls.c" 600
sh "strip ls.new ls.old"
sh "ls -l ls.new ls.old"
sh "cmp ls.new ls.old; echo cmp-newcc-vs-oldcc=\$?"

sh "echo C2-DONE"
sh "cd /; sync; sync"
sh "/etc/halt" 120
simh "quit" 60
expect eof
wait
send_user "\n=== C2/C3 STAGE 1 DONE ===\n"
