#!/usr/bin/env expect
#
# C2 + C3: mount the repo's v8/ tree in the guest and build stage 1 from it.
#
# End to end this proves four things at once:
#   - the repo's source is reachable by the machine (netfs share at /n/src)
#   - the two directory pairs that cannot coexist on macOS at all are visible
#     under their true names (usr/src/cmd/{Mail,mail}, jerq/src/lib/{C,c})
#   - a clock that make(1) can believe
#   - the bootstrap toolchain builds from it, compiled straight off the share,
#     in the order the source dictates, without writing a byte outside /b
#
# Nothing here installs into /. If this script fails halfway the machine it ran
# on is exactly as usable as it was before -- that is the whole design.

set timeout 600
log_file -a c2-stage1.log
proc sendline {x} { send "$x\r" }

proc must {pat {t 0}} {
    global timeout
    set use [expr {$t > 0 ? $t : $timeout}]
    expect -timeout $use "$pat" {
    } timeout {
        send_user "\n*** FAILED: never saw '$pat' after ${use}s ***\n"; exit 3
    } eof {
        send_user "\n*** FAILED: simulator exited waiting for '$pat' ***\n"; exit 4
    }
}
# DO NOT SYNCHRONISE ON THE PROMPT.  It cannot be made to work here.
#
# V8 echoes typed characters as they arrive, interleaved with whatever is still
# printing, so the prompt string turns up *in the middle of the echo of the
# command you are sending*:
#
#     hipnx%%%  /n/src/mk/stage.sh /n/src /usr/bld/src
#
# Any matcher watching for the prompt then matches one that belongs to a command
# already dealt with, sends the next command early, and every timeout after that
# is charged to the wrong thing.  That is what killed staging twice -- once at
# 600s of a 2400s budget, looking exactly like a netfs stall.
#
# So each command carries its own end marker and we wait for that, which is the
# same output-anchored technique the SIMH remote console needs (see
# docs/a1-notes.md).  The sequence number makes a stale match impossible, and
# the timeout now bounds the command it is written on, with no bookkeeping.
#
# The marker must contain no character the tty treats as editing.  "@@" was a
# poor first choice: @ is the line-kill character on a V7-derived tty, so every
# marker erased the line it was in and the shell only ever saw fragments,
# ending at a continuation prompt.  '+' is inert.
#
# It also must not appear in the *echo* of the command, or we match our own
# typing.  Building it from a shell variable does that: the tty sees "+ok7;"
# and "echo $M+", neither of which contains "+ok7+", while the shell prints
# exactly "+ok7+".
set SEQ 0
proc sh {cmd {t 0}} {
    global SEQ
    incr SEQ
    # Three lines, not one.  Appending "; echo $M+" to the command breaks any
    # command ending in "&" -- `cmd & ; echo` is a syntax error, so backgrounding
    # ipconfig silently took the network down with it.  Separate lines let the
    # shell treat each as its own command; the tty buffers them in order.
    sendline "M=+ok$SEQ"
    sendline "$cmd"
    sendline "echo \$M+"
    must "+ok$SEQ+" $t
}
proc bootsh {cmd {t 0}} { must "# " $t; sendline $cmd }
proc simh {cmd {t 0}} { must "sim>" $t; sendline $cmd }

# cat waits for input, so this cannot use sh -- the marker would never arrive
# until after the data has been fed and the ^D delivered.
proc catfile {src dst} {
    global SEQ
    incr SEQ
    sendline "M=+ok$SEQ"
    sendline "cat > $dst"
    set f [open $src r]
    while {[gets $f line] >= 0} { sendline $line }
    close $f
    send "\x04"
    sendline "echo \$M+"
    must "+ok$SEQ+" 300
}

set port [lindex $argv 0]
if {$port == ""} { set port 9300 }

spawn vax780
simh "set noasynch"
simh "set cpu idle=4.1BSD"
simh "set tto 7b"
simh "set rp0 rp07"
simh "at rp0 rp07v8.net"
# rp1 is the build filesystem -- objects and products only, never source.
simh "set rp1 rp06"
simh "at rp1 rp06build"
simh "set il enable"
simh "attach il nat:"
simh "load -o bootV8 0"
simh "run 2"
must "login:" 300
sendline "root"
bootsh "PS1='ipnx%%% '" 120
# Every result marker is spelled with this variable, never literally.
#
# The tty echoes typed characters as they arrive, so the echo of
# `echo C3-CLOCK-ok` lands in the output stream too -- and because the echo
# interleaves *into* whatever is printing, the marker turns up mid-line
# ("echC3-CASE-clean"), which defeats a ^-anchored grep just as reliably as an
# unanchored one matches the echo.  Writing `echo C3-CLOCK$OK` puts
# "C3-CLOCK$OK" in the echo and "C3-CLOCK-ok" only in the output, so an
# unanchored grep for the full marker cannot match anything but the result.
sh "OK=-ok" 120
sh "echo C2-boot\$OK" 120

# Clear any wreckage from an earlier attempt BEFORE mounting anything.  A full
# root partition is precisely what stops the share being readable: `ls /n/src`
# succeeds, every open(2) fails, and it presents as a netfs bug rather than as
# a disk that ran out of room in a previous run.
send_user "\n=== clear previous attempts ===\n"
sh "df /"
sh "rm -rf /bld"
sh "rm -rf /usr/bld"
sh "/etc/umount /dev/rp1g"
sh "df /"

# ------------------------------------------------------------- networking
# Same sequence the N track settled on: il0 up, TCP discipline pushed onto
# /dev/ip6, default route to the SLiRP gateway which aliases to host loopback.
send_user "\n=== network ===\n"
sh "/etc/mknod /dev/il0 c 44 0"
sh "/etc/mknod /dev/il1 c 44 1"
sh "/etc/mknod /dev/ip0  c 42 0"
sh "/etc/mknod /dev/ip6  c 42 6"
sh "for i in 0 1 2 3 4 5 6 7; do /etc/mknod /dev/tcp0\$i c 43 \$i; done"
sh "chmod 666 /dev/tcp0? /dev/ip0 /dev/ip6 /dev/il0 /dev/il1"
sh "mkdir /usr/inet/lib"
sh "echo '10.0.2.15\tv8' > /usr/inet/lib/hosts"
sh "echo '10.0.2.2\tgateway' >> /usr/inet/lib/hosts"
sh "echo '10.0.0.0\tslirp-net' > /usr/inet/lib/networks"
sh "cd /usr/src/cmd/inet/etc; ./ipconfig /dev/il0 v8 slirp-net /dev/il1 &"
sh "sleep 3"
sh "cd /usr/src/cmd/inet/etc; ./tcpconfig /dev/ip6 &"
sh "sleep 3"
sh "cd /usr/src/cmd/inet/etc; ./route add '*' gateway; echo route-rc=$?"

# ------------------------------------------------------------ mount v8/
send_user "\n=== mount the repo tree at /n/src ===\n"
sh "mkdir /n"
sh "mkdir /n/src"
catfile "../../tools/v8/nmount.c" "/tmp/nmount.c"
sh "cd /tmp; cc -o nmount nmount.c -lin" 300
sh "/tmp/nmount 10.0.2.2 $port 65 /n/src" 120
sh "echo C2-MOUNTED\$OK"
sh "ls /n/src"
sh "sed 5q /n/src/CASEMAP"
# Grade on a marker, not on the file's contents: the header is prose and
# grows, so "the mapping is in the first five lines" was true when written
# and is not now.  The echo carries "Mail" but never "C3-CASEMAP-ok".
sh "if grep Mail /n/src/CASEMAP > /dev/null; then echo C3-CASEMAP\$OK; fi"

# ------------------------------------------------- the case-collision pairs
# usr/src/cmd/{Mail,mail} and jerq/src/lib/{C,c} differ only in case, so macOS
# can hold exactly one of each and the repo stores the loser percent-escaped.
# netfsd's CaseMap serves the true name, which is not cosmetic: a struct direct
# has 14 bytes for a name and "%43%49%52%43%4C%45" is 18, so the escaped
# spelling physically cannot appear in a V8 directory.
#
# Both names existing is not the test -- a case-insensitive server would show
# two names for one file and pass it.  The test is that they are DIFFERENT
# files, so cmp must report a difference.
#
# Keep every line well under CANBSIZ (256, sys/h/param.h): the tty discards an
# over-long canonical line, which would present as an unexplained hang rather
# than as an error.  Hence the shell variables.
send_user "\n=== case-collision pairs ===\n"
sh "A=/n/src/usr/src/cmd/Mail/Makefile; B=/n/src/usr/src/cmd/mail/Makefile"
sh "ls -l \$A \$B"
sh "if test -f \$A -a -f \$B; then cmp -s \$A \$B || echo C3-CASE-Mail\$OK; fi" 120
sh "ls /n/src/jerq/src/lib"
sh "if test -d /n/src/jerq/src/lib/C -a -d /n/src/jerq/src/lib/c; then echo C3-CASE-C\$OK; fi"
# and nothing escaped may leak into a listing
sh "ls /n/src/usr/src/cmd /n/src/jerq/src/lib /n/src/usr/bin > /tmp/ls.out" 120
sh "if grep '%' /tmp/ls.out > /dev/null; then echo C3-CASE-DIRTY; else echo C3-CASE-clean\$OK; fi"

# --------------------------------------------------------------- the clock
# make(1) compares mtimes, and the source mtimes arrive from the host over
# netfs as real 2026 epochs.  A guest sitting in 1976 therefore thinks every
# object it just produced is older than its source, so `make` followed by
# `make install` rebuilds the whole component twice.
#
# V8 boots into 1976 for a specific reason: the kernel takes the *year* from
# the root filesystem's superblock and only the position within the year from
# the TODR (sys/sys/machdep.c, clkinit).  A superblock time below 5*SECYR
# trips "preposterous time in file system", whose fallback is the hardcoded
# 6*SECYR + 186*SECDAY -- mid-1976 exactly.
#
# And /bin/date cannot fix it: Berkeley's 1980 date.c does a bare
# "year += 1900" on two digits, so 26 means 1926.  We own that source now and
# it has the usual 69/70 window applied, so compile our copy off the share and
# use it -- which also proves the share can feed the compiler before we bet a
# five-figure-second build on it.
#
# -u throughout, with UTC digits: stime(2) takes GMT, and going through local
# time would apply whatever zone the V8 kernel was configured with against
# whatever zone this Mac is in.  Absolute epochs are what make compares, so
# the zone only ever needed to be right for display.
send_user "\n=== clock ===\n"
sh "date"
sh "cd /tmp; cc -o newdate /n/src/usr/src/cmd/date.c" 300
sh "/tmp/newdate -u [exec date -u +%y%m%d%H%M.%S]"
sh "date"
# sync writes the superblock, which is what carries the year to the next boot
sh "sync"
sh "if date | grep '[exec date -u +%Y]' > /dev/null; then echo C3-CLOCK\$OK; else echo C3-CLOCK-BAD; fi"

# ------------------------------------- a filesystem for the build products
# Real Unix mounted /usr/src as its own disk for exactly this reason.  Here the
# source needs no disk at all -- it stays on the share -- but the objects do,
# and V8 fixes a filesystem's inode count at mkfs time.  /usr was reported by
# fsck as holding 8799 files; dropping a build tree into it exhausted the inodes
# and V7 mkdir started answering "cannot access .".  So the build gets rp1, its
# own filesystem, sized for the job.
#
# Partition g, not a.  hp6_sizes (sys/dev/hp.c) gives the RP06 as
#
#	a  15884 sectors  cyl 0-37       g  291280 sectors  cyl 118-814
#	b  33440          cyl 38-117     c  340670          whole disk
#
# and B0 used rp1a as a raw courier, which needs no size at all.  A 40000
# *block* (40 MB) filesystem does not fit in a 15884 *sector* (7.7 MB)
# partition, and mkfs lays its free list down from the top, so the very first
# write went past the end: "write error: 39968" with nothing else wrong.
#
# Minor number is drive<<3 | partition, so drive 1 partition g is 14.
#
# 60000 blocks gives 60 MB and, by mkfs's own arithmetic (n/25 i-list blocks
# at NIPB=16 inodes each), 38400 inodes.  Both are ample: stage 1 writes a few
# hundred files, and even a full world build is working against a 24 MB
# source tree.  Inode count is worth stating rather than assuming -- V8 fixes
# it at mkfs time and running out presents as mkdir answering "cannot access .".
send_user "
=== build filesystem on rp1 ===
"
# hp is BLOCK major 0 and CHAR major 4 -- the two are unrelated tables and the
# numbers do not match (sys/dev/conf.c).  Block major 2 is `up`, a Unibus disk
# this machine does not have, so `mknod /dev/rp1g b 2 14` built a node pointing
# at upstrategy on absent hardware and mount died on a wild pointer:
#
#	type 8 ... code xae50d144 pc x800022b9
#	panic: trap
#
# It cost two runs because it does not look like a device-number mistake.  fsck
# passed immediately beforehand -- through the RAW node, c 4 14, which was
# right -- so the filesystem was provably fine and the panic read as a
# filesystem or mount-table problem.  Whenever raw works and block does not,
# suspect the majors before anything else.
# rm first: mknod does NOT replace an existing node, it just says "File
# exists" and carries on.  So a bad node made by an earlier run outlives the
# fix, and the next run panics again in exactly the same place with a script
# that is now correct -- which is what happened here, and it reads as the fix
# not working rather than as the fix not being applied.  /dev/rp1a is removed
# too: run 1 left a b 2 8 behind by the same mistake.
sh "rm -f /dev/rp1g /dev/rrp1g /dev/rp1a"
sh "/etc/mknod /dev/rp1g b 0 14"
sh "/etc/mknod /dev/rrp1g c 4 14"
# record the majors next to a node that is known-good, so a repeat is one
# glance rather than another two runs
sh "ls -l /dev/rp0a /dev/rp1g /dev/rrp1g"
sh "/etc/mkfs /dev/rrp1g 60000" 1800
# Do not mount an unverified filesystem.  Mounting the failed one panicked the
# kernel outright -- "type 8 ... panic: trap" -- which costs a repair cycle on
# an image that was fine a moment earlier.  fsck on a fresh filesystem is
# seconds, and its exit status is the gate.
sh "if /etc/fsck -y /dev/rrp1g; then echo BUILDFS\$OK; fi" 900
sh "mkdir /b"
sh "if /etc/fsck -y /dev/rrp1g > /dev/null; then /etc/mount /dev/rp1g /b; fi" 900
sh "df /b"

# ---------------------------------------------------------- build stage 1
send_user "\n=== stage 1: bootstrap toolchain ===\n"
sh "date"
sh "sh /n/src/mk/build1.sh /n/src /b 2>&1" 5400
sh "date"

# ------------------------------------------------------------------- libc
# STAGE 2.  libc must come before the second toolchain: every stage-1 binary is
# linked against the TAPE's libc.a, because that is the only one in existence
# when stage 1 runs.  Rebuilding the toolchain first would give fourteen
# binaries still carrying the old library, which have to be built again once
# libc exists -- a round that buys nothing.
send_user "\n=== stage 2: libc from our source ===\n"
sh "date"
sh "sh /n/src/mk/buildlibc.sh /n/src /b 2 2>&1" 7200
sh "date"

# S5: the pass directory should now hold everything cc executes.  If as or ld
# is missing here, -t02palc below fails with "cannot load", which is a clear
# error but a slow one -- 40 minutes into stage 3.
#
# The count is done in the guest and reported as one marker.  Doing it host
# side meant grepping an `ls -l` out of the transcript for eight filenames,
# which is a lot of regex standing between us and a yes/no that the guest can
# simply answer.
send_user "\n=== S5: is the pass directory complete? ===\n"
sh "ls -l /b/tools/lib"
sh "n=0; for f in as ld crt0.o mcrt0.o libc.a ccom cpp c2; do if test -f /b/tools/lib/\$f; then n=`expr \$n + 1`; else echo missing \$f; fi; done; test \$n = 8 && echo S5-PASSDIR\$OK"

# Is OUR yaccpar the file the tape installed?  It matters because yaccpar is
# copied verbatim into every y.tab.c: if the two differ, every parser stage 3
# generates differs from stage 1's and the fixpoint fails for a reason that
# has nothing to do with the compiler.  Cheaper to know now than to diagnose
# from a table of DIFFERs.
sh "if cmp /usr/lib/yaccpar /n/src/usr/src/cmd/yacc/yaccpar; then echo YACCPAR-same\$OK; fi"

# Does anything link against it?  Cheapest proof: build a program the sealed
# way -- our cpp, ccom, c2, as, ld, crt0.o and libc.a, in one cc command --
# and run it.  This is the whole of S5 in a single line: if any of the six is
# missing or wrong, this fails.
send_user "\n=== link something against our libc, sealed ===\n"
sh "cd /tmp"
sh "echo 'main(){printf(\"ourlibc%s\\n\", \"-ok\");}' > u.c"
sh "/b/tools/bin/cc -B/b/tools/lib/ -t02palc -o u u.c" 300
sh "./u"

# ---------------------------------------------------------- build stage 3
# The same sources a third time, with the stage-1 toolchain AND the libc it
# just produced.  Stage 3 is the first set of binaries in which every
# component came from our source, so comparing it against stage 1 says whether
# the system reproduces itself.
send_user "\n=== stage 3: rebuild the toolchain against our libc ===\n"
sh "sh /n/src/mk/build1.sh /n/src /b 3 2>&1" 5400
sh "date"
# Not cmpstage directly: fixpoint.sh runs the strong test (stage 1 vs stage 3)
# and, only if that fails, builds stage 3b and runs the classic bootstrap test
# (stage 3 vs stage 3b).  The strong test is free and the weaker one costs
# forty minutes, so it is worth asking in that order.
sh "sh /n/src/mk/fixpoint.sh /n/src /b 2>&1" 5400

# Did we build a compiler that works?  Cheapest possible proof: use it.
#
# The program prints its marker via %s so that the literal "newcc-ok" never
# appears in the echo of the line that writes t.c.  An earlier version had it
# spelled out, and an unanchored grep duly reported a working compiler that had
# never been built -- it was matching the echo of the echo.
send_user "\n=== does the new toolchain compile anything? ===\n"
sh "cd /tmp"
sh "echo 'main(){printf(\"newcc%s\\n\", \"-ok\");}' > t.c"
sh "cat t.c"
# -B/b/tools/lib/, with the trailing lib/.  cc.c does
#	ccom = strspl(npassname, "ccom")
# -- a bare string concatenation, no directory logic -- so the prefix has to
# spell out the directory the passes are actually in, and ours install into
# $(TOOLDIR)/lib like the system's /lib.  -t02palc picks passes 0 (ccom),
# 2 (c2) and p (cpp) as the tape's cc always could, plus a (as), l (ld) and
# c (crt0.o + libc.a), which are ours: S5.
sh "/b/tools/bin/cc -B/b/tools/lib/ -t02palc -o t t.c" 300
sh "./t"

# And the real question: can the new compiler rebuild something the old one
# built, identically?  Stripped, because cc bakes its PID into the symbol table.
#
# Two comparisons, and the difference between them is the point.  -t02p is our
# three passes over the system's as/ld/libc, which is what we could measure
# before S5; -t02palc is ours all the way down.  If the first matches and the
# second does not, the disagreement is in our as, ld or libc rather than in
# the compiler -- and that is a distinction no single number can make.
send_user "\n=== new compiler vs old, same source ===\n"
sh "/b/tools/bin/cc -B/b/tools/lib/ -t02p -O -o ls.new /n/src/usr/src/cmd/ls.c" 600
sh "/b/tools/bin/cc -B/b/tools/lib/ -t02palc -O -o ls.seal /n/src/usr/src/cmd/ls.c" 600
sh "cc -O -o ls.old /n/src/usr/src/cmd/ls.c" 600
sh "strip ls.new ls.seal ls.old"
sh "ls -l ls.new ls.seal ls.old"
sh "cmp ls.new ls.old; echo cmp-newcc-vs-oldcc=\$?"
sh "cmp ls.seal ls.old; echo cmp-sealed-vs-oldcc=\$?"

# ---------------------------------------------------------- stages 4 to 7
# The spine of a world build: headers, libraries, the one command later
# stages need, and the kernel.  Everything from here compiles with the
# stage-3 toolchain and against OUR headers, so a failure in this block is a
# failure of our source and not of the machine it is running on.
#
# The order is forced and each step checks the one before it, because every
# one of these failures otherwise presents as a pile of "Don't know how to
# make" spread over dozens of components:
#
#	4 headers    -- nothing compiles against ours until they are installed
#	5 libraries  -- needs 3 (a compiler) and 4 (headers)
#	6 config     -- needs libl.a from 5, and both yacc and lex from 1
#	7 kernel     -- needs config from 6
send_user "\n=== stage 4: headers ===\n"
sh "date"
sh "sh /n/src/mk/buildhdrs.sh /n/src /b/root 2>&1" 1800
sh "ls /b/root/usr/include/stdio.h /b/root/usr/include/sys/param.h"

send_user "\n=== stage 5: the libraries ===\n"
sh "date"
sh "sh /n/src/mk/buildlibs.sh /n/src /b /b/root /b/tools3 2>&1" 7200
sh "date"

# Prove the point of stage 4 and 5 together: compile something against OUR
# headers, link it against a library WE built, run it.  curses is the right
# probe because it needs both a header of ours and an archive of ours, and
# because a curses program that starts and stops proves termcap resolved too.
send_user "\n=== does anything link against stage 5? ===\n"
sh "cd /tmp"
sh "echo '#include <curses.h>' > c.c"
sh "echo 'main(){initscr();endwin();printf(\"curses%s\\n\",\"-ok\");}' >> c.c"
sh "/b/tools3/bin/cc -B/b/tools3/lib/ -t02palc -I/b/root/usr/include -o c c.c /b/root/usr/lib/libcurses.a /b/root/usr/lib/libtermcap.a" 600
sh "TERM=dumb ./c"

send_user "\n=== stage 6: the commands ===\n"
sh "date"
# 3 hours, matching drive-stages48.exp. This said 3600 from the days when
# stage 6 built eleven components and was named "config(8)"; it builds 193
# now, each a compile and a link inside the emulator, and a full run would
# have died of a timeout three quarters of the way through with every
# component up to that point built correctly.
sh "sh /n/src/mk/buildcmds.sh /n/src /b /b/root /b/tools3 2>&1" 10800
sh "ls -l /b/root/etc/config"

send_user "\n=== stage 7: the kernel ===\n"
sh "date"
sh "sh /n/src/mk/buildkernel.sh /n/src /b /b/root ipnx /b/tools3 2>&1" 7200
sh "date"
sh "ls -l /b/root/unix"
# size(1) on the result is the cheapest sanity check that it is a kernel and
# not a 40-byte a.out header: a V8 VAX kernel is a few hundred KB of text.
sh "size /b/root/unix"

sh "echo C2-DONE\$OK"
sh "cd /; sync; sync"
# Not sh: halt never returns, so its marker never arrives and the run burns the
# full timeout at the finish line looking like a hang.
sendline "/etc/halt"
must "Infinite loop" 120
simh "quit" 60
expect eof
wait
send_user "\n=== C2/C3 STAGE 1 DONE ===\n"
