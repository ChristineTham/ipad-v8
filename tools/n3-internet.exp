#!/usr/bin/env expect
#
# N3, finished: reach the actual Internet from Research Unix 8th Edition.
#
# A DNS query is the right test. It exercises every layer we built -- V8's
# streams IP over our SIMH NI1010 model, SLiRP's NAT, the host resolver, and a
# real answer from a real nameserver -- and unlike TCP it needs no listener we
# control and no interactive client.
#
# V8 predates every resolver library, so tools/v8/dnsq.c builds the query by
# hand on top of udp_connect(3).

set timeout 300
log_file -a n3-internet.log
proc sendline {x} { send "$x\r" }

proc must {pat {t 0}} {
    global timeout
    set use [expr {$t > 0 ? $t : $timeout}]
    expect -timeout $use "$pat" {
    } timeout {
        send_user "\n*** FAILED: never saw '$pat' after ${use}s ***\n"; exit 3
    } eof {
        send_user "\n*** FAILED: simulator exited waiting for '$pat' ***\n"; exit 4
    }
}
proc sh   {cmd {t 0}} { must "# "   $t; sendline $cmd }
proc simh {cmd {t 0}} { must "sim>" $t; sendline $cmd }

proc catfile {src dst} {
    sh "cat > $dst"
    set f [open $src r]
    while {[gets $f line] >= 0} { sendline $line }
    close $f
    send "\x04"
}

spawn vax780
simh "set noasynch"
simh "set cpu idle=4.1BSD"
simh "set tto 7b"
simh "set rp0 rp07"
simh "at rp0 rp07v8.net"
simh "set il enable"
simh "attach il nat:"
simh "set debug -n n3-internet.dbg"
simh "set il debug=CMD;PKT"
simh "load -o bootV8 0"
simh "run 2"
must "login:" 300
sendline "root"
sh "echo N3E-boot-ok"

send_user "\n=== 1. devices ===\n"
sh "/etc/mknod /dev/il0 c 44 0"
sh "/etc/mknod /dev/il1 c 44 1"
# route(8) talks to the IP layer through /dev/ip0 specifically -- protocol 0,
# used purely as a control channel. Without it "route add" cannot work.
sh "/etc/mknod /dev/ip0  c 42 0"
sh "/etc/mknod /dev/ip6  c 42 6"
sh "/etc/mknod /dev/ip17 c 42 17"
sh "for i in 0 1 2 3; do /etc/mknod /dev/udp0\$i c 50 \$i; done"
sh "for i in 0 1 2 3; do /etc/mknod /dev/tcp0\$i c 43 \$i; done"
sh "chmod 666 /dev/udp0? /dev/tcp0? /dev/ip0 /dev/ip6 /dev/ip17 /dev/il0 /dev/il1"
sh "ls -l /dev/udp00 /dev/ip17"
sh "mkdir /usr/inet/lib"
sh "echo '10.0.2.15\tv8' > /usr/inet/lib/hosts"
sh "echo '10.0.2.2\tgateway' >> /usr/inet/lib/hosts"
sh "echo '10.0.2.3\tnameserver' >> /usr/inet/lib/hosts"
sh "echo '10.0.2.0\tslirp-net' > /usr/inet/lib/networks"
sh "echo N3E-devices"

send_user "\n=== 2. push IP and UDP ===\n"
# ipconfig is not a one-shot: with an arp device it becomes the ARP daemon and
# has to keep running for as long as the interface is up.
sh "cd /usr/src/cmd/inet/etc; ./ipconfig /dev/il0 v8 slirp-net /dev/il1 &"
sh "sleep 3"
sh "cd /usr/src/cmd/inet/etc; ./udpconfig /dev/ip17 &"
sh "sleep 3"
sh "cd /usr/src/cmd/inet/etc; ./route add '*' gateway; echo route-rc=$?"
sh "ps -a" 60
sh "echo N3E-ip-up"

send_user "\n=== 3. ask the Internet a question ===\n"
catfile "../../tools/v8/dnsq.c" "/tmp/dnsq.c"
sh "cd /tmp; cc -o dnsq dnsq.c -lin" 300
sh "ls -l /tmp/dnsq"
sh "/usr/src/cmd/inet/bin/ilstat"
sh "/tmp/dnsq tuhs.org 10.0.2.3" 90
sh "echo N3E-query-done"
sh "/tmp/dnsq www.bell-labs.com 10.0.2.3" 90
sh "/usr/src/cmd/inet/bin/ilstat"
sh "echo N3E-DONE"

sh "cd /; sync; sync; sync"
sh "/etc/halt"
simh "quit" 60
expect eof
wait

send_user "\n=== N3 INTERNET TEST DONE ===\n"
