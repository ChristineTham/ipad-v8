#!/usr/bin/env expect
# K11: a FULL-CAPACITY filesystem, made and used by V10 itself.
#
#	expect tools/v10-bigfs.exp <stage1-image> <src-image> <blank-image>
#
# WHAT THE OLD CEILING WAS, AND WHOSE IT IS.  Every V10 disk so far has been made
# BY V8 -- tools/v10-mkimage.sh runs `v10mkbitfs' on the Eighth Edition host --
# so it has to be readable by V8, and V8's sys/h/filsys.h carries only the R and
# B arms of the superblock union.  The B arm keeps the free-block bitmap INSIDE
# the superblock, `long S_bfree[BITMAP]' with BITMAP 961, so a filesystem cannot
# exceed
#
#	MAXSMALL = BITMAP * BITCELL = 961 * 32 = 30752 blocks
#
# and the stage images are exactly 30,752 blocks -- 120.1 MB, the ceiling itself.
#
# V10 HAS THE THIRD ARM, AND ITS OWN mkbitfs USES IT.  lsys/sys/filsys.h's union
# has an N member -- `char S_flag; long S_bsize; struct buf *S_blk[BITMAP-1]',
# with S_flag documented as "1 means bitmap not in S_bfree" -- and cmd/mkbitfs.c
# switches to it on its own:
#
#	if (size - isize <= MAXSMALL)
#		smallfree();
#	else
#		largefree(fd);
#
# largefree() writes the bitmap into the LAST nblks blocks of the filesystem,
# nblks = (s_fsize + BITSPERBLK-1)/BITSPERBLK with BITSPERBLK = 4096*8 = 32768,
# and refuses only when nblks reaches BITMAP-1.  So the new ceiling is
#
#	960 * 32768 = 31,457,280 blocks of 4096 = 128 GB
#
# -- a thousandfold, and four hundred times the largest disk this project
# emulates.  The cap was never V10's.
#
# THE TAPE'S OWN mkbitfs, NOT OUR OVERLAY, AND THAT IS THE POINT.  v10/src/cmd/
# mkbitfs.c exists because the original refuses to run unless bit 6 is set in the
# target's minor number, and on V8 that bit is part of `hp's drive number -- there
# is no node that both passes the check and reaches a real disk (PATCHES.md).  On
# V10 the check is exactly right: BITFS(dev) is ((dev) & 64), which is how a
# device declares which filesystem variant it holds.  So this harness builds
# mkbitfs.mk, which reads $(SRC), and the overlay is retired for this purpose.
#
# THE WHOLE DRIVE IS PARTITION `h'.  lsys/io/ra.c's ra_sizes[] has eight entries
# and the last is `HUGE, 0' -- 0x7fffffff blocks from offset 0, which the driver
# clamps to the disk.  An RA81 is 891,072 sectors, so 111,384 blocks of 4096:
# 456 MB, and 3.6 times MAXSMALL.  The minor is
#
#	64 | (1<<3) | 7  =  79
#	   BITFS(79) = 79 & 64      -> true, 4096-byte blocks
#	   UNIT(79)  = (79>>3) & 07 -> unit 1, the blank disk
#	   PART(79)  = 79 & 07      -> 7, `h', the whole drive
#
# and the block major is 7, which is where seki's own bdevsw[] puts `rabdev'.
log_user 1
source [file dirname [info script]]/v10drive.exp

set V10_RUN_SECS 7200

if {[llength $argv] < 3} {
    puts "usage: v10-bigfs.exp <stage1-image> <src-image> <blank-image>"
    exit 2
}
set img   [lindex $argv 0]
set src   [lindex $argv 1]
set blank [lindex $argv 2]

set N   /n/v10            ;# the courier disk, mounted
set K   /n/v10/mk         ;# our generated makefiles
set T1  /usr/s1           ;# stage 1's passes
set OBJ /usr/k11obj       ;# scratch
set BIG /big              ;# where the new filesystem is mounted

# 111,384 blocks of 4096 = 456 MB, the whole RA81.  Stated here rather than
# computed on the guest, and asserted against what mkbitfs writes: a filesystem
# sized from a wrong idea of the disk fails on its FIRST write past the end, which
# looks like a driver fault.
set BLOCKS 111384

set results {}
proc note {name ok} { global results; lappend results [list $name $ok assert] }

proc report {} {
    global results
    puts "\n===== V10 K11: A FULL-CAPACITY FILESYSTEM ====="
    set failed 0
    foreach r $results {
        set ok [lindex $r 1]
        puts [format "  %-52s %s" [lindex $r 0] [expr {$ok ? "ok" : "NO"}]]
        if {!$ok} { incr failed }
    }
    puts "===== [expr {[llength $results] - $failed}]/[llength $results] =====\n"
    return $failed
}

v10_boot $img [list "set rq1 ra81" "attach rq1 $src" \
                    "set rq2 ra81" "attach rq2 $blank"]
v10_login root
v10_sh "PATH=/bin:/etc:/usr/bin; export PATH" 120
v10_sh "OK=-ok" 120

# ------------------------------------------------------------ preconditions ---
v10_sh "mkdir /n; mkdir $N" 120
note "courier disk mounts" \
    [v10_try "/etc/mount /dev/ra1c $N && echo MT\$OK" "MT-ok" 600]
note "mkbitfs's makefile is on it" \
    [v10_try "test -s $K/mkbitfs.mk && echo MK\$OK" "MK-ok" 300]
note "icheck's makefile is on it" \
    [v10_try "test -s $K/icheck.mk && echo IC\$OK" "IC-ok" 300]
note "stage 1's ccom is installed" \
    [v10_try "test -s $T1/lib/ccom && echo S1\$OK" "S1-ok" 300]

# ------------------------------------------------- build mkbitfs and icheck ---
#
# THE TAPE'S SOURCE, VIA mkbitfs.mk RATHER THAN v10mkbitfs.mk -- see the header.
# Built with stage 1's passes, which is the compiler V10 rebuilt for itself.
v10_sh "rm -rf $OBJ; mkdir $OBJ" 300
v10_sh "A='SRC=$N/src OURS=$N/ours INCDIR=/usr/include TOOLDIR=$OBJ DESTDIR=$OBJ'" 120
v10_sh "B='CC=cc CCPATH=/bin/cc CPP=$T1/lib/cpp CCOM=$T1/lib/ccom C2=$T1/lib/c2'" 120
v10_sh "C='AS=/bin/as LD=/bin/ld LIBC=/lib/libc.a'" 120
v10_sh "mkdir $OBJ/bin; mkdir $OBJ/etc" 300
foreach t {mkbitfs icheck} {
    v10_sh "rm -rf $OBJ/$t; mkdir $OBJ/$t" 120
    note "$t builds on V10" \
        [v10_try "cd $OBJ/$t; make -f $K/$t.mk \$A \$B \$C > m.log 2>&1 && echo MB\$OK" \
            "MB-ok" 1800]
    if {![v10_try "test -s $OBJ/$t/$t && echo EX\$OK" "EX-ok" 300]} {
        v10_sh "sed -e 20q $OBJ/$t/m.log" 300
    }
    note "$t is an executable" \
        [v10_try "test -s $OBJ/$t/$t && echo EX\$OK" "EX-ok" 300]
}

# ------------------------------------------------------------- the node ---
#
# mknod does NOT replace an existing node -- it prints "File exists" and leaves
# the old one -- and it takes the minor in DECIMAL, which cost a run on the V8
# side when `012' was read as twelve.  Both existing nodes are printed first, as
# the cross-check on the major: this machine's own root and /usr are ra nodes, so
# whatever major they carry is the right one.
v10_sh "ls -l /dev/ra0a /dev/ra0c" 300
v10_sh "rm -f /dev/ra2h" 60
v10_sh "/etc/mknod /dev/ra2h b 7 79" 300
note "the whole-drive BITFS node exists" \
    [v10_try "ls -l /dev/ra2h && echo ND\$OK" "ND-ok" 300]

# --------------------------------------------- the filesystem V8 cannot make ---
#
# 111,384 blocks is 3.6x MAXSMALL, so mkbitfs MUST take its largefree() branch.
# Its own diagnostic is the only thing that would say otherwise ("%ld blocks are
# too many"), and that appears in the transcript rather than being swallowed.
note "mkbitfs writes a $BLOCKS-block filesystem" \
    [v10_try "$OBJ/mkbitfs/mkbitfs /dev/ra2h $BLOCKS && echo MF\$OK" "MF-ok" 3600]
note "icheck reads it back" \
    [v10_try "$OBJ/icheck/icheck /dev/ra2h; echo IK\$OK" "IK-ok" 1800]

# ---------------------------------------------------------- mount and use it ---
#
# THREE THINGS, AND THE THIRD IS THE ONE THAT MATTERS.  Mounting proves the
# kernel accepts the superblock; writing proves bitfsalloc() can find a free bit
# in an out-of-superblock bitmap; and UNMOUNTING AND REMOUNTING proves the
# bitmap was written back to the disk rather than only living in core -- which is
# exactly the distinction a full filesystem hides, since alloc() sleeps instead
# of failing.
v10_sh "rm -rf $BIG; mkdir $BIG" 300
note "V10 mounts it" \
    [v10_try "/etc/mount /dev/ra2h $BIG && echo M1\$OK" "M1-ok" 600]
note "and writes to it" \
    [v10_try "cp /etc/motd $BIG/probe && cat $BIG/probe > /dev/null && echo W1\$OK" \
        "W1-ok" 600]
# A second, larger write: one small file can be satisfied from whatever the
# superblock happens to cache, and the point of the N arm is the blocks beyond it.
note "and a file big enough to need the bitmap's later blocks" \
    [v10_try "cat /lib/libc.a > $BIG/big && test -s $BIG/big && echo W2\$OK" \
        "W2-ok" 1800]
note "umount -a takes it down cleanly" \
    [v10_try "cd /; sync; /etc/umount -a && echo U1\$OK" "U1-ok" 600]
note "it remounts, so the bitmap reached the disk" \
    [v10_try "/etc/mount /dev/ra2h $BIG && echo M2\$OK" "M2-ok" 600]
note "and both files are still there" \
    [v10_try "cat $BIG/probe > /dev/null && test -s $BIG/big && echo R2\$OK" \
        "R2-ok" 600]

set failed [report]
v10_halt
exit [expr {$failed ? 1 : 0}]
