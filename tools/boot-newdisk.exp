#!/usr/bin/env expect
#
# Boot the disk stage 8 built, as drive 0, and see whether it is a system.
#
#	expect tools/boot-newdisk.exp [image]
#
# This is the only test of stage 8 that means anything. Everything stage 8
# reports about itself -- mkfs succeeded, fsck is clean, N files copied -- is
# true of a disk that cannot boot, and was true of several.
#
# It boots the image ALONE: rp0 is the image and nothing else is attached. A
# second disk would let a missing file on the new root be satisfied from
# somewhere else and the test would pass for the wrong reason.
#
# What it looks for, in order, is the sequence a real V8 boot produces:
#
#	the boot block finding hp(0,0)unix         -- the disk is bootable
#	the kernel's autoconfig listing its disks  -- our kernel is running
#	`login:'                                   -- init, /etc/rc, getty
#
# Reaching a shell then proves the binaries stage 6 built actually run on a
# machine that is not the one that built them.
#
# The console discipline lives in v8drive.exp. This file used to carry its own
# copy, whose `must' called exit on timeout -- and expect's exit closes the
# spawn, which KILLS A RUNNING GUEST. It never fired because the script always
# passed, which is precisely why it survived: the bug was only reachable on
# the day something else broke. v8_bail stops the machine first.

set timeout 420
source [file dirname [info script]]/v8drive.exp
# Into work/, which is gitignored, and by absolute path -- `log_file' opens
# relative to the CURRENT directory, and v8_boot has not moved to the media
# directory yet, so a bare name lands wherever the caller happened to be. It
# appends, so at the repo root it became an untracked file that grew on every
# run and belonged to nothing.
log_file -a [file join $V8_MEDIA .. boot-newdisk.log]

set img [expr {[llength $argv] > 0 ? [lindex $argv 0] : "rp07new"}]
send_user "\n=== booting $img alone ===\n"
v8_boot $img
v8_login root

# EVERY MARKER IS SPELLED THROUGH $OK. The tty echoes the command, so a
# literal `echo BN-MUX-ok' would put the answer in the stream before the test
# ran -- the script would pass on its own echo. CLAUDE.md: never a literal.
v8_sh "OK=-ok" 120
v8_sh "stty erase '^H'" 60
v8_shmust "echo BN-SHELL\$OK" "BN-SHELL-ok" 60

# Does the system we built agree with itself about what it is? These are the
# cheapest possible checks and each one is a different subsystem: the kernel
# (its own name), the filesystems it mounted, and a command stage 6 compiled
# doing real work on a machine that did not build it.
v8_sh "cat /etc/whoami"
v8_sh "df"
v8_sh "ls -l /unix"
v8_sh "ls /bin | wc -l"
v8_sh "ls /usr/bin | wc -l"

# /bin/sh is already proven by having a prompt at all. cc is the interesting
# one: if the compiler stage 6 installed runs here, this disk can rebuild
# itself, which is the whole of stage 9.
v8_shmust "if test -x /bin/cc; then echo BN-HAVE-CC\$OK; fi" "BN-HAVE-CC-ok" 60
v8_sh "echo 'main(){printf(\"BN-COMPILED\");}' > /tmp/t.c"
v8_shmust "cd /tmp; if cc -o t t.c; then ./t; echo \$OK; fi" "BN-COMPILED-ok" 300

# The content the build CARRIES rather than makes, checked on the disk that
# will replace the one it was carried from. Each is a different origin:
# mux and muxterm are jerq binaries with no source on the tape; fortune is a
# game, also sourceless; the manual and nroff's macros are `source' rows that
# came off the reference image only because they were proven byte-identical
# to ours; wmux and /.profile are ours and are named individually in
# builddisk.sh, which is exactly the kind of thing that silently does not
# ship. A disk missing all of these still boots to login: perfectly.
v8_shmust "if test -x /usr/jerq/bin/mux -a -x /usr/jerq/lib/muxterm; then echo BN-MUX\$OK; fi" \
          "BN-MUX-ok" 60
v8_shmust "if test -x /usr/jerq/bin/wmux -a -f /usr/jerq/lib/muxterm.w; then echo BN-WMUX\$OK; fi" \
          "BN-WMUX-ok" 60
v8_shmust "if test -x /usr/games/fortune -a -x /usr/games/bcd; then echo BN-GAMES\$OK; fi" \
          "BN-GAMES-ok" 60
v8_shmust "if test -f /usr/man/man1/ls.1 -a -f /usr/lib/tmac/tmac.an; then echo BN-MAN\$OK; fi" \
          "BN-MAN-ok" 60
v8_shmust "if test -x /usr/bin/yacc -a -x /usr/bin/strip; then echo BN-YACC\$OK; fi" \
          "BN-YACC-ok" 60
# The network config the app depends on, on the disk rather than in the repo:
# /usr/inet/lib/services is where cmd/inet/h/config.h looks, and its absence
# made every service lookup fail while the network itself was perfectly fine.
v8_shmust "if test -f /usr/inet/lib/services -a -f /etc/copyright; then echo BN-INET\$OK; fi" \
          "BN-INET-ok" 60
# TERM comes from /.profile, which V8 itself ships none of -- so this is
# both "the file is there" and "login actually read it".
v8_sh "echo term=\$TERM"

v8_shmust "echo BN-DONE\$OK" "BN-DONE-ok" 60
v8_halt
send_user "\n=== BOOT-NEWDISK DONE ===\n"
