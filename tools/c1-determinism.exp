#!/usr/bin/env expect
#
# Does V8's cc reproduce the binaries V8 shipped?
#
# This decides how C4 can be written. If `cc -O -o ls ls.c` reproduces /bin/ls
# byte for byte, then "the from-source build equals the golden image" is a
# checksum table -- a claim a script can settle. If it does not, the proof has
# to fall back on the set of installed programs plus functional smoke tests,
# which is much weaker, so it is worth one boot to find out which world we are
# in before writing anything on top of the assumption.
#
# Everything here runs against the tape's own /usr/src on the image, so it needs
# no share and no staging; it is purely a question about the compiler.

set timeout 300
log_file -a c1-determinism.log
proc sendline {x} { send "$x\r" }

proc must {pat {t 0}} {
    global timeout
    set use [expr {$t > 0 ? $t : $timeout}]
    expect -timeout $use "$pat" {
    } timeout {
        send_user "\n*** FAILED: never saw '$pat' after ${use}s ***\n"; exit 3
    } eof {
        send_user "\n*** FAILED: simulator exited waiting for '$pat' ***\n"; exit 4
    }
}
proc sh   {cmd {t 0}} { must "# "   $t; sendline $cmd }
proc simh {cmd {t 0}} { must "sim>" $t; sendline $cmd }

spawn vax780
simh "set noasynch"
simh "set cpu idle=4.1BSD"
simh "set tto 7b"
simh "set rp0 rp07"
simh "at rp0 rp07v8.net"
simh "load -o bootV8 0"
simh "run 2"
must "login:" 300
sendline "root"
sh "echo DET-boot-ok" 120

# ---------------------------------------------------------------- baseline
# Which cc is this, and does the tree it came from still match what shipped?
send_user "\n=== toolchain ===\n"
sh "ls -l /bin/cc /lib/ccom /lib/c2 /bin/as /bin/ld"
sh "mkdir /tmp/det"
sh "cd /tmp/det"

# ------------------------------------------------------- one small command
# ls.c is a single-file command with no makefile: usr/src/cmd/ls.c is built by
# the implicit rule, which is exactly the ~120-file case the world driver has
# to handle, so it is the honest representative rather than the easy one.
send_user "\n=== rebuild ls ===\n"
sh "date"
sh "cc -O -o ls.new /usr/src/cmd/ls.c" 300
sh "date"
sh "ls -l ls.new /bin/ls"
sh "sum ls.new; sum /bin/ls"
sh "cmp ls.new /bin/ls; echo cmp-ls=\$?"

# strip, in case the difference is only the symbol table
sh "cp ls.new ls.str; strip ls.str"
sh "ls -l ls.str"
sh "cmp ls.str /bin/ls; echo cmp-ls-stripped=\$?"

# ------------------------------------------- is the compiler self-consistent
# A second compile of the same source must at least equal the first, or nothing
# downstream can be reproducible at all.
send_user "\n=== same input twice ===\n"
sh "cc -O -o ls.two /usr/src/cmd/ls.c" 300
sh "cmp ls.new ls.two; echo cmp-self=\$?"

# --------------------------------------------------- where do they diverge
# If ls.new != /bin/ls, the shape of the difference says why: a different size
# means different code (different compiler or flags); the same size with a few
# differing bytes means a path or timestamp baked into the image.
send_user "\n=== shape of the difference ===\n"
sh "cmp -l ls.str /bin/ls | wc -l"
sh "cmp -l ls.str /bin/ls | head -20"
sh "od -c /bin/ls | head -3"
sh "od -c ls.str | head -3"

# ------------------------------------------------------ a makefile command
# The other 112 command directories build through their own makefile. Check one
# works untouched, and time it, because the world build's cost is ~112 of these.
send_user "\n=== a makefile-driven command ===\n"
sh "cd /usr/src/cmd/sed 2>/dev/null || cd /usr/src/cmd/grep 2>/dev/null || cd /usr/src/cmd/od"
sh "pwd; ls"
sh "date"
sh "make 2>&1 | tail -20" 900
sh "date"
sh "ls -l"

sh "cd /; sync"
sh "echo DET-DONE"
sh "/etc/halt" 60
simh "quit" 60
expect eof
wait
send_user "\n=== DETERMINISM PROBE DONE ===\n"
