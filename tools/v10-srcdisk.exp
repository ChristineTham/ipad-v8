#!/usr/bin/env expect
# Fill the Tenth Edition source disk.  Normally run through v10-srcdisk.sh.
#
#	expect tools/v10-srcdisk.exp <v8-image> <tree> <ours> <mk> <blocks>
#
# Runs on the EIGHTH Edition machine, because V8 is the only machine that can
# reach both the host (netfs) and a V10 filesystem (the ported v10mkbitfs).
# It writes one file and reads no golden: the partition file is attached as
# rp1 and assembled into an image afterwards, on the host.

# NOTE: set after the source below, not here -- v8drive.exp sets `timeout'
# itself, so a value assigned first is quietly overwritten.

log_user 1
source [file dirname [info script]]/v8drive.exp
set timeout 1200

if {[llength $argv] < 5} {
    puts "usage: v10-srcdisk.exp <v8-image> <tree> <ours> <mk> <blocks>"
    exit 2
}
set img    [lindex $argv 0]
set tport  [lindex $argv 1]
set oport  [lindex $argv 2]
set mport  [lindex $argv 3]
set blocks [lindex $argv 4]

set V   /n/v10/src        ;# the pristine tree, over netfs
set M   /mnt              ;# the source filesystem being written
set BIN /usr/v10/bin
set INC /usr/v10/include
set OBJ /usr/v10obj

# What the bootstrap compiles.  Directories first, then the loose files.
#
# `ccom' is the big one at 1.9 MB, and most of that is the 1995 binaries and
# objects sitting in cmd/ccom/vax -- comp, comp.sv, a.out.  They are copied
# rather than filtered out, because a filter is a rule that can be wrong and
# 1.9 MB is not worth the risk of excluding something the build reads.  The
# tape has already shown twice that a build reads files nobody would list:
# :yyfix beside the source, y.debug.sv copied by relative name.
set SRCDIRS {yacc ccom as cpp c2}
#
# ar, cmp, tail and ed are here because the golden HAS NONE OF THEM, which
# was measured rather than assumed: its 57 prebuilt 1995 binaries plus what
# BOOTPATH builds do not include ar, cmp, tail, ed, grep or wc.  Three of the
# four are load-bearing -- stage 2 builds an archive and cannot without `ar';
# stage 2's errlst.o is compiled to assembly and EDITED by gen/:errfix, which
# is an ed script; and stage 3's whole result is a byte comparison it cannot
# make without `cmp'.
#
# ed.c, the loose one.  There is also a cmd/ed/ed.c with ansi.h and posix.h --
# the POSIX rewrite -- and mkdep.py's source_for() prefers the loose file.
# That is the right one here and not by luck: cmd/ed.c includes <signal.h> and
# <setjmp.h> and has not one prototype in it, so pcc2 can compile it.
set SRCFILES {cc.c ld.c halt.c sleep.c ar.c cmp.c tail.c ed.c}

set results {}
proc note {name ok} { global results; lappend results [list $name $ok] }
proc report {} {
    global results
    puts "\n===== V10 SOURCE DISK RESULTS ====="
    set failed 0
    foreach r $results {
        puts [format "  %-40s %s" [lindex $r 0] [expr {[lindex $r 1] ? "ok" : "NO"}]]
        if {![lindex $r 1]} { incr failed }
    }
    puts "===== [expr {[llength $results] - $failed}]/[llength $results] =====\n"
    return $failed
}

v8_boot $img {"set il enable" "attach il nat:"
              "set rp1 rp07" "attach rp1 v10src.part"}
v8_login root

puts "\n===== V10 SOURCE DISK (B3.0) ====="
v8_sh "PATH=/bin:/etc:/usr/bin; export PATH"
v8_sh "OK=-ok"

v8_sh "mkdir /n/v10 /n/v10ours /n/v10mk" 60
v8_sh "/etc/nmount 10.0.2.2 $tport 86 /n/v10" 120
v8_sh "/etc/nmount 10.0.2.2 $oport 87 /n/v10ours" 120
v8_sh "/etc/nmount 10.0.2.2 $mport 88 /n/v10mk" 120
note "tree mounted" [v8_try "cat $V/cmd/adb/vax/hello.c" "hello, world" 120]

# ------------------------------------------------ the V10 fs tool, ported ---
#
# Rebuilt here rather than assumed present: this harness must work on a fresh
# clone, and /usr/v10 is not part of the V8 golden.
v8_sh "rm -rf /usr/v10 $INC $BIN; mkdir /usr/v10 $INC $BIN" 120
v8_sh "cd /n/v10/include; find . -print | cpio -pd $INC" 900
v8_sh "rm -rf $OBJ; mkdir $OBJ $OBJ/mkbitfs" 120
v8_sh "cd $OBJ/mkbitfs; cp /n/v10ours/cmd/mkbitfs.c ." 300
note "v10mkbitfs builds" \
    [v8_try "cd $OBJ/mkbitfs; if cc -O -I$INC -o $BIN/v10mkbitfs mkbitfs.c > c.log 2>&1; then echo CC\$OK; fi" \
            "CC-ok" 900]

# ---------------------------------------------------------- the filesystem ---
#
# minor 74 = BITFS(64) | unit 1 (<<3) | partition c (2).  dkunit() masks bit 6
# out before the shift, which is what lets one number mean "bitmapped" to V10
# and "unit 1" to V8 at the same time.
#
# mknod does NOT replace an existing node -- it prints `File exists' and
# leaves the old one -- so a stale node would outlive this and the run would
# fail identically with a correct script.
v8_sh "rm -f /dev/rp1c" 60
v8_sh "/etc/mknod /dev/rp1c b 0 74" 120
note "source filesystem made" \
    [v8_try "$BIN/v10mkbitfs /dev/rp1c $blocks && echo MK\$OK" "MK-ok" 1200]
v8_sh "rm -rf $M; mkdir $M" 60
note "source filesystem mounts" \
    [v8_try "/etc/mount /dev/rp1c $M && echo MT\$OK" "MT-ok" 300]

# ------------------------------------------------------------ the contents ---
foreach d {src src/cmd src/lsys ours mk} { v8_sh "mkdir $M/$d" 60 }

# EVERY cpio DESTINATION HAS TO EXIST FIRST.  `-d' makes the directories that
# appear inside the archive; it does NOT make the one you are copying into,
# and the failure is a bare
#
#	cannot write in </mnt/src/cmd/yacc>
#
# on stderr with a zero exit status, so a run that copied nothing looks like a
# run that worked.  V8's mkdir also makes ONE level at a time, which is why
# this is a loop and not a single command.
v8_sh "mkdir $M/src/libc" 60
foreach d $SRCDIRS { v8_sh "mkdir $M/src/cmd/$d" 60 }

foreach d $SRCDIRS {
    note "src: cmd/$d" \
        [v8_try "cd $V/cmd/$d; find . -print | cpio -pd $M/src/cmd/$d && echo CP\$OK" \
                "CP-ok" 1800]
}
# One cpio for the loose files: four round trips instead of four processes.
v8_sh "cd $V/cmd; for f in [join $SRCFILES { }]; do cp \$f $M/src/cmd/\$f; done" 600
note "src: the loose .c files" [v8_try "test -s $M/src/cmd/ld.c && echo LD\$OK" "LD-ok" 120]

# ------------------------------------------------------- THE WORLD (K10.1) ---
#
# Every command unit's own sources -- 2,284 files, 14.4 MB -- from a MANIFEST
# generated by tools/v10-world.py rather than from a find.  Three reasons the
# list is generated on the host and not computed here:
#
#   * It excludes six other architectures.  cmd/adb alone carries 11v, 68v,
#     cray, seq, v7 and v8 subdirectories; the whole cmd/ tree is 6,472 source
#     files and 39 MB against this subset's 2,284 and 14.4.  Copying another
#     machine's code would also make every later count meaningless.
#   * It excludes the tape's stray .o files and linked binaries, which are what
#     take cmd/ from 39 MB of source to 157 MB on disk.
#   * cpio -p reads its path list from stdin, so ONE process copies the whole
#     tree and `-d' creates every directory that appears in it -- no mkdir loop
#     for 146 directories, which is the same argument that retired v8's 400
#     individual cp's.
#
# Placed AFTER the SRCDIRS copies on purpose: those copy their directories
# whole, including data files the manifest has no reason to know about
# (as/instrs, ccom/vax/y.debug.sv), and cpio -p leaves an existing newer file
# alone.  So the toolchain directories keep the complete copy stages 1-3 need
# and this adds everything else.
note "src: the world -- every command unit's sources, by manifest" \
    [v8_try "cd $V/cmd; cpio -pd $M/src/cmd < /n/v10mk/world.cpio && echo CW\$OK" \
            "CW-ok" 7200]
# Content, not exit status, and three units chosen because each would fail for
# a DIFFERENT reason: sh is a plain directory unit, ccom/common is the sibling
# convention the manifest has to get right, and matlab keeps its sources under
# src/ where nothing else does.
note "world: sh (a directory unit)" \
    [v8_try "test -s $M/src/cmd/sh/service.c && echo W1\$OK" "W1-ok" 120]
note "world: matlab/src (the src/ convention)" \
    [v8_try "test -s $M/src/cmd/matlab/src/sgset.c && echo W2\$OK" "W2-ok" 120]
note "world: a loose one that is not stage 1's" \
    [v8_try "test -s $M/src/cmd/sleep.c && echo W3\$OK" "W3-ok" 120]

# THE KERNEL TREE.  6.6 MB of it, which fits easily: these blocks are 4096
# bytes, so the 16384-block disk is 64 MB and MAXSMALL (30752) is 126 MB.
# lsys/ and not sys/ -- settled in docs/v10-restoration.md K5: sys/ carries 126
# .O files from being compiled in place, lsys/ is clean source, and seki (the
# kernel this project boots) exists only in lsys/.
note "src: lsys (the kernel)" \
    [v8_try "cd $V/lsys; find . -print | cpio -pd $M/src/lsys && echo CP\$OK" "CP-ok" 3600]
note "lsys: alice.m present" \
    [v8_try "test -s $M/src/lsys/astro/alice.m && echo AL\$OK" "AL-ok" 120]
note "lsys: mkconf present" \
    [v8_try "test -s $M/src/lsys/lib/mkconf && echo MC\$OK" "MC-ok" 120]

note "src: libc" \
    [v8_try "cd $V/libc; find . -print | cpio -pd $M/src/libc && echo CP\$OK" "CP-ok" 1800]

# ------------------------------------------------------------ K10.2's libraries ---
#
# The other eighteen libraries, by manifest -- tools/v10-libs.py's libs.cpio,
# 460 files and 2.4 MB.  By manifest rather than wholesale because libI77 keeps
# 89 SUPERSEDED sources under old/, old1/, notused/ and d/ against 33 real ones,
# so a `find . -print' here would carry three copies of a library and invite
# something to compile the wrong generation.
#
# THE `.a' FILES GO TOO, and that is not laziness about filtering.  On this tape
# `ar' bundles source as well as objects -- it predates tar being everywhere --
# so `X.c.a' is a SOURCE BUNDLE and `libX.a' is an object library, and both are
# load-bearing here for different reasons.  Four libraries (lib2621, libblit,
# libram, libplot) keep their only copy of the source inside a bundle and libtr
# keeps 24 of its 30 members there, with the headers (hp.h, ram.h, jcom.h,
# jplot.h) bundled alongside; the tape's own recipe is `cd xplot;ar x
# ../tek.c.a'.  Meanwhile nine of them ship the archive Bell Labs built, which
# is the oracle the fidelity comparison needs on the guest and not on the host.
note "src: K10.2's libraries, by manifest" \
    [v8_try "cd $V; cpio -pd $M/src < /n/v10mk/libs.cpio && echo CL\$OK" "CL-ok" 3600]
# Content, not exit status, and four chosen because each would fail differently:
# libipc is a plain ipc/ unit, libF77's 113 members are the bulk, lib4014's
# source is only inside a bundle, and libtr's oracle is what the fidelity test
# reads.
note "libs: libipc (an ipc/ unit)" \
    [v8_try "test -s $M/src/ipc/libipc/ipcopen.c && echo L1\$OK" "L1-ok" 120]
note "libs: libF77 (the bulk)" \
    [v8_try "test -s $M/src/libF77/pow_dd.c && echo L2\$OK" "L2-ok" 120]
# THE NETFS SERVERS, WHICH ARE NOT A LIBRARY AND SO WERE IN NO MANIFEST.
# libs.cpio carries netfs/libnetb -- it is one of K10.2's 26 libraries -- and
# stops there, so `netfs/serv/zarf.c' was absent and K12's first run failed on a
# file that had never been copied.  zarf is the server netfs/README calls "present
# the local file system", and the only one of the six it calls portable; runfs
# mounts it on a pipe through fmount(2), which is netfs with no network at all.
# The whole netfs tree is copied rather than just serv/: libnetb arriving twice
# costs nothing and needing to keep two lists in step costs a run.
note "src: the netfs servers, which K12 mounts through a pipe" \
    [v8_try "cd $V/netfs; find . -print | cpio -pd $M/src/netfs && echo NS\$OK" \
        "NS-ok" 900]
note "src: zarf's source specifically" \
    [v8_try "test -s $M/src/netfs/serv/zarf.c && echo NZ\$OK" "NZ-ok" 120]
note "libs: lib4014's SOURCE BUNDLE (ar bundles source)" \
    [v8_try "test -s $M/src/libplot/lib4014/tek.c.a && echo L3\$OK" "L3-ok" 120]
note "libs: libtr's oracle (ar bundles objects too)" \
    [v8_try "test -s $M/src/libplot/libtr/libtr.a && echo L4\$OK" "L4-ok" 120]

# ------------------------------------------------------------------- lcc ---
#
# THREE PREBUILT BINARIES, FLAT, BECAUSE STAGE 2 CANNOT FINISH WITHOUT THEM.
#
# 24 of libc's 261 members will not compile with pcc2 -- measured, not
# guessed: `int fprintf(FILE *f, const char *fmt, ...)', `extern void
# *memcpy(void*, void*, size_t)', `#include <stdarg.h>'.  Nine of the ten the
# tape's mkfile hands to `lcc' are in that set, so the tape's own answer is
# lcc, and lcc is on the tape as Bell Labs' own 1995 VAX executables -- the
# same provenance stage 1 already accepts for ccom and as.
#
# Copied as three files rather than as cmd/lcc, which is a large source tree
# we have no use for.  The names are the ones the prebuilt driver EXECS, and
# they are not negotiable -- cmd/lcc/etc/lcc is compiled from bowell.c and its
# strings are /usr/lib/gcc-cpp, /usr/lib/rcc, /bin/as, /bin/ld, /lib/crt0.o.
#
#	etc/lcc            -> /usr/bin/lcc      the driver
#	gen2/vax-v9/rcc    -> /usr/lib/rcc      the VAX back end (vax/sel.c)
#	ph/cpp             -> /usr/lib/gcc-cpp  lcc's own cpp, standing in
#
# There is NO gcc-cpp anywhere in the tree -- only cmd/gcc/gcc.c, source -- so
# the substitution is forced.  ph/cpp takes -I and -D (`Too many -I
# directives', `Illegal -D or -U argument'), which is what the driver passes.
#
# The ANSI headers need no copying: r70's include/lcc is already installed at
# /usr/include/lcc on the golden, and it is exactly what the mkfile's
# LCCARGS names (-I/usr/include/lcc -I/usr/include/libc).
v8_sh "mkdir $M/lcc" 60
v8_sh "cp $V/cmd/lcc/etc/lcc $M/lcc/lcc" 300
v8_sh "cp $V/cmd/lcc/gen2/vax-v9/rcc $M/lcc/rcc" 300
v8_sh "cp $V/cmd/lcc/ph/cpp $M/lcc/cpp" 300
foreach f {lcc rcc cpp} {
    note "lcc: $f" [v8_try "test -s $M/lcc/$f && echo LC\$OK" "LC-ok" 120]
}

# ------------------------------------------------------- the 5620 headers ---
#
# THE ONE libc MEMBER THAT NEEDS A FILE FROM A DIFFERENT TARBALL.  libc's
# `gen/jterm.c' opens
#
#	#include "/usr/jerq/include/jioctl.h"
#
# an ABSOLUTE path into the 5620's include tree, which the v10src tarball does
# not contain -- it is in v10blit, at blit/include/.  So jterm.o failed for two
# runs and was written down as an lcc member on the strength of that failure,
# which was wrong twice over: the file is pure K&R with no ANSI construct in
# it, and lcc could no more find a missing header than cc could.  A missing
# FILE, like <shares.h>, and not a language problem.
#
# The whole directory goes, not just jioctl.h: it is 22 small headers, the
# jerq userland will want them, and picking one file would have to be revisited
# the first time anything else in libc or cmd reaches for blit.h or layer.h.
v8_sh "mkdir $M/jerq" 60
note "jerq: the 5620 include tree" \
    [v8_try "cd /n/v10/blit/include; find . -print | cpio -pd $M/jerq && echo JQ\$OK" \
            "JQ-ok" 600]
note "jerq: jioctl.h, which jterm.c names by absolute path" \
    [v8_try "test -s $M/jerq/jioctl.h && echo JI\$OK" "JI-ok" 120]

# Our overlay and our makefiles.  Both are small and both are what makes the
# build ours rather than a re-run of 1995.
# THE WHOLE OVERLAY, not just cmd/.  It used to be `cd /n/v10ours/cmd', which
# was right while every correction was a loose command source -- and stopped
# being right the moment v10/src/lsys/astro/ipnx780.m existed.  cpio -pd makes
# the directories that appear INSIDE the archive, so one copy covers both.
note "ours: the overlay" \
    [v8_try "cd /n/v10ours; find . -print | cpio -pd $M/ours && echo CP\$OK" "CP-ok" 600]
note "ours: our 780 config" \
    [v8_try "test -s $M/ours/lsys/astro/ipnx780.m && echo K7\$OK" "K7-ok" 120]
note "mk: the makefiles" \
    [v8_try "cd /n/v10mk; find . -print | cpio -pd $M/mk && echo CP\$OK" "CP-ok" 600]

# --------------------------------------------------------------- assertions ---
#
# Content, not exit status: a cpio that copied nothing exits 0.
note "yacc source present"  [v8_try "test -s $M/src/cmd/yacc/y1.c && echo Y\$OK" "Y-ok" 120]
note "ccom common present"  [v8_try "test -s $M/src/cmd/ccom/common/cgram.y && echo G\$OK" "G-ok" 120]
note "ccom vax present"     [v8_try "test -s $M/src/cmd/ccom/vax/local.c && echo L\$OK" "L-ok" 120]
note "as instrs present"    [v8_try "test -s $M/src/cmd/as/instrs && echo I\$OK" "I-ok" 120]
note "cpp cpy.y present"    [v8_try "test -s $M/src/cmd/cpp/cpy.y && echo C\$OK" "C-ok" 120]
note "libc crt0.s present"  [v8_try "test -s $M/src/libc/csu/crt0.s && echo S\$OK" "S-ok" 120]
# STAGE 2's THREE INPUTS, each of which arrives by a different route and any
# one of which missing costs a whole run.  The mkfile and the archive come
# with the libc tree; :errfix is the ed script errlst.o is edited with, and a
# filename beginning with a colon is exactly the kind of thing a copy skips.
note "libc mkfile present"  [v8_try "test -s $M/src/libc/mkfile && echo F\$OK" "F-ok" 120]
note "tape libc.a present"  [v8_try "test -s $M/src/libc/libc.a && echo A\$OK" "A-ok" 120]
note "libc :errfix present" [v8_try "test -s $M/src/libc/gen/:errfix && echo E\$OK" "E-ok" 120]
note "our cc.c present"     [v8_try "test -s $M/ours/cmd/cc.c && echo O\$OK" "O-ok" 120]
note "ed.c present"         [v8_try "test -s $M/src/cmd/ed.c && echo D\$OK" "D-ok" 120]
note "tc.order"            [v8_try "test -s $M/mk/tc.order && echo T\$OK" "T-ok" 120]
note "ccom.mk present"      [v8_try "test -s $M/mk/ccom.mk && echo K\$OK" "K-ok" 120]
note "halt.mk present"      [v8_try "test -s $M/mk/halt.mk && echo H\$OK" "H-ok" 120]
note "libc.mk present"      [v8_try "test -s $M/mk/libc.mk && echo B\$OK" "B-ok" 120]
# libc.ord is DATA the guest walks with a for loop -- the 261 member names in
# the tape's own order.  V10 has no wc and no grep, so this file is how a
# stage-2 run answers "which members are missing?" at all.
note "libc.ord present"     [v8_try "test -s $M/mk/libc.ord && echo R\$OK" "R-ok" 120]

v8_sh "ls -l $M $M/src/cmd $M/mk" 600
v8_sh "df" 120

set failed [report]
v8_sh "cd /; sync; sync" 120
v8_sh "/etc/umount /dev/rp1c" 600
v8_sh "/etc/nmount -u 86; /etc/nmount -u 87; /etc/nmount -u 88" 120
v8_halt
exit [expr {$failed ? 1 : 0}]
