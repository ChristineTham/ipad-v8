#!/usr/bin/env expect
#
# How fast is netfs, really?  The number B1 depends on.
#
# B1 ingests 14.87 MB of the V10 tree and the whole tree is 243 MB, so "it
# works" is not the question -- "does it work at a rate that makes Track B
# pleasant or miserable" is. This times a multi-megabyte read out of the host
# and checks the bytes as well as the clock, because a fast wrong answer is
# not an answer.
#
# Read direction only, on purpose: ingest is the guest *reading* from macOS.
# The write direction is proven by tools/drive-netfs-rw.sh.

set timeout 600
log_file -a n8-throughput.log
proc sendline {x} { send "$x\r" }

proc must {pat {t 0}} {
    global timeout
    set use [expr {$t > 0 ? $t : $timeout}]
    expect -timeout $use "$pat" {
    } timeout {
        send_user "\n*** FAILED: never saw '$pat' after ${use}s ***\n"; exit 3
    } eof {
        send_user "\n*** FAILED: simulator exited waiting for '$pat' ***\n"; exit 4
    }
}
proc sh   {cmd {t 0}} { must "# "   $t; sendline $cmd }
proc simh {cmd {t 0}} { must "sim>" $t; sendline $cmd }

proc catfile {src dst} {
    sh "cat > $dst"
    set f [open $src r]
    while {[gets $f line] >= 0} { sendline $line }
    close $f
    send "\x04"
}

set port [lindex $argv 0]
if {$port == ""} { set port 9200 }

spawn vax780
simh "set noasynch"
simh "set cpu idle=4.1BSD"
simh "set tto 7b"
simh "set rp0 rp07"
simh "at rp0 rp07v8.net"
simh "set il enable"
simh "attach il nat:"
simh "load -o bootV8 0"
simh "run 2"
must "login:" 300
sendline "root"
sh "echo TP-boot-ok" 120

send_user "\n=== network up ===\n"
sh "/etc/mknod /dev/il0 c 44 0"
sh "/etc/mknod /dev/il1 c 44 1"
sh "/etc/mknod /dev/ip0  c 42 0"
sh "/etc/mknod /dev/ip6  c 42 6"
sh "for i in 0 1 2 3 4 5 6 7; do /etc/mknod /dev/tcp0\$i c 43 \$i; done"
sh "chmod 666 /dev/tcp0? /dev/ip0 /dev/ip6 /dev/il0 /dev/il1"
sh "mkdir /usr/inet/lib"
sh "echo '10.0.2.15\tv8' > /usr/inet/lib/hosts"
sh "echo '10.0.2.2\tgateway' >> /usr/inet/lib/hosts"
sh "echo '10.0.0.0\tslirp-net' > /usr/inet/lib/networks"
sh "cd /usr/src/cmd/inet/etc; ./ipconfig /dev/il0 v8 slirp-net /dev/il1 &"
sh "sleep 3"
sh "cd /usr/src/cmd/inet/etc; ./tcpconfig /dev/ip6 &"
sh "sleep 3"
sh "cd /usr/src/cmd/inet/etc; ./route add '*' gateway; echo route-rc=$?"
sh "mkdir /n"
sh "mkdir /n/macos"
catfile "../../tools/v8/nmount.c" "/tmp/nmount.c"
sh "cd /tmp; cc -o nmount nmount.c -lin" 300
sh "/tmp/nmount 10.0.2.2 $port 64 /n/macos" 120
sh "echo TP-MOUNTED"

send_user "\n=== timed read ===\n"
# `date` twice around the copy. V8 has no sub-second clock a shell can reach,
# so the file has to be big enough that whole seconds are a usable ruler --
# hence megabytes rather than kilobytes.
sh "ls -l /n/macos/bulk"
sh "date"
sh "echo TP-START"
sh "cp /n/macos/bulk /tmp/bulk" 900
sh "echo TP-STOP"
sh "date"
sh "ls -l /tmp/bulk"
sh "sum /tmp/bulk" 300
sh "echo TP-DONE"

# And once more from cache-cold on the guest side, reading without writing, to
# separate netfs from the local RP07's own write speed.
send_user "\n=== timed read, no local write ===\n"
sh "date"
sh "echo TP2-START"
sh "cat /n/macos/bulk > /dev/null" 900
sh "echo TP2-STOP"
sh "date"
sh "echo TP2-DONE"

sh "cd /"
sh "/tmp/nmount -u 64" 60
sh "sync; sync; sync"
sh "/etc/halt" 60
simh "quit" 60
expect eof
wait

send_user "\n=== THROUGHPUT TEST DONE ===\n"
