+/// Set the emulated CRT's geometry. Must be called before dmd_init(); width
+/// must be a multiple of 32. Returns DMD_SUCCESS, or DMD_FAILURE if the
+/// framebuffer would not fit the 5620's 1 MB of RAM.
+#[no_mangle]
+pub extern "C" fn dmd_set_screen(width: u32, height: u32) -> c_int {
+    let (w, h) = (width as usize, height as usize);
+    if w == 0 || h == 0 || w % 32 != 0 || (w / 8) * h > 0x100000 {
+        return ERROR;
+    }
+    SCREEN_W.store(w, Ordering::Relaxed);
+    SCREEN_H.store(h, Ordering::Relaxed);
+    SUCCESS
+}
+
+/// Report it back, so a host that did not set it still knows what to draw.
+#[no_mangle]
+pub extern "C" fn dmd_get_screen(width: *mut u32, height: *mut u32) -> c_int {
+    unsafe {
+        if width.is_null() || height.is_null() {
+            return ERROR;
+        }
+        *width = SCREEN_W.load(Ordering::Relaxed) as u32;
+        *height = SCREEN_H.load(Ordering::Relaxed) as u32;
+    }
+    SUCCESS
+}
