+/// Is this a geometry the emulated CRT can take?
+///
+/// Width must be a multiple of 32 -- a Bitmap's stride is counted in 32-bit
+/// Words and the ROM's blit routines work a Word at a time -- and the
+/// framebuffer must fit the reserve claimed above the firmware's 1 MB.
+fn screen_ok(w: usize, h: usize) -> bool {
+    w != 0 && h != 0 && w % 32 == 0 && w <= MAX_SCREEN_W && h <= MAX_SCREEN_H
+}
+
+/// Set the emulated CRT's geometry before dmd_init(). Returns DMD_SUCCESS, or
+/// DMD_FAILURE if the geometry is one the terminal cannot take.
+///
+/// Prefer dmd_resize_screen(): booting stock and resizing afterwards runs the
+/// power-on self-test against the pristine ROM.
+#[no_mangle]
+pub extern "C" fn dmd_set_screen(width: u32, height: u32) -> c_int {
+    let (w, h) = (width as usize, height as usize);
+    if !screen_ok(w, h) {
+        return ERROR;
+    }
+    SCREEN_W.store(w, Ordering::Relaxed);
+    SCREEN_H.store(h, Ordering::Relaxed);
+    SUCCESS
+}
+
+/// Resize a terminal that is already running, without resetting it.
+///
+/// Safe to call at any time after dmd_init(): no memory is allocated, the CPU
+/// is not reset, and the DUART, NVRAM and host connection are untouched. The
+/// caller must re-read dmd_video_ram() afterwards -- both the pointer and the
+/// length change -- and should expect the screen to come back cleared.
+#[no_mangle]
+pub extern "C" fn dmd_resize_screen(width: u32, height: u32) -> c_int {
+    let (w, h) = (width as usize, height as usize);
+    if !screen_ok(w, h) {
+        return ERROR;
+    }
+    match DMD.lock() {
+        Ok(mut dmd) => match dmd.set_screen(w, h) {
+            Ok(()) => SUCCESS,
+            Err(_) => ERROR,
+        },
+        Err(_) => ERROR,
+    }
+}
