+    /// Retarget the screen `Bitmap` the ROM carries in its own image.
+    ///
+    /// jerq.h:
+    ///     typedef struct Bitmap {
+    ///         Word *base;        /* start of the data */
+    ///         unsigned width;    /* stride, in 32-bit Words */
+    ///         Rectangle rect;    /* two Points, four shorts */
+    ///         char *_null;
+    ///     } Bitmap;
+    ///
+    /// and V8's src/lib/j/display.c initialises exactly this shape to
+    /// { 0x700000, 25, 0,0, XMAX,YMAX, 0 }. The same 20 bytes sit in the ROM
+    /// -- big-endian, at the offsets below -- which is what makes a different
+    /// screen size reachable at all: the geometry is data, not code.
+    ///
+    /// Everything the ROM draws with goes through a Bitmap*, so rewriting this
+    /// one retargets the firmware's own output. Nothing is touched at the
+    /// default 800x1024, so the stock terminal is bit-for-bit unchanged.
+    fn patch_screen_bitmap(&mut self, at: usize, rom_len: usize) -> Result<(), BusError> {
+        let w = SCREEN_W.load(Ordering::Relaxed);
+        let h = SCREEN_H.load(Ordering::Relaxed);
+        if w == 800 && h == 1024 {
+            return Ok(());
+        }
+        let base = (RAM_BASE + screen_offset()) as u32;
+        let words = (w / 32) as u32;
+        self.bus.load(at, &base.to_be_bytes())?;
+        self.bus.load(at + 4, &words.to_be_bytes())?;
+        self.bus.load(at + 12, &(w as u16).to_be_bytes())?;
+        self.bus.load(at + 14, &(h as u16).to_be_bytes())?;
+        self.repair_rom_checksum(rom_len)
+    }
+
+    /// Re-stamp the ROM's self-test checksum after editing the image.
+    ///
+    /// The firmware's ROM TEST is the first thing it runs, and it halts the
+    /// machine on failure -- so without this, changing a single ROM byte, even
+    /// one that only alters the screen *height*, bricks the terminal.
+    ///
+    /// The algorithm is from AT&T's own published firmware source, which Dave
+    /// Dykstra released under the GPL in March 1994 (5620rom/src/term/
+    /// selftest.c, rom()): add each byte into a 16-bit accumulator and rotate
+    /// it left one bit, over every byte but the last two, then ones-complement.
+    /// The two check bytes live at the very end of the image, low byte first.
+    /// The routine tries the first 32K bank, and on mismatch carries the
+    /// running sum on to larger banks -- "there might be a 2nd bank of rom" --
+    /// which is the path both shipped images actually take: 8;7;3 checksums
+    /// over 0x0000-0xFFFD to 0xb425, stored at 0xFFFE, and 8;7;5 over
+    /// 0x0000-0x1FFFD to 0xb1ef.
+    fn repair_rom_checksum(&mut self, rom_len: usize) -> Result<(), BusError> {
+        let mut c: u16 = 0;
+        for a in 0..(rom_len - 2) {
+            c = c.wrapping_add(u16::from(self.bus.read_byte(a, AccessCode::AddressFetch)?));
+            c = if c & 0x8000 != 0 { (c << 1) | 1 } else { c << 1 };
+        }
+        let ck = !c;
+        self.bus
+            .load(rom_len - 2, &[(ck & 0xff) as u8, (ck >> 8) as u8])
+    }
