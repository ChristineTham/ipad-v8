+/// Screen geometry.
+///
+/// The 5620's CRT was 800x1024, and that number is baked into three separate
+/// places: this framebuffer length, the screen `Bitmap` the ROM hands to every
+/// program it downloads, and XMAX/YMAX in the host-side jerq library that
+/// muxterm and jim are compiled against. This is the first of the three; the
+/// second is patched in Dmd::reset, and the third has to be rebuilt inside the
+/// host Unix.
+///
+/// Width must be a multiple of 32: a Bitmap's stride is counted in 32-bit
+/// Words, and the ROM's blit routines work a Word at a time.
+pub static SCREEN_W: AtomicUsize = AtomicUsize::new(800);
+pub static SCREEN_H: AtomicUsize = AtomicUsize::new(1024);
+
+pub fn screen_bytes() -> usize {
+    (SCREEN_W.load(Ordering::Relaxed) / 8) * SCREEN_H.load(Ordering::Relaxed)
+}
+
+/// Is a non-stock screen configured?
+pub fn screen_is_custom() -> bool {
+    SCREEN_W.load(Ordering::Relaxed) != 800 || SCREEN_H.load(Ordering::Relaxed) != 1024
+}
+
+/// The 5620's RAM, and then some.
+///
+/// AT&T's own RAM map (5620rom/doc/memmap/map3) pins everything above the
+/// screen to a fixed address: screen memory is exactly 0x19000 at 0x700000,
+/// then romterm bss at 0x719000, pcbs and stacks at 0x71C000, and Free_RAM --
+/// which is where layers allocates -- after 0x71D700. A larger screen
+/// therefore cannot *grow*; it would run straight through the firmware's own
+/// bss and stacks. It has to move somewhere the firmware has no plans for.
+///
+/// So a custom screen is placed immediately above the 1 MB the terminal
+/// believes it has. The ROM sizes memory from VALMAXADDR in NVRAM and its
+/// allocator never looks past 0x7FFFFF, so this space is invisible to it --
+/// every documented structure keeps its documented address, and Free_RAM keeps
+/// its full extent. Only the screen Bitmap's base, patched in Dmd::reset,
+/// points into it.
+pub const RAM_BASE: usize = 0x700000;
+pub const RAM_STOCK: usize = 0x100000;
+
+pub fn ram_len() -> usize {
+    if screen_is_custom() {
+        RAM_STOCK + screen_bytes()
+    } else {
+        RAM_STOCK
+    }
+}
+
+/// Where the framebuffer lives, as an offset into that RAM region.
+pub fn screen_offset() -> usize {
+    if screen_is_custom() {
+        RAM_STOCK
+    } else {
+        0
+    }
+}
