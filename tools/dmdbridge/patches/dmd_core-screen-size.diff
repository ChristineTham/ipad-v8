+/// Report it back, so a host that did not set it still knows what to draw.
+#[no_mangle]
+pub extern "C" fn dmd_get_screen(width: *mut u32, height: *mut u32) -> c_int {
+    unsafe {
+        if width.is_null() || height.is_null() {
+            return ERROR;
+        }
+        *width = SCREEN_W.load(Ordering::Relaxed) as u32;
+        *height = SCREEN_H.load(Ordering::Relaxed) as u32;
+    }
+    SUCCESS
+}
