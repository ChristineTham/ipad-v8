@@ -378,7 +378,11 @@ fn delay_rate(csr_bits: u8, acr_bits: u8) -> Duration {
         BAUD_RATES_B[baud_bits]
     };
 
-    Duration::new(0, NS_PER_SEC / (baud_rate / BITS_PER_CHAR))
+    // ipad-v8 spike TURBO patch: run the wire 8x the programmed baud
+    // (9600-equivalent at the 1200-baud NVRAM default) — the speed real
+    // 5620 hardware supported. The 32ld protocol is block-acked and
+    // self-paces safely at this rate.
+    Duration::new(0, (NS_PER_SEC / (baud_rate / BITS_PER_CHAR)) / 8)
 }
 
 impl Duart {
@@ -457,6 +461,14 @@ impl Duart {
         self.ports[PORT_0].rx_deque.push_front(c);
     }
 
+    /// Deliver a BREAK condition on the RS232 (host) line: error flags plus
+    /// the 0x00 data byte a real UART receives. (ipad-v8 spike patch.)
+    pub fn rs232_break(&mut self) {
+        let port = &mut self.ports[PORT_0];
+        port.stat |= STS_RXB | STS_PER;
+        port.rx_char(0);
+    }
+
     /// Queue a single character for processing by the keyboard port
     pub fn keyboard_rx(&mut self, c: u8) {
         self.ports[PORT_1].rx_deque.push_front(c);
@@ -595,6 +607,11 @@ impl Duart {
                     // TODO: We may want to expose a BREAK condition
                     // to the outside world at some point.
                     port.stat |= STS_RXB | STS_PER;
+                    // ipad-v8 spike patch: a real UART receives a BREAK as a
+                    // 0x00 data byte alongside the error flags. The 8;7;3
+                    // ROM's loopback self-test waits for that byte to end its
+                    // walking-bit sequence.
+                    port.rx_char(0);
                     // Set "Delta Break"
                     self.isr |= dbk_ists;
                 }
