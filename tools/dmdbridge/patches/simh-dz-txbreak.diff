+/* ipad-v8 spike patch: transmit a telnet BREAK (IAC BRK) on a line, raw —
+   tmxr_putc_ln would double the IAC. Implements the DZ's TDR break bits
+   (previously "NI"), which Research Unix mux uses in the 32ld handshake. */
+#define DZP_IAC 0xffu
+#define DZP_BRK 0xf3u
+static void dz_send_break (TMLN *lp)
+{
+if (lp->conn == 0)
+    return;
+if (tmxr_tqln (lp) < (TMXR_MAXBUF - 2)) {
+    lp->txb[lp->txbpi] = (char) DZP_IAC;
+    lp->txbpi = lp->txbpi + 1;
+    if (lp->txbpi >= TMXR_MAXBUF)
+        lp->txbpi = 0;
+    lp->txb[lp->txbpi] = (char) DZP_BRK;
+    lp->txbpi = lp->txbpi + 1;
+    if (lp->txbpi >= TMXR_MAXBUF)
+        lp->txbpi = 0;
+    }
+}
+
