#!/usr/bin/env expect
# Does this image's NETWORK actually work?
#
#	expect tools/net-selftest.exp <image> [netfs-port] [tcp-host]
#
# Normally run through tools/net-selftest.sh, which builds and starts the
# netfs server this needs. Run directly only if something is already serving
# the share on <netfs-port>.
#
# The golden brings its own network up from /etc/rc -- ipconfig, tcpconfig,
# udpconfig, route -- and until this script existed nothing ever checked that
# it does. Every other test asserts files are present. A machine can have
# every daemon running, every config file correct, /dev fully populated, and
# still not pass a single packet, and it looks perfectly healthy from inside.
#
# So this asserts TRAFFIC, on all three paths that can fail independently:
#
#   TCP to the HOST   mount a netfs share and read a file out of it. This is
#                     the /n/macos path the app depends on -- but it proves
#                     less than it looks, because 10.0.2.2 is aliased by
#                     SLiRP to the host's loopback and never reaches a wire.
#   TCP to the WORLD  telnet to a real web server and make it answer. The
#                     reply is a 400, and that is the good part: telnet sends
#                     CRLF where a bare CR was typed, so Apache rejects the
#                     request -- which it can only do having RECEIVED it. A
#                     refused connection looks nothing like a server parsing
#                     your request and complaining about it.
#   UDP to the WORLD  dnsq, twice. N3 recorded that the FIRST query triggers
#                     the ARP and the datagram that triggered it is lost, so a
#                     single query proves nothing either way.
#
# The TCP-out target is minnie.tuhs.org by ADDRESS, so this stage cannot fail
# for want of DNS -- name resolution is what the UDP stage is for, and a test
# that folds two independent faults into one answer cannot say which broke.

set timeout 240
log_user 1
source [file dirname [info script]]/v8drive.exp

if {[llength $argv] < 1} {
    puts "usage: net-selftest.exp <image> \[netfs-port\] \[tcp-host\]"
    exit 2
}
set img  [lindex $argv 0]
set port [expr {[llength $argv] > 1 ? [lindex $argv 1] : 9200}]
set tcph [expr {[llength $argv] > 2 ? [lindex $argv 2] : "173.230.156.51"}]

v8_boot $img {"set il enable" "attach il nat:"}
v8_login root

puts "\n===== NETSELFTEST ====="
v8_sh "PATH=/bin:/etc:/usr/bin:/usr/inet/bin:/usr/inet/etc; export PATH"
# EVERY MARKER IS SPELLED THROUGH A SHELL VARIABLE. The tty echoes the
# command, so a literal `echo NS-SERVICES-ok' puts the answer into the stream
# before the test has run and the script passes on its own echo. With $OK the
# echo carries `NS-SERVICES$OK' and only the result carries `NS-SERVICES-ok'.
v8_sh "OK=-ok"

# What /etc/rc should already have done, reported rather than assumed.
v8_sh "ps ax | grep -v grep | grep inet" 120
v8_sh "cat /usr/inet/lib/hosts" 60
# The file whose absence made every service lookup fail while the network
# itself was perfectly healthy. Checked by name because that is the bug.
v8_shmust "test -f /usr/inet/lib/services && echo NS-SERVICES\$OK" "NS-SERVICES-ok" 60

# --- TCP to the host: the share, MOUNTED BY /etc/rc ---
#
# Deliberately not mounted here. /etc/rc already ran `nmount 10.0.2.2 9200 64
# /n/macos', which is the exact path the app depends on, so mounting it again
# by hand would test a command nothing in production runs and would mask a
# broken boot. The mount is backgrounded at boot, so poll rather than assume
# it has landed by the time login finishes.
v8_shmust "n=0; while test \$n -lt 12; do test -f /n/macos/greeting.txt && { echo NS-HOSTTCP\$OK; break; }; sleep 3; n=`expr \$n + 1`; done" \
          "NS-HOSTTCP-ok" 120
v8_sh "cat /n/macos/greeting.txt" 60

# --- TCP to the world: a real stream to a real machine ---
puts "\n--- TCP out to $tcph:80 ---"
send "telnet $tcph 80\r"
v8_must "Escape character" 90
send "HEAD / HTTP/1.0\r"
send "\r"
v8_must "HTTP/1." 90
v8_must "Apache" 30
# The far end hangs up on an HTTP/1.0 request, so telnet exits by itself and
# hands the tty back. Re-sync with a marker before trusting the shell again.
v8_must "Connection closed" 60
v8_sh ":" 60

# --- UDP to the world: name resolution. Twice: the first loses to ARP. ---
#
# The result is asserted through a FILE, not by matching the reply directly.
# `expect "tuhs.org"' would match the echo of the command that asked for
# tuhs.org, so it would pass with the network unplugged. What is checked
# instead is that the answer contains something shaped like an address.
v8_sh "dnsq www.tuhs.org" 90
v8_sh "dnsq www.tuhs.org > /tmp/dns.out 2>&1; cat /tmp/dns.out" 90
v8_shmust "grep '\[0-9\]\\.\[0-9\]' /tmp/dns.out > /dev/null && echo NS-DNS\$OK" \
          "NS-DNS-ok" 60
puts "\n===== END NETSELFTEST ====="

# The share must go before the halt: a netfs mount is guest RAM and the TCP
# connection under it is host state, so a mount that outlives the server can
# be neither used nor cleared -- and umount(8) cannot release it in any case
# (it is a gmount object keyed by device number, so `nmount -u <id>').
v8_sh "cd /; /etc/nmount -u 64" 60
v8_halt
puts "\n=== NET-SELFTEST DONE ==="
