#!/usr/bin/env expect
# K10.1: compile the WORLD on V10, with V10's own compiler, and count.
#
#	expect tools/v10-compile.exp <image> <src-image>
#
# WHAT THIS ANSWERS, AND WHY IT IS ONE QUESTION AND NOT TWO.  K10 is "recompile
# the world" -- 353 command units.  That is a build, a set of libraries, an
# install layout and a link step, and doing all of it at once would mean a
# multi-hour run whose failures could not be told apart.  So this run compiles
# ONLY: `cc -c', no libraries, no linking, no install.  Compiling needs nothing
# but the compiler and the headers, so a failure here is a LANGUAGE or HEADER
# fact about the tape, which is exactly the unknown worth measuring first.
#
# Same method as B2.0, which built the seventeen boot-path commands before any
# makefile existed and found the two real defects (fsck's <stat.h>, mv's
# ROOTINO) in one run.  Scaled up from 17 to 353.
#
# THE HOST ALREADY PREDICTED THIS RUN, which is the point of comparing them.
# tools/v10-world.py resolves every #include against the header set this machine
# has and says 332 of 353 units should get that far.  A survey that predicts and
# a machine that measures are two independent instruments, and the interesting
# output of this run is where they DISAGREE -- a unit the host called ready that
# the compiler rejects is a language problem the host cannot see, and a unit the
# host called blocked that compiles means the host's model of the include path
# is wrong.  Neither is visible from one instrument alone.
#
# NOT the 780.  This is stages 2 and 3's machine and configuration exactly --
# the 750, stage 1's passes at /usr/s1 -- because the question is about the
# compiler and the headers, not about the hardware, and reusing the proven
# harness means a failure here cannot be a new machine's fault.  K9 already
# established the 780 boots the kernel we built.
log_user 1
source [file dirname [info script]]/v10drive.exp

# Long: 353 units, roughly 1,700 compiles.  Stage 2's 261 compiles plus an
# archive, 261 comparisons and four whole-library trials take about 70 s of host
# time, so this should be minutes -- but the ceiling is set by what a run needs
# to be TOLD, not by what it should take, and a watchdog that can fire during
# real work is worse than the hang it guards against.
set V10_RUN_SECS 21600

if {[llength $argv] < 2} {
    puts "usage: v10-compile.exp <image> <src-image>"
    exit 2
}
set img [lindex $argv 0]
set src [lindex $argv 1]

set N   /n/v10            ;# the courier disk, mounted
set K   /n/v10/mk         ;# our generated makefiles and lists
set T1  /usr/s1           ;# stage 1's passes -- what stage 3's first
                          ;# generation is built by, so the same compiler
set OBJ /usr/k10obj       ;# scratch on a WRITABLE filesystem

set results {}
proc note {name ok} { global results; lappend results [list $name $ok assert] }

proc report {} {
    global results
    puts "\n===== V10 K10.1: COMPILE THE WORLD ====="
    set failed 0
    foreach r $results {
        set ok [lindex $r 1]
        puts [format "  %-52s %s" [lindex $r 0] [expr {$ok ? "ok" : "NO"}]]
        if {!$ok} { incr failed }
    }
    puts "===== [expr {[llength $results] - $failed}]/[llength $results] =====\n"
    return $failed
}

v10_boot $img [list "set rq1 ra81" "attach rq1 $src"]
v10_login root
v10_sh "PATH=/bin:/etc:/usr/bin; export PATH" 120
v10_sh "OK=-ok" 120

# ------------------------------------------------------------ preconditions ---
#
# EVERY ONE OF THESE COSTS A WHOLE RUN IF IT IS ASSUMED.  /n has to exist
# because V10's mkdir makes one level at a time and `mkdir /n/v10' fails
# silently enough that 26 assertions once failed with nothing naming the cause.
v10_sh "mkdir /n; mkdir $N" 120
note "courier disk mounts" \
    [v10_try "/etc/mount /dev/ra1c $N && echo MT\$OK" "MT-ok" 600]
note "the world is on it" \
    [v10_try "test -s $N/src/cmd/sh/service.c && echo WS\$OK" "WS-ok" 300]
note "the unit list is on it" \
    [v10_try "test -s $K/world.units && echo WU\$OK" "WU-ok" 300]
note "the survey script is on it" \
    [v10_try "test -s $K/worldc.sh && echo WC\$OK" "WC-ok" 300]
note "the generator table is on it" \
    [v10_try "test -s $K/world.gen && echo WG\$OK" "WG-ok" 300]
note "the extra-header table is on it" \
    [v10_try "test -s $K/inc.extra && echo IX\$OK" "IX-ok" 300]
# THE PATH COMES FROM tc.order, NOT FROM A GUESS, and the guess was wrong:
# yacc.mk installs to $(TOOLDIR)/usr/bin/yacc and stage 1 sets TOOLDIR=/usr/s1,
# so it is /usr/s1/usr/bin/yacc and not /usr/s1/bin/yacc.  Written out by hand it
# failed for all fifty generator rows -- `/usr/s1/bin/yacc: not found' -- and
# turned 241 compiled units into 232.  tc.order's third column is the install
# path and stage 1 installs from that same file, so reading it here is the
# tc.order rule applied: a component list that appears twice will disagree.
set YACCP ""
foreach r [v10_rows tc.order 3] {
    if {[lindex $r 0] eq "yacc"} { set YACCP "$T1/[lindex $r 2]" }
}
if {$YACCP eq ""} { v10_bail "tc.order has no yacc row -- run v10/mk/mkdep.py" }
note "yacc is installed at the path tc.order gives" \
    [v10_try "test -s $YACCP && echo YA\$OK" "YA-ok" 300]
# lex is the GOLDEN'S PREBUILT one, and that is faithful rather than a shortcut:
# stage 1 does not build lex (it is not in tc.order), and B1 established that
# V10's own 1995 binaries run on this machine and are the tape's own tools.  Its
# SKELETON is a different matter -- lex answers
#
#	(Error) Lex driver missing, file /usr/lib/lex/ncform
#
# and the golden has no /usr/lib/lex at all.  ncform is on the tape, beside the
# lex source, so this installs the tape's own data file exactly as the headers
# above install the tape's own headers.  Without it every lex row fails and the
# failure reads as a grammar the tape cannot process.
note "lex is present (the golden's prebuilt 1995 binary)" \
    [v10_try "test -s /usr/bin/lex && echo LX\$OK" "LX-ok" 300]
v10_sh "mkdir /usr/lib/lex" 300
v10_sh "cp $N/src/cmd/lex/ncform /usr/lib/lex/ncform" 300
note "lex's driver skeleton is installed" \
    [v10_try "test -s /usr/lib/lex/ncform && echo NC\$OK" "NC-ok" 300]
# Stage 1's passes are what this compiles with, so their absence must be a
# named failure and not a canary that merely looks like a compiler bug.
note "stage 1's ccom is installed" \
    [v10_try "test -s $T1/lib/ccom && echo S1\$OK" "S1-ok" 300]

# ---------------------------------------------------------------- the survey ---
#
# One command, minutes of output, and the script's own `WORLDC-done' as the end
# marker -- v10_run waits for the program's own closing output and re-syncs
# afterwards, which is what a command that takes the tty needs.  v10_sh would
# send the marker along WITH the command and then wait forever for a string the
# script had already consumed.
# ------------------------------------------ the headers stage 2 already chose ---
#
# THE SURVEY AND THIS MACHINE DISAGREED ABOUT /usr/include, AND THE SURVEY WAS
# THE OPTIMISTIC ONE.  v10-world.py has always resolved stdlib.h, float.h and
# stdarg.h -- stage 2 chose which of r70's four copies of each pcc2 can read,
# and recorded the evidence -- but the copies were performed by
# tools/v10-stage2.exp on the .s2 image chain, and this harness runs on a
# .stage1 clone that has none of them.  So K10.1 surveyed one machine and
# compiled on another, and fourteen units failed with
#
#	2500 awk ed eqn grap idiff join map pic sort zero   stdlib.h
#	cb ed sum                                          stddef.h
#
# which went into the write-up as header facts about the tape.  Eleven of them
# name a decision that was already made.  v10/mk/gen/inc.extra is now the one
# place that list lives, generated from the same table the survey resolves
# against, and v10-world.py --check refuses if it disagrees with what stage 2
# copies.  Nothing here decides anything; it applies what is recorded.
v10_inc_extra $K $N/ours

# The 5620 headers, at the absolute paths three units and four libraries name.
# See v10_jerq_inc: this is the same drift inc.extra fixed, one directory over,
# and it is worth three units (dict, dis, mc).
v10_jerq_inc $N
note "the 5620 include tree is installed" \
    [v10_try "test -s /usr/jerq/include/jioctl.h && echo JQ\$OK" "JQ-ok" 300]
foreach h {stdlib float stdarg stddef limits u shares} {
    note "$h.h installed at /usr/include" \
        [v10_try "test -s /usr/include/$h.h && echo H\$OK" "H-ok" 300]
}
note "sys/lnode.h installed (shares.h includes it)" \
    [v10_try "test -s /usr/include/sys/lnode.h && echo LN\$OK" "LN-ok" 300]

v10_run "sh $K/worldc.sh $N $OBJ /bin/cc $T1/lib/ $YACCP /usr/bin/lex" "WORLDC-done" 18000

# THE CANARY IS AN ASSERTION, NOT A COURTESY.  If the flags are wrong every
# unit fails, and 0/353 reads as a devastating finding about the Tenth Edition
# rather than as a mistake in this file.  halt.c is built by stage 1 on this
# very machine, so it must compile here.
# INVERTED FOR A WHOLE PHASE: this was `test -s $OBJ/can.log', and a compile
# that succeeds writes nothing, so it asserted that the canary had FAILED.  It
# is why K10.1 reported 6/7 and exited 1 on a run where 241 units compiled --
# which no wrong set of flags can do.  worldc.sh writes can.mark on the success
# path now, which is the same fix v10-libs.sh needed for the same reason.
note "the canary compiled -- so the flags are right" \
    [v10_try "test -s $OBJ/can.mark && echo CL\$OK" "CL-ok" 300]
note "the survey produced a result file" \
    [v10_try "test -s $OBJ/res.log && echo RS\$OK" "RS-ok" 300]

set failed [report]
v10_halt
exit [expr {$failed ? 1 : 0}]
