#!/usr/bin/env expect
# What does this machine say about itself?
#
#	expect tools/show-fetch.exp [image]
#
# Boots the image, runs the identity commands, prints exactly what they print,
# and halts cleanly. Exists because ipnxfetch was written, built, installed and
# audited without anybody ever being shown its OUTPUT -- which is the only part
# of it a person actually wants.
#
# The console discipline (markers, never prompts) and the clean halt both live
# in v8drive.exp; this file is only the questions.

set timeout 240
log_user 1
source [file dirname [info script]]/v8drive.exp
set img [expr {[llength $argv] > 0 ? [lindex $argv 0] : "rp07new"}]

v8_boot $img
v8_login root

puts "\n===== WHAT THE MACHINE SAYS ABOUT ITSELF ====="
v8_sh "ipnxfetch" 120
v8_sh "uname -a" 60
v8_sh "echo TERM=\$TERM; tty; who am i" 60
puts "\n===== END ====="

v8_halt
puts "\n=== SHOW-FETCH DONE ==="
