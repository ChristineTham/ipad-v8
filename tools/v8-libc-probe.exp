#!/usr/bin/env expect
#
# Does V8's libc already have the ANSI string/memory functions, and does V8
# have any of V10's networking? Read-only; operates on a scratch copy.
#
# Why this matters: the ports/v11 plan asserted "pre-ANSI libc, index not
# strchr" as a porting cost. That is demonstrably wrong for V10 -- its libc
# has strchr, memcpy, strtol, atexit and vfprintf, and the tree carries lcc
# with a vax-v9 back end. V8 is a different machine and has to be asked
# directly rather than assumed to match either end.
#
# Run: tools/run-v8exp.sh v8-libc-probe 420
# Expects work/myv8/rp06v8.probe to exist (cp from rp06v8.golden).

set timeout 300
log_file -a v8-libc-probe.log
proc sendline {x} { send "$x\r" }

proc must {pat {t 0}} {
    global timeout
    set use [expr {$t > 0 ? $t : $timeout}]
    expect -timeout $use "$pat" {
    } timeout {
        send_user "\n*** FAILED: never saw '$pat' after ${use}s ***\n"; exit 3
    } eof {
        send_user "\n*** FAILED: simulator exited waiting for '$pat' ***\n"; exit 4
    }
}
proc sh   {cmd {t 0}} { must "# "   $t; sendline $cmd }
proc simh {cmd {t 0}} { must "sim>" $t; sendline $cmd }

spawn vax780
simh "set noasynch"
simh "set tto 7b"
simh "set rp0 rp06"
simh "at rp0 rp06v8.probe"
simh "load -o bootV8 0"
simh "run 2"

must "login:" 240
sendline "root"

sh "echo PROBE-START" 120

# 1. The ANSI string/memory functions, straight out of the archive's symbol
#    table. nm on the whole library is noisy, so ask about names one by one.
sh "echo ---ANSI---"
sh "for f in strchr strrchr strpbrk strspn strcspn strtok strtol strtod memcpy memmove memcmp memset qsort atexit vfprintf vprintf strstr; do echo \$f: `nm /lib/libc.a 2>/dev/null | grep -c \"T _\$f\$\"`; done"

# 2. The BSD names we know are there, as a control -- if these come back zero
#    the nm pattern is wrong, not the library.
sh "echo ---CONTROL---"
sh "for f in index rindex bcopy bzero strcpy printf; do echo \$f: `nm /lib/libc.a 2>/dev/null | grep -c \"T _\$f\$\"`; done"

# 3. Headers. ANSI headers would show up here; so would any networking.
sh "echo ---INCLUDE---"
sh "ls /usr/include"
sh "echo ---INCLUDE-SYS---"
sh "ls /usr/include/sys | head -40"

# 4. Networking: V10 opens /dev/tcpNN and writes a struct tcpuser. Does V8
#    have the device nodes, the header, or the libraries?
sh "echo ---NETDEV---"
sh "ls -l /dev | grep -i 'tcp\\|udp\\|il\\|ip' 2>&1"
sh "echo ---NETINC---"
sh "ls /usr/include/sys/inet 2>&1"
sh "echo ---NETLIB---"
sh "ls -l /lib/libin.a /usr/lib/libin.a /lib/libipc.a /usr/lib/libipc.a 2>&1"

# 5. Which compiler, and does it take a prototype?
sh "echo ---CC---"
sh "ls -l /bin/cc /lib/ccom /lib/cpp /lib/c2 2>&1"
sh "echo ---PROTOTYPE---"
sh "echo 'int f(int a, char *b){return a;} main(){exit(f(0,0));}' > /tmp/p.c; cc -o /tmp/p /tmp/p.c && echo PROTO-OK || echo PROTO-FAIL"

sh "echo PROBE-DONE"
sh "cd /; sync; sync; sync"
sh "/etc/halt"
expect eof
