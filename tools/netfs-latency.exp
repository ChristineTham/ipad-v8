#!/usr/bin/env expect
# How many netfs FILES a minute, which is the number that decides whether a
# build over /n/src is pleasant.
#
#	expect tools/netfs-latency.exp [image] [port]
#
# n8-throughput.exp measures BANDWIDTH -- one multi-megabyte read -- and that
# is the wrong ruler for this protocol. netfs costs a round trip per path
# COMPONENT (nanami(), sys/neta.c), so its cost is per file and per directory
# level, and a megabyte in one file says nothing about a hundred files of a
# kilobyte each. This opens and reads a fixed set of small files and reports
# the rate.
#
# The guest's clock has one-second resolution, so the run has to be long
# enough for whole seconds to be a usable ruler -- hence a hundred files
# rather than ten.
#
# This is the measurement that found the 26x speedup: the round trip was the
# EMULATOR's, not the protocol's. il_svc() ended in sim_clock_coschedule(),
# which rides the calibrated 10 ms clock, so every reply waited for the next
# tick -- and a path is several exchanges, so the cost compounded with
# directory depth. Keep this pointed at a deep directory for that reason.

set timeout 300
log_user 1
source [file dirname [info script]]/v8drive.exp
# <image> then [port], the same order as every other harness here: two
# scripts that take the same two arguments in opposite orders is a trap that
# costs a whole boot to notice.
set img  [expr {[llength $argv] > 0 ? [lindex $argv 0] : "rp07new"}]
set port [expr {[llength $argv] > 1 ? [lindex $argv 1] : 9375}]

v8_boot $img {"set il enable" "attach il nat:"}
v8_login root

v8_sh "PATH=/bin:/etc:/usr/bin:/usr/inet/bin; export PATH"
v8_sh "test -d /n/src || mkdir /n/src" 60
v8_sh "/etc/nmount 10.0.2.2 $port 70 /n/src" 120

# Markers through a variable, never spelled out: `echo NL-MOUNT-ok' would put
# the answer into the stream as the tty echoed the command, so the check would
# pass without the mount. This one mattered -- it is the guard below.
v8_sh "OK=-ok"

# PROVE THE MOUNT BEFORE TIMING IT. A failed mount makes the loop below
# finish instantly, which reads as a spectacular speedup -- and this script
# exists to report a speedup, so it is exactly the error it would not notice.
v8_shmust "ls /n/src/usr/include/sys > /tmp/ls.out; test -s /tmp/ls.out && echo NL-MOUNT\$OK" \
          "NL-MOUNT-ok" 120
v8_sh "wc -l < /tmp/ls.out" 60

# HOW MANY PASSES. One pass over ~107 headers now finishes inside a single
# second, which is a fine result and a useless measurement: the guest's clock
# has one-second resolution, so a run that fits in one tick reports zero and
# would report zero again if it got four times slower. The burst-window fix
# (IL_BURST, libsimh/patches/pdp11_il.c) is what made one pass too quick to
# time -- so the workload grew rather than the ruler.
set passes 5
puts "\n===== LATENCY ($passes passes over the headers) ====="
v8_sh "date" 60
v8_sh "cd /n/src/usr/include/sys; i=0; while test \$i -lt $passes; do for f in *.h; do cat \$f > /dev/null; done; i=`expr \$i + 1`; done" 900
v8_sh "date" 60
puts "\n===== END LATENCY ====="

# Release the mount by id before stopping: umount(8) cannot do it (a netfs
# mount is a gmount object keyed by device number, so it answers a bare
# `/n/src: I/O error' -- which reads as the connection being at fault and is
# not; it fails identically on a live mount).
v8_sh "cd /; /etc/nmount -u 70" 60
v8_halt
puts "\n=== NETFS-LATENCY DONE ==="
