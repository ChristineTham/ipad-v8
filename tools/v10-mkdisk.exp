#!/usr/bin/env expect
# K14: can V10 build a bootable disk of its own?  The decisive experiment for
# rung 10, in its cheapest form.
#
#	expect tools/v10-mkdisk.exp <k13-image> <blank> <tree-port> <ours-port> <mk-port>
#
# NO COURIER DISK.  Every V10 harness before this one carried source on an RA81
# that took fourteen minutes to build; this one mounts the tape, our overlay AND
# the generated makefiles over TCP with `nafsmnt', on three device numbers, and
# reads its build description off the repository working tree.  That is what K13
# was for, and this is the first phase to spend it.
#
# WHAT IS BEING ASKED.  K11 proved V10 can MAKE a 111,384-block filesystem; this
# asks whether it can put a system in one and boot it.  Cheapest sufficient
# version: copy the running root's /bin, /etc, /lib and /dev plus /unix onto the
# new disk, attach it as rq0, and see whether it reaches a login prompt.  If it
# does, rung 10's mechanism is proven and everything left is choosing WHAT to
# copy -- K10.3's 203 commands, K10.2's 26 libraries, stage 1's toolchain.
#
# THE TARGET GOES ON rq1, AND OUR OWN KERNEL IS WHY.  `ipnx780.m' configures
# `ra 0' and `ra 1' and stops -- its own comment says "ra 2..5 REMOVED, one
# controller and we have two disks" -- so a disk attached as rq2 has no device
# behind it and `mkbitfs' answers `/dev/ra2h: No such device or address'.  K11 got
# away with rq2 because it ran on the SEKI golden under vax750, whose config
# carries more RA units; on the machine this project actually ships there are two.
# Nothing is lost: source arrives over TCP now, so rq1 is free.
#
# SO THE PARTITION IS `a' AND THE MINOR IS COMPUTED, NOT WRITTEN DOWN.
# BITFS|unit|part is `64 | (unit<<3) | part', and K11's lesson was never "use 87":
# it is that the minor must be computed from the unit the disk is ACTUALLY on.
# K11's blank was on rq2 and it first wrote 79, which addresses unit ONE -- so it
# made a perfectly good filesystem on top of the source disk while nineteen
# assertions reported success, and only the host's read of the still-zeroed blank
# said otherwise.  So this harness derives the minor from $UNIT and $PART below and
# writes neither.
#
# AND ROOT IS PARTITION `a', WHICH RETRACTS THE WHOLE-DRIVE FILESYSTEM.  K14 first
# built one 111,384-block filesystem on partition `h' and changed the KERNEL to
# root on it, because `ra_sizes[]' gives `a' only 10,240 blocks and a kernel rooted
# on `a' cannot read a 435 MB superblock:
#
#	unix
#	mem = 6062080
#	panic: iinit mount
#
# That is the clamp in `lsys/io/ra.c' firing exactly as written -- limit is
# `min(radsize - blkoff, nblocks)', and K11 put the free-block bitmap in the LAST
# blocks of a large filesystem, so the mount reads past 10,240 and gets ENOSPC.
# Two things make partition `a' the better answer, and the second is decisive:
#
#   THE SWAP OVERLAPS.  `ipnx780.m' has `swap ra 01 20480' -- partition `b',
#   blocks 10240..30720 -- which is INSIDE a whole-drive filesystem.  That disk
#   boots and then swaps over its own data blocks.
#
#   AND alice ROOTS ON 0100, so a whole-drive root is OUR deviation and not the
#   tape's.  `seki' agrees (v10/src/PATCHES.md).  Building the disk the way V10
#   builds disks needs no patch at all, which is what the authenticity rule asks
#   for -- so the DISK moved and the kernel went back to alice's value.
#
# 10,240 blocks is 40 MB, against the golden's own root of 1,280 blocks (5.0 MB)
# and the 6.4 MB this run copies, so there is eight times the room Bell Labs used.
# It is also inside MAXSMALL (BITMAP*BITCELL = 961*32 = 30,752), so V10's mkbitfs
# chooses smallfree() and the bitmap lives IN the superblock -- flag=0, exactly as
# the golden's root and /usr both read.  K11's N-arm bitmap is not retired by this;
# it is simply not what a 40 MB root uses.
#
# AND THE COPY'S /etc/rc MUST STILL LOSE ITS /usr MOUNT, for a different reason
# than before.  `a' and `c' do not overlap, so nothing would be written through
# anything -- but there is no filesystem on `c' yet, so the mount would fail on
# every boot.  The line goes before the disk is ever booted.
log_user 1

set here [file dirname [info script]]
source $here/v10drive.exp

set V10_SIMH [file normalize [file join $here .. work opensimh BIN vax780]]
set V10_ROM  [file normalize [file join $here .. work v10 src lsys boot star uda]]
set V10_RUN_SECS 7200

if {[llength $argv] < 7} {
    puts "usage: v10-mkdisk.exp <k13-image> <blank> <tport> <oport> <mport> <blocks> <part>"
    exit 2
}
set img   [lindex $argv 0]
set blank [lindex $argv 1]
set tport [lindex $argv 2]
set oport [lindex $argv 3]
set mport [lindex $argv 4]
set BLKS  [lindex $argv 5]
set PART  [lindex $argv 6]

# THE MINOR, COMPUTED.  BITFS|unit|part, and the disk is attached as rq1 because
# `ipnx780.m' configures `ra 0' and `ra 1' and stops -- its own comment says "ra
# 2..5 REMOVED, one controller and we have two disks" -- so a disk on rq2 has no
# device behind it and mkbitfs answers `No such device or address'.
set UNIT  1
set PIDX  [string first $PART "abcdefgh"]
if {$PIDX < 0} { puts "v10-mkdisk: partition '$PART' is not a..h"; exit 2 }
set MINOR [expr {64 | ($UNIT << 3) | $PIDX}]
set NODE  /dev/ra$UNIT$PART
puts "== target $NODE, minor $MINOR, $BLKS blocks =="

set T1    /usr/s1
set OBJ   /usr/k14obj
set MP    /mnt2

set results {}
proc note {name ok} { global results; lappend results [list $name $ok assert] }
proc report {} {
    global results
    puts "\n===== V10 K14: A DISK BUILT BY V10 ====="
    set failed 0
    foreach r $results {
        puts [format "  %-52s %s" [lindex $r 0] [expr {[lindex $r 1] ? "ok" : "NO"}]]
        if {!([lindex $r 1])} { incr failed }
    }
    puts "===== [expr {[llength $results] - $failed}]/[llength $results] =====\n"
    return $failed
}

set IL [list "set il enable" "set il address=2013E800" "set il vector=E8" \
             "attach il nat:"]

# ======================================= BOOT 1: build the disk ==============
v10_boot $img [concat [list "set rq1 ra81" "attach rq1 $blank"] $IL]
note "boot 1: the builder came up" 1
v10_login root
v10_sh "PATH=/bin:/etc:/usr/bin; export PATH" 120
v10_sh "OK=-ok" 120

# The three shares, on three device numbers -- neta.h's `server may be using
# several', and nadomount() gives EBUSY for a repeat.
v10_sh "mkdir /n; mkdir /n/tree; mkdir /n/ours; mkdir /n/mk" 120
set sh1 [v10_try "/etc/nafsmnt 10.0.2.2 $tport /n/tree 0" "mounted on" 900]
set sh2 [v10_try "/etc/nafsmnt 10.0.2.2 $oport /n/ours 1" "mounted on" 900]
set sh3 [v10_try "/etc/nafsmnt 10.0.2.2 $mport /n/mk   2" "mounted on" 900]
note "the tape mounts over TCP (no courier disk in this run)" $sh1
note "our overlay mounts"                                    $sh2
note "and the generated makefiles mount"                     $sh3
set shares [expr {$sh1 && $sh2 && $sh3}]

if {!$shares} {
    note "mkbitfs builds from the share" 0
    note "the whole-drive BITFS node exists" 0
    note "mkbitfs writes a $BLKS-block filesystem" 0
    note "V10 mounts the disk it just made" 0
    note "the system copies onto it" 0
    note "/unix is on the new disk" 0
    note "boot 2: THE DISK V10 BUILT reaches a login prompt" 0
    set failed [report]
    v10_halt
    exit 1
}

v10_sh "rm -rf $OBJ; mkdir $OBJ; mkdir $OBJ/mkbitfs" 300
# `bb/4kb', NOT `bb/1kb': 4k.s opens `.set FSBSIZE, 8*512' and `.set FSSHIFT, 12',
# which is BITFS's 4096-byte block.  Fetched NOW, while the share is live.
v10_sh "cp /n/tree/src/lsys/boot/bb/4kb $OBJ/4kb" 900
v10_sh "A='SRC=/n/tree/src OURS=/n/ours INCDIR=/usr/include TOOLDIR=$OBJ DESTDIR=$OBJ'" 120
v10_sh "B='CC=cc CCPATH=/bin/cc CPP=$T1/lib/cpp CCOM=$T1/lib/ccom C2=$T1/lib/c2'" 120
v10_sh "C='AS=/bin/as LD=/bin/ld LIBC=/lib/libc.a'" 120
note "mkbitfs builds from the share" \
    [v10_try "cd $OBJ/mkbitfs; make -f /n/mk/mkbitfs.mk \$A \$B \$C > m.log 2>&1 && echo MB\$OK" \
        "MB-ok" 1800]

v10_sh "rm -f $NODE" 60
v10_sh "/etc/mknod $NODE b 7 $MINOR" 300
v10_sh "ls -l $NODE" 120
note "the whole-drive BITFS node exists" \
    [v10_try "test -b $NODE && echo ND\$OK" "ND-ok" 300]
note "mkbitfs writes a $BLKS-block filesystem" \
    [v10_try "$OBJ/mkbitfs/mkbitfs $NODE $BLKS && echo MF\$OK" "MF-ok" 1800]

v10_sh "rm -rf $MP; mkdir $MP" 300
set mounted [v10_try "/etc/mount $NODE $MP && echo M1\$OK" "M1-ok" 900]
note "V10 mounts the disk it just made" $mounted

if {$mounted} {
    # find | cpio -pd, the idiom K13.1 installed the tools for.  Directory by
    # directory, because copying `/' would copy the mount point into itself.
    foreach d {bin etc lib dev} { v10_sh "mkdir $MP/$d" 120 }
    foreach d {usr tmp n} { v10_sh "mkdir $MP/$d" 120 }
    # /unix FIRST, and lsys/boot/README is why: "/unix must be in the filesystem
    # beginning at the front of the boot device, and must be no more than singly
    # indirect".  The boot block is 508 bytes and follows at most one level of
    # indirection, so a kernel whose blocks are scattered behind thousands of
    # copied files may be unreachable even though the file is perfectly good.
    # tools/v10-golden.exp records the same ordering for the same reason.
    v10_sh "cp /unix $MP/unix" 1800
    foreach d {bin etc lib dev} {
        v10_sh "cd /$d; find . -print | cpio -pd $MP/$d > /dev/null 2>&1" 3600
    }
    note "the system copies onto it" \
        [v10_try "test -s $MP/bin/sh && test -s $MP/etc/init && echo CP\$OK" "CP-ok" 600]
    note "/unix is on the new disk" \
        [v10_try "test -s $MP/unix && echo UX\$OK" "UX-ok" 300]
    # THE /usr MOUNT HAS TO GO, and no longer because anything overlaps: root is
    # partition `a' and /usr would be `c', which are disjoint.  There is simply no
    # filesystem on `c' of the new disk, so the mount fails on every boot.
    v10_sh "sed -e '/ra0c/d' $MP/etc/rc > $MP/etc/rc.new" 600
    v10_sh "cp $MP/etc/rc.new $MP/etc/rc; rm -f $MP/etc/rc.new" 300
    # `grep X; echo TOKEN' PRINTS THE TOKEN WHATEVER grep FOUND -- the semicolon
    # trap, which cost K11 three assertions that reported "icheck reads it back:
    # ok" directly above "cannot open /dev/ra2h".  The ABSENCE of a line is what
    # has to be asserted here, so the success path is the else branch and it
    # writes the marker itself.
    note "the copy's /etc/rc no longer mounts ra0c over its own root" \
        [v10_try "if grep ra0c $MP/etc/rc > /dev/null; then echo RCBAD; else echo RC\$OK; fi" \
            "RC-ok" 600]
    v10_sh "cd /; sync" 600
    v10_sh "/etc/umount -a" 900
    v10_sh "sync" 300

    # NO BOOT BLOCK HERE.  It is written host-side by tools/v10-mkdisk.sh, exactly
    # as tools/v10-golden.sh:202 does for the disk this project already boots --
    # see that script for why two guest-side attempts did not work.
    v10_sh "/etc/nafsmnt -u /n/tree; /etc/nafsmnt -u /n/ours; /etc/nafsmnt -u /n/mk" 900
    v10_sh "sync" 300
} else {
    note "the system copies onto it" 0
    note "/unix is on the new disk" 0
    note "the copy's /etc/rc no longer mounts ra0c over its own root" 0
}
v10_halt

# ================================ BOOT 2: boot what V10 built ================
#
# ATTACHED AS rq0, because the boot ROM loads /unix from unit 0 and ipnx780.m's
# root is `ra 0'.  Nothing of the builder is attached: if this reaches a login
# prompt, it did so out of a filesystem V10 made and filled.
if {$mounted} {
    # REAP WHATEVER HAPPENS.  v10_boot bails on its own if the machine never
    # reaches a prompt, and on this path that bail left a simulator sitting at
    # `sim>' for THIRTY MINUTES -- long enough for tools/norun.sh to refuse the
    # next run, which is correct and is also the symptom.  "A harness must
    # terminate itself; needing to kill one is the bug" applies here: the boot of
    # an untested disk is the one place a bail is EXPECTED, so it is the one place
    # that must not depend on the bail path being tidy.
    set booted 0
    if {![catch {v10_boot $blank {}}]} {
        set booted 1
        note "boot 2: THE DISK V10 BUILT reaches a login prompt" 1
    v10_login root
    v10_sh "PATH=/bin:/etc:/usr/bin; export PATH" 120
    v10_sh "OK=-ok" 120
        v10_sh "cd /; sync" 300
        v10_halt
    }
    if {!$booted} {
        note "boot 2: THE DISK V10 BUILT reaches a login prompt" 0
        v10_reap
    }
} else {
    note "boot 2: THE DISK V10 BUILT reaches a login prompt" 0
}

set failed [report]
exit [expr {$failed ? 1 : 0}]
