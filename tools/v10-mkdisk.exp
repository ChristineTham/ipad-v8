#!/usr/bin/env expect
# K14: can V10 build a bootable disk of its own?  The decisive experiment for
# rung 10, in its cheapest form.
#
#	expect tools/v10-mkdisk.exp <k13-image> <blank> <tree-port> <ours-port> <mk-port>
#
# NO COURIER DISK.  Every V10 harness before this one carried source on an RA81
# that took fourteen minutes to build; this one mounts the tape, our overlay AND
# the generated makefiles over TCP with `nafsmnt', on three device numbers, and
# reads its build description off the repository working tree.  That is what K13
# was for, and this is the first phase to spend it.
#
# WHAT IS BEING ASKED.  K11 proved V10 can MAKE a 111,384-block filesystem; this
# asks whether it can put a system in one and boot it.  Cheapest sufficient
# version: copy the running root's /bin, /etc, /lib and /dev plus /unix onto the
# new disk, attach it as rq0, and see whether it reaches a login prompt.  If it
# does, rung 10's mechanism is proven and everything left is choosing WHAT to
# copy -- K10.3's 203 commands, K10.2's 26 libraries, stage 1's toolchain.
#
# THE TARGET GOES ON rq1, AND OUR OWN KERNEL IS WHY.  `ipnx780.m' configures
# `ra 0' and `ra 1' and stops -- its own comment says "ra 2..5 REMOVED, one
# controller and we have two disks" -- so a disk attached as rq2 has no device
# behind it and `mkbitfs' answers `/dev/ra2h: No such device or address'.  K11 got
# away with rq2 because it ran on the SEKI golden under vax750, whose config
# carries more RA units; on the machine this project actually ships there are two.
# Nothing is lost: source arrives over TCP now, so rq1 is free.
#
# SO THE PARTITION IS `a' AND THE MINOR IS COMPUTED, NOT WRITTEN DOWN.
# BITFS|unit|part is `64 | (unit<<3) | part', and K11's lesson was never "use 87":
# it is that the minor must be computed from the unit the disk is ACTUALLY on.
# K11's blank was on rq2 and it first wrote 79, which addresses unit ONE -- so it
# made a perfectly good filesystem on top of the source disk while nineteen
# assertions reported success, and only the host's read of the still-zeroed blank
# said otherwise.  So this harness derives the minor from $UNIT and $PART below and
# writes neither.
#
# AND ROOT IS PARTITION `a' WITH /usr ON `c' -- V10's OWN LAYOUT, WHICH NEEDS NO
# KERNEL PATCH.  K14 first built one 111,384-block filesystem on partition `h' and
# changed the KERNEL to root on it.  Two things make that wrong, and the second is
# decisive:
#
#   THE SWAP OVERLAPS.  `ipnx780.m' has `swap ra 01 20480' -- partition `b',
#   sectors 10240..30720 -- which is INSIDE a whole-drive filesystem.  That disk
#   boots and then swaps over its own data blocks, and nothing complains.
#
#   AND alice ROOTS ON 0100, as does seki, so a whole-drive root is OUR deviation
#   and not the tape's.  Building the disk the way V10 builds disks needs no patch,
#   which is what the authenticity rule asks for.
#
# `ra_sizes[]' IS IN 512-BYTE SECTORS, AND READING IT AS BLOCKS COST A RUN.  This
# harness asked mkbitfs for 10,240 *blocks* of a partition that holds 1,280, which
# is eight times too big -- the V8 RP06 trap word for word ("partition `a' is
# 15,884 SECTORS, not blocks"), on a different disk.  Nothing in the guest said so;
# `tools/v10-free.py' caught it host-side and named the number:
#
#	v10-free: s_fsize reads 0, which is not a size partition a can hold (max 1280)
#
# The table, converted once, in the driver:
#
#	part  sectors  offset   4K blocks       MB
#	a      10240        0       1280       5.0   root
#	b      20480    10240       2560      10.0   swap + dump
#	c     249848    30720      31231     122.0   /usr
#	h     891072        0     111384     435.1   the whole drive
#
# The golden's own root filesystem IS 1,280 blocks, so Bell Labs sized it to the
# partition to the block -- and its /usr is 30,752, which is MAXSMALL
# (BITMAP*BITCELL = 961*32) exactly.  Both are copied here rather than invented.
#
# SO THERE ARE TWO FILESYSTEMS, BECAUSE THAT IS V10's OWN LAYOUT.  It is NOT a size
# limit: the size probe below measures the boot path at 2.1 MB against 4.8 MB usable
# on `a'.  An earlier note here said 6.4 MB, which was `s_fsize - s_tfree' and so
# counted the filesystem's own 1,024-block i-list as content.  Root cannot move
# either way, which is the argument that holds: `lsys/boot/README'
# requires /unix to be "in the filesystem beginning at the front of the boot
# device" and `star/uda.s' carries no partition offset, so root is the filesystem
# at sector 0 -- `a' or `h', and `h' is the one that overlaps swap.
#
# Being inside MAXSMALL, both filesystems use `smallfree()' and keep the bitmap IN
# the superblock -- `flag=0', as the golden's root and /usr both read.  K11's N-arm
# bitmap is not retired by this; it is simply not what a 5 MB root uses.
log_user 1

set here [file dirname [info script]]
source $here/v10drive.exp

set V10_SIMH [file normalize [file join $here .. work opensimh BIN vax780]]
set V10_ROM  [file normalize [file join $here .. work v10 src lsys boot star uda]]
set V10_RUN_SECS 7200

if {[llength $argv] < 9} {
    puts "usage: v10-mkdisk.exp <k13-image> <blank> <tport> <oport> <mport>\
 <rootblks> <rootpart> <usrblks> <usrpart>"
    exit 2
}
set img   [lindex $argv 0]
set blank [lindex $argv 1]
set tport [lindex $argv 2]
set oport [lindex $argv 3]
set mport [lindex $argv 4]
set RBLKS [lindex $argv 5]
set RPART [lindex $argv 6]
set UBLKS [lindex $argv 7]
set UPART [lindex $argv 8]

# THE MINOR, COMPUTED.  BITFS|unit|part, and the disk is attached as rq1 because
# `ipnx780.m' configures `ra 0' and `ra 1' and stops -- its own comment says "ra
# 2..5 REMOVED, one controller and we have two disks" -- so a disk on rq2 has no
# device behind it and mkbitfs answers `No such device or address'.
set UNIT  1
proc ra_minor {unit part} {
    set i [string first $part "abcdefgh"]
    if {$i < 0} { puts "v10-mkdisk: partition '$part' is not a..h"; exit 2 }
    return [expr {64 | ($unit << 3) | $i}]
}
set RMINOR [ra_minor $UNIT $RPART]
set UMINOR [ra_minor $UNIT $UPART]
set RNODE  /dev/ra$UNIT$RPART
set UNODE  /dev/ra$UNIT$UPART
puts "== root $RNODE minor $RMINOR, $RBLKS blocks =="
puts "== /usr $UNODE minor $UMINOR, $UBLKS blocks =="

set T1    /usr/s1
set OBJ   /usr/k14obj
set MP    /mnt2

set results {}
proc note {name ok} { global results; lappend results [list $name $ok assert] }
proc report {} {
    global results
    puts "\n===== V10 K14: A DISK BUILT BY V10 ====="
    set failed 0
    foreach r $results {
        puts [format "  %-52s %s" [lindex $r 0] [expr {[lindex $r 1] ? "ok" : "NO"}]]
        if {!([lindex $r 1])} { incr failed }
    }
    puts "===== [expr {[llength $results] - $failed}]/[llength $results] =====\n"
    return $failed
}

set IL [list "set il enable" "set il address=2013E800" "set il vector=E8" \
             "attach il nat:"]

# ======================================= BOOT 1: build the disk ==============
v10_boot $img [concat [list "set rq1 ra81" "attach rq1 $blank"] $IL]
note "boot 1: the builder came up" 1
v10_login root
v10_sh "PATH=/bin:/etc:/usr/bin; export PATH" 120
v10_sh "OK=-ok" 120

# The three shares, on three device numbers -- neta.h's `server may be using
# several', and nadomount() gives EBUSY for a repeat.
v10_sh "mkdir /n; mkdir /n/tree; mkdir /n/ours; mkdir /n/mk" 120
set sh1 [v10_try "/etc/nafsmnt 10.0.2.2 $tport /n/tree 0" "mounted on" 900]
set sh2 [v10_try "/etc/nafsmnt 10.0.2.2 $oport /n/ours 1" "mounted on" 900]
set sh3 [v10_try "/etc/nafsmnt 10.0.2.2 $mport /n/mk   2" "mounted on" 900]
note "the tape mounts over TCP (no courier disk in this run)" $sh1
note "our overlay mounts"                                    $sh2
note "and the generated makefiles mount"                     $sh3
set shares [expr {$sh1 && $sh2 && $sh3}]

if {!$shares} {
    note "mkbitfs builds from the share" 0
    note "both BITFS nodes exist" 0
    note "mkbitfs writes the $RBLKS-block root" 0
    note "mkbitfs writes the $UBLKS-block /usr" 0
    note "V10 mounts the root it just made" 0
    note "and mounts /usr inside it" 0
    note "the system copies onto it" 0
    note "/unix is on the new disk" 0
    note "the copy's /etc/rc still mounts /usr, as the golden's does" 0
    note "boot 2: THE DISK V10 BUILT reaches a login prompt" 0
    set failed [report]
    v10_halt
    exit 1
}

# THE SIZES, MEASURED AND REPORTED BEFORE ANYTHING IS BUILT.  A full V10
# filesystem does NOT fail -- `lsys/fs/alloc.c' prints `file system full' and then
# SLEEPS -- so an overflowing copy hangs the guest and costs the whole run's
# timeout with nothing to show.  These go to the transcript as facts rather than
# assertions, so even a hung run leaves the numbers behind.
#
# AND NEVER `cat' A DIRECTORY OF DEVICE NODES, which is how the first version of
# this probe was written and would have wedged the session rather than merely
# delaying it.  `cat /dev/* | wc -c' expands to every node in /dev, and reading
# `/dev/console' BLOCKS -- consuming the very console this harness types into, so
# every command after it is swallowed by cat and no marker ever returns.  Reading
# `/dev/ra0a' or `/dev/ip6' is no better.  A directory is measured with `ls -l',
# whose fifth column is the size, and /dev is not measured at all: nodes hold no
# blocks, which is exactly why `cat' of one is a question about the DEVICE.
# `awk' IS IN NEITHER bootpath.order NOR prebuilt.txt, so it is assumed absent --
# CLAUDE.md's standing rule for V10.  `cat | wc -c' needs only two tools that are
# certainly there (wc is one of K13.1's six), and it is perfectly safe for /bin,
# /etc and /lib because those hold regular files.  /dev is simply not measured.
foreach d {bin etc lib} {
    v10_sh "echo SZ $d `cat /$d/* 2>/dev/null | wc -c`" 900
}
v10_sh "echo SZ unix `wc -c < /unix`" 300

v10_sh "rm -rf $OBJ; mkdir $OBJ; mkdir $OBJ/mkbitfs" 300
# `bb/4kb', NOT `bb/1kb': 4k.s opens `.set FSBSIZE, 8*512' and `.set FSSHIFT, 12',
# which is BITFS's 4096-byte block.  Fetched NOW, while the share is live.
v10_sh "cp /n/tree/src/lsys/boot/bb/4kb $OBJ/4kb" 900
v10_sh "A='SRC=/n/tree/src OURS=/n/ours INCDIR=/usr/include TOOLDIR=$OBJ DESTDIR=$OBJ'" 120
v10_sh "B='CC=cc CCPATH=/bin/cc CPP=$T1/lib/cpp CCOM=$T1/lib/ccom C2=$T1/lib/c2'" 120
v10_sh "C='AS=/bin/as LD=/bin/ld LIBC=/lib/libc.a'" 120
note "mkbitfs builds from the share" \
    [v10_try "cd $OBJ/mkbitfs; make -f /n/mk/mkbitfs.mk \$A \$B \$C > m.log 2>&1 && echo MB\$OK" \
        "MB-ok" 1800]

v10_sh "rm -f $RNODE $UNODE" 60
v10_sh "/etc/mknod $RNODE b 7 $RMINOR" 300
v10_sh "/etc/mknod $UNODE b 7 $UMINOR" 300
v10_sh "ls -l $RNODE $UNODE" 120
note "both BITFS nodes exist" \
    [v10_try "test -b $RNODE -a -b $UNODE && echo ND\$OK" "ND-ok" 300]
note "mkbitfs writes the $RBLKS-block root" \
    [v10_try "$OBJ/mkbitfs/mkbitfs $RNODE $RBLKS && echo MF\$OK" "MF-ok" 1800]
note "mkbitfs writes the $UBLKS-block /usr" \
    [v10_try "$OBJ/mkbitfs/mkbitfs $UNODE $UBLKS && echo MU\$OK" "MU-ok" 1800]

v10_sh "rm -rf $MP; mkdir $MP" 300
set mounted [v10_try "/etc/mount $RNODE $MP && echo M1\$OK" "M1-ok" 900]
note "V10 mounts the root it just made" $mounted
set umounted 0
if {$mounted} {
    v10_sh "mkdir $MP/usr" 120
    set umounted [v10_try "/etc/mount $UNODE $MP/usr && echo M2\$OK" "M2-ok" 900]
}
note "and mounts /usr inside it" $umounted

if {$mounted} {
    # find | cpio -pd, the idiom K13.1 installed the tools for.  Directory by
    # directory, because copying `/' would copy the mount point into itself.
    # WHAT GOES ON ROOT.  /etc/init, /etc/rc, /etc/getty, /bin/sh and /dev are what
    # reach a login prompt; /lib is the compiler's (libc.a and the three passes) and
    # nothing in a boot opens it, so it goes to /usr/lib here.
    #
    # THAT IS A DEVIATION FROM THE GOLDEN AND IT IS ON THE LIST TO UNDO.  The
    # golden keeps /lib on ROOT, and with the boot path measured at 2.1 MB against
    # 4.8 MB usable it fits there comfortably -- the split was chosen while a
    # miscounted 6.4 MB made root look full (see the header).  It is harmless for a
    # boot and wrong for fidelity; rung 10's disk should carry /lib on root.
    foreach d {bin etc dev} { v10_sh "mkdir $MP/$d" 120 }
    foreach d {tmp n} { v10_sh "mkdir $MP/$d" 120 }
    v10_sh "mkdir $MP/usr/lib" 120
    # /unix FIRST, and lsys/boot/README is why: "/unix must be in the filesystem
    # beginning at the front of the boot device, and must be no more than singly
    # indirect".  The boot block is 508 bytes and follows at most one level of
    # indirection, so a kernel whose blocks are scattered behind thousands of
    # copied files may be unreachable even though the file is perfectly good.
    # tools/v10-golden.exp records the same ordering for the same reason.
    v10_sh "cp /unix $MP/unix" 1800
    foreach d {bin etc dev} {
        v10_sh "cd /$d; find . -print | cpio -pd $MP/$d > /dev/null 2>&1" 3600
    }
    v10_sh "cd /lib; find . -print | cpio -pd $MP/usr/lib > /dev/null 2>&1" 3600
    note "the system copies onto it" \
        [v10_try "test -s $MP/bin/sh && test -s $MP/etc/init && echo CP\$OK" "CP-ok" 600]
    note "/unix is on the new disk" \
        [v10_try "test -s $MP/unix && echo UX\$OK" "UX-ok" 300]
    # AND THE /usr MOUNT IS NOW CORRECT, SO IT STAYS -- this assertion is the
    # inverse of the one it replaces.  Earlier generations of K14 built one
    # whole-drive filesystem, where `ra0c' overlapped root and the line had to be
    # stripped; with the layout V10 itself uses, `/dev/ra0c' on the new disk is a
    # real 122 MB filesystem and /etc/rc mounting it is exactly right.  Nothing was
    # edited: the golden's own rc is carried across unchanged, which is one fewer
    # deviation than the previous three runs had.
    note "the copy's /etc/rc still mounts /usr, as the golden's does" \
        [v10_try "grep ra0c $MP/etc/rc > /dev/null && echo RC\$OK" "RC-ok" 600]
    v10_sh "cd /; sync" 600
    v10_sh "/etc/umount -a" 900
    v10_sh "sync" 300

    # NO BOOT BLOCK HERE.  It is written host-side by tools/v10-mkdisk.sh, exactly
    # as tools/v10-golden.sh:202 does for the disk this project already boots --
    # see that script for why two guest-side attempts did not work.
    v10_sh "/etc/nafsmnt -u /n/tree; /etc/nafsmnt -u /n/ours; /etc/nafsmnt -u /n/mk" 900
    v10_sh "sync" 300
} else {
    note "the system copies onto it" 0
    note "/unix is on the new disk" 0
    note "the copy's /etc/rc no longer mounts ra0c over its own root" 0
}
v10_halt

# ================================ BOOT 2: boot what V10 built ================
#
# ATTACHED AS rq0, because the boot ROM loads /unix from unit 0 and ipnx780.m's
# root is `ra 0'.  Nothing of the builder is attached: if this reaches a login
# prompt, it did so out of a filesystem V10 made and filled.
if {$mounted} {
    # REAP WHATEVER HAPPENS.  v10_boot bails on its own if the machine never
    # reaches a prompt, and on this path that bail left a simulator sitting at
    # `sim>' for THIRTY MINUTES -- long enough for tools/norun.sh to refuse the
    # next run, which is correct and is also the symptom.  "A harness must
    # terminate itself; needing to kill one is the bug" applies here: the boot of
    # an untested disk is the one place a bail is EXPECTED, so it is the one place
    # that must not depend on the bail path being tidy.
    set booted 0
    if {![catch {v10_boot $blank {}}]} {
        set booted 1
        note "boot 2: THE DISK V10 BUILT reaches a login prompt" 1
    v10_login root
    v10_sh "PATH=/bin:/etc:/usr/bin; export PATH" 120
    v10_sh "OK=-ok" 120
        v10_sh "cd /; sync" 300
        v10_halt
    }
    if {!$booted} {
        note "boot 2: THE DISK V10 BUILT reaches a login prompt" 0
        v10_reap
    }
} else {
    note "boot 2: THE DISK V10 BUILT reaches a login prompt" 0
}

set failed [report]
exit [expr {$failed ? 1 : 0}]
