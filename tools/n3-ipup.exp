#!/usr/bin/env expect
#
# N3 stage 3: bring TCP/IP up over the NI1010 and get packets across.
#
# Follows usr/src/cmd/inet/READ_ME, which is the CSRC's own instructions.  V8
# has no ifconfig: ipconfig(8) opens two stream channels on the one controller,
# pushes the IP line discipline onto the first, tells the second to carry ARP,
# and then *is* the ARP daemon for as long as it runs.
#
# SIMH's SLiRP puts the guest on 10.0.2.0/24 with the gateway -- which is also
# the host -- at 10.0.2.2 and a DNS forwarder at 10.0.2.3.  V8 is far too old
# for DHCP, so the address is static.

set timeout 300
log_file -a n3-ipup.log
proc sendline {x} { send "$x\r" }

proc must {pat {t 0}} {
    global timeout
    set use [expr {$t > 0 ? $t : $timeout}]
    expect -timeout $use "$pat" {
    } timeout {
        send_user "\n*** FAILED: never saw '$pat' after ${use}s ***\n"; exit 3
    } eof {
        send_user "\n*** FAILED: simulator exited waiting for '$pat' ***\n"; exit 4
    }
}
proc sh   {cmd {t 0}} { must "# "   $t; sendline $cmd }
proc simh {cmd {t 0}} { must "sim>" $t; sendline $cmd }

spawn vax780
simh "set noasynch"
simh "set tto 7b"
simh "set rp0 rp07"
simh "at rp0 rp07v8.net"
simh "set il enable"
simh "attach il nat:"
simh "set debug -n n3-ipup.dbg"
simh "set il debug=CMD;INT;PKT"
simh "load -o bootV8 0"
simh "run 2"
must "login:" 300
sendline "root"
sh "echo N3C-boot-ok"

send_user "\n=== 1. does the driver know the board's address? ===\n"
# ilattach learns the MAC from the ILC_STAT DMA and from nothing else, so this
# is the check that the DMA landed where the UBA map said it would.
sh "cat > /tmp/enaddr.c"
sendline "#include <sys/types.h>"
sendline "#include <sys/ioctl.h>"
sendline "main(){"
sendline "\tunsigned char a\[6\]; int fd, i;"
sendline "\tif((fd = open(\"/dev/il0\", 2)) < 0){ perror(\"open\"); exit(1); }"
sendline "\tif(ioctl(fd, ENIOADDR, a) < 0){ perror(\"ENIOADDR\"); exit(1); }"
sendline "\tfor(i = 0; i < 6; i++) printf(\"%02x \", a\[i\] & 0xff);"
sendline "\tprintf(\"\\n\");"
sendline "}"
send "\x04"
sh "cd /tmp; cc -o enaddr enaddr.c" 300
sh "/tmp/enaddr"
sh "echo N3C-mac-checked"

send_user "\n=== 2. devices and configuration files ===\n"
sh "/etc/mknod /dev/ip6  c 42 6"
sh "/etc/mknod /dev/ip17 c 42 17"
sh "for i in 0 1 2 3; do /etc/mknod /dev/tcp0\$i c 43 \$i; done"
sh "for i in 0 1 2 3; do /etc/mknod /dev/udp0\$i c 50 \$i; done"
sh "ls -l /dev/ip6 /dev/ip17 /dev/tcp00 /dev/udp00"
sh "mkdir /usr/inet/lib"
sh "echo '10.0.2.15\tv8' > /usr/inet/lib/hosts"
sh "echo '10.0.2.2\tgateway' >> /usr/inet/lib/hosts"
sh "echo '10.0.2.3\tnameserver' >> /usr/inet/lib/hosts"
sh "echo '10.0.2.0\tslirp-net' > /usr/inet/lib/networks"
sh "echo 'telnet\t23/tcp' > /usr/inet/lib/services"
sh "echo 'ftp\t21/tcp' >> /usr/inet/lib/services"
sh "echo 'smtp\t25/tcp' >> /usr/inet/lib/services"
sh "echo 'date\t37/udp' >> /usr/inet/lib/services"
sh "echo 'shell\t514/tcp' >> /usr/inet/lib/services"
sh "cat /usr/inet/lib/hosts /usr/inet/lib/networks /usr/inet/lib/services"
sh "echo N3C-configured"

send_user "\n=== 3. push the line disciplines ===\n"
sh "cd /usr/src/cmd/inet/etc; ./ipconfig /dev/il0 v8 slirp-net /dev/il1 &"
sh "sleep 3"
sh "cd /usr/src/cmd/inet/etc; ./tcpconfig /dev/ip6 &"
sh "cd /usr/src/cmd/inet/etc; ./udpconfig /dev/ip17 &"
sh "sleep 3"
sh "ps ag" 60
sh "echo N3C-daemons-up"

send_user "\n=== 4. default route through the SLiRP gateway ===\n"
sh "cd /usr/src/cmd/inet/etc; ./route add '*' gateway"
sh "echo N3C-routed"

send_user "\n=== 5. counters before ===\n"
sh "/usr/src/cmd/inet/bin/ilstat"

send_user "\n=== 6. make it send something ===\n"
# Any IP send makes the stack ask ipconfig to resolve the next hop, which is
# the ARP that puts a frame on the wire. Whether the connection succeeds is
# beside the point -- frames crossing in both directions is the result.
sh "cd /usr/src/cmd/inet/bin; make telnet" 600
sh "cd /tmp; (/usr/src/cmd/inet/bin/telnet gateway > /tmp/tn.out 2>&1 &) ; sleep 10; echo done"
sh "cat /tmp/tn.out"
sh "echo N3C-traffic-attempted"

send_user "\n=== 7. counters after ===\n"
sh "/usr/src/cmd/inet/bin/ilstat"
sh "/usr/inet/bin/netstat 2>/dev/null; /usr/src/cmd/inet/bin/netstat 2>/dev/null; echo netstat-done" 60
sh "echo N3C-DONE"

sh "cd /; sync; sync; sync"
sh "/etc/halt"
simh "quit" 60
expect eof
wait

send_user "\n=== N3 STAGE 3 DONE ===\n"
